      "applicationId": "docker-desktop-wsl",
      "displayName": "Docker Desktop / WSL2 虚拟磁盘",
      "level": "VendorNativeRecommended",
      "installDetectionNames": ["Docker Desktop"],
      "publisherHints": ["Docker"],
      "relativeAllowedDataPaths": [
        "Docker\\wsl",
        "Docker\\wsl\\disk",
        "Docker\\wsl\\data",
        "Docker\\wsl\\main",
        "DockerDesktop\\vm-data",
        "DockerDesktop\\vms"
