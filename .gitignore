# maestro worktree 根目录
/.worktrees/

# =============================================================================
# Maestro 工作流
# 白名单模式：默认忽略 .workflow 下全部运行期产物，只放行不可再生、对项目有用的
# 配置与知识（规范、知识库、领域词表、路线图、调研、问题台账、共享规范、设计系统）。
# 忽略的典型产物：sessions/（含 runs 与 report）、tmp/、codebase/、kg/（maestro.db、
# code-embedding-index.bin、external-surfaces.json、sync-state.json）、learning/、
# explore/（.moa-cache）、archive/、scratch/、prepare/、ref/、reference_style/、
# wiki/、harvest/harvest-log.jsonl、collab/activity.jsonl、collab/overlays/、
# impeccable/live/、issues/discoveries/、.team/、.team-msg/、.trash/、
# .brainstorm-visualize/、.maestro/、.knowledge-audit/、mutations.jsonl、
# state.json（含 .backup-*）、repository.json、worktree-scope.json、search-cache.json、
# search-daemon.json、spec-analytics.jsonl、wiki-index.json、wiki-index-publisher.lock、
# kg-sync-worker.pid、embedding-index.bin、embedding.zvec/、embedding.zvec.meta.json、
# .knowledge-corpus.namespace、各锁文件
# =============================================================================
/.workflow/*

# 项目配置与知识
!/.workflow/config.json
!/.workflow/project.md
!/.workflow/roadmap.md
!/.workflow/domain/
!/.workflow/domain/**
!/.workflow/knowhow/
!/.workflow/knowhow/**
!/.workflow/specs/
!/.workflow/specs/**
# 检索命中统计是运行日志，不入库
/.workflow/specs/.hit-log.jsonl

# 代码库/环境调研文档（maestro map 明确要求入库）
!/.workflow/research/
!/.workflow/research/**

# 问题台账本身入库；按会话生成的 discoveries/ 仍忽略
!/.workflow/issues/
/.workflow/issues/*
!/.workflow/issues/issues.jsonl
!/.workflow/issues/issue-history.jsonl

# 团队共享规范；个人作用域 collab/specs/{uid}/ 同样入库
!/.workflow/collab/
/.workflow/collab/*
!/.workflow/collab/specs/
!/.workflow/collab/specs/**

# 知识收割报告与待入库条目；harvest-log.jsonl 属于增量状态，仍忽略
!/.workflow/harvest/
/.workflow/harvest/*
!/.workflow/harvest/harvest-report-*.md
!/.workflow/harvest/wiki-pending-*.md

# 设计系统文档；impeccable/live/ 下的实时运行配置仍忽略
!/.workflow/impeccable/
/.workflow/impeccable/*
!/.workflow/impeccable/DESIGN.md
!/.workflow/impeccable/design.json

# =============================================================================
# Impeccable 设计系统
# 共享配置、DESIGN.md 与 .impeccable/design.json 入库；以下为本机/生成产物
# =============================================================================
.impeccable/config.local.json
.impeccable/build/
.impeccable/review/

# =============================================================================
# 设计预览导出产物；保留 .pen 设计源文件
# =============================================================================
/docs/prototype-preview/
