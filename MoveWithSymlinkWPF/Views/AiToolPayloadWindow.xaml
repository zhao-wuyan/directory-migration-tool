<Window x:Class="MoveWithSymlinkWPF.Views.AiToolPayloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 工具返回数据明细（只读脱敏）"
        Width="820"
        Height="620"
        MinWidth="520"
        MinHeight="380"
        Background="#F4F6F9"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        KeyDown="Window_OnKeyDown">

    <Window.Resources>
        <!-- 独立于 App.xaml 全局单行 TextBox 样式的多行只读 JSON 展示框，避免被 Height=40 与 Hidden 滚动条截断 -->
        <Style x:Key="PayloadViewerTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionBrush" Value="#BFDBFE"/>
            <Setter Property="CaretBrush" Value="#0078D4"/>
            <Setter Property="Padding" Value="12,10,6,10"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部步骤标题与状态 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" x:Name="StatusBadge" CornerRadius="10" Padding="9,3" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <StackPanel Margin="0,0,12,0">
                <TextBlock x:Name="HeaderTitleText" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="以下为本次只读工具调用实际返回给 AI 模型的脱敏元数据（不含任何文件内容或凭据）。"
                           FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- 调用参数卡片 -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="调用参数：" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Top" Margin="0,0,6,0"/>
                <TextBlock x:Name="ArgumentsText" Grid.Column="1" FontSize="11.5" Foreground="#0F172A" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- 实际返回给模型的格式化 JSON 视图 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="2,0,2,8">
                    <TextBlock x:Name="PayloadMetaText" DockPanel.Dock="Right" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Text="AI 实际收到的只读返回内容（JSON）" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBox x:Name="PayloadTextBox"
                         Grid.Row="1"
                         Style="{StaticResource PayloadViewerTextBoxStyle}"
                         AutomationProperties.AutomationId="AiToolPayloadTextBox"/>
            </Grid>
        </Border>

        <!-- 底部操作栏 -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CopyFeedbackText" FontSize="11.5" Foreground="#0F7B4B" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyPayloadButton"
                        Content="复制返回数据"
                        Click="CopyPayloadButton_OnClick"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        Height="32" Padding="14,0" FontSize="12" Margin="0,0,8,0"/>
                <Button Content="关闭"
                        Click="CloseButton_OnClick"
                        Style="{StaticResource FluentPrimaryButtonStyle}"
                        Height="32" MinWidth="76" Padding="16,0" FontSize="12"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
