<Window x:Class="MoveWithSymlinkWPF.Views.QuarantineDeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="二次确认 · 永久删除隔离项"
        AutomationProperties.AutomationId="QuarantineDeleteConfirmWindow"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">

    <StackPanel Margin="18,16">
        <TextBlock x:Name="DialogHeaderText" Text="永久删除隔离区批次（不可恢复）" FontSize="17" FontWeight="Bold" Foreground="#C42B1C" Margin="0,0,0,10"/>

        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <TextBlock x:Name="WarningBannerText"
                       Text="此操作将从隔离区永久删除以下冻结批次以释放磁盘物理空间，删除后无法再从隔离区恢复。取消将完整保留隔离文件。"
                       FontSize="12" Foreground="#7F1D1D" TextWrapping="Wrap" LineHeight="18"/>
        </Border>

        <Border x:Name="AiResidualWarningCard" Visibility="Collapsed"
                Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <TextBlock x:Name="AiResidualWarningText" FontSize="11.5" FontWeight="SemiBold" Foreground="#92400E" TextWrapping="Wrap" LineHeight="17"/>
        </Border>

        <!-- 单批详情卡 -->
        <Border x:Name="SingleBatchCard" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="BatchTitleText" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                <TextBlock x:Name="BatchSourceText" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="BatchMetaText" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
            </StackPanel>
        </Border>

        <!-- 批量待删清单卡（勾选多批时展示完整清单与总计） -->
        <Border x:Name="MultiBatchCard" Visibility="Collapsed"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="MultiBatchSummaryText" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="MultiBatchItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,5">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="#C42B1C" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6"
                                                        Padding="5,0.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding AiBadgeVisibility}">
                                                    <TextBlock Text="AI 疑似残留" FontSize="9.5" FontWeight="SemiBold" Foreground="#B45309"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MetaText}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="请准确输入确认短语（不会预填）：" FontSize="12" Foreground="#92400E" VerticalAlignment="Center"/>
                    <Border Background="#FFFFFF" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="6,0,0,0">
                        <TextBlock x:Name="ExpectedPhraseText" Text="永久删除" FontWeight="Bold" Foreground="#B45309" FontSize="12"/>
                    </Border>
                </StackPanel>
                <TextBox x:Name="PhraseInputBox" Height="32" Padding="8,4" VerticalContentAlignment="Center" FontSize="12.5"
                         Background="#FFFFFF" BorderBrush="#D97706" BorderThickness="1"
                         TextChanged="PhraseInputBox_OnTextChanged"
                         AutomationProperties.AutomationId="QuarantineDeletePhraseInput"/>
            </StackPanel>
        </Border>

        <DockPanel>
            <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="取消并保留隔离项（默认）" IsDefault="True" IsCancel="True"
                    Click="CancelButton_OnClick" Style="{StaticResource FluentPrimaryButtonStyle}" Height="34" Padding="16,0"
                    AutomationProperties.AutomationId="QuarantineDeleteCancelButton"/>
            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="确认永久删除" IsDefault="False" IsEnabled="False"
                    Click="DeleteButton_OnClick" Style="{StaticResource FluentDangerButtonStyle}" Height="34" Padding="16,0"
                    AutomationProperties.AutomationId="QuarantineDeleteConfirmButton"/>
            <FrameworkElement/>
        </DockPanel>
    </StackPanel>
</Window>
