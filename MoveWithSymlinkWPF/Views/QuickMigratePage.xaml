<UserControl x:Class="MoveWithSymlinkWPF.Views.QuickMigratePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MoveWithSymlinkWPF.Views"
             xmlns:vm="clr-namespace:MoveWithSymlinkWPF.ViewModels"
             xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:MoveWithSymlinkWPF.Behaviors"
             xmlns:models="clr-namespace:MigrationCore.Models;assembly=MigrationCore"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="960"
             Background="#F6F8FA"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             ToolTipService.InitialShowDelay="250"
             ToolTipService.ShowDuration="15000"
             FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/目录迁移工具;component/Resources/QuickMigrateStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Toolbar -->
        <Border Grid.Row="0"
                Background="White"
                Padding="16,12,16,10"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Title, Status Summary, and Primary Actions -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏩ 一键迁移"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   VerticalAlignment="Center"/>
                        <Border Background="#F3F4F6"
                                CornerRadius="10"
                                Padding="9,2.5"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       Foreground="#4B5563"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="导出示例配置"
                                Command="{Binding ExportExampleConfigCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                Visibility="{Binding HasConfig, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Style="{StaticResource PageSecondaryButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button Content="刷新扫描"
                                Command="{Binding RefreshScanCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource PageSecondaryButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button Content="开始一键迁移"
                                Command="{Binding StartQuickMigrationCommand}"
                                IsEnabled="{Binding HasSelectedTasks}"
                                Visibility="{Binding HasPendingTasks, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource PagePrimaryButtonStyle}"/>
                        <Button Content="取消"
                                Command="{Binding CancelExecutionCommand}"
                                Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource PageSecondaryButtonStyle}"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Unified Target Directory & Optional Content Hash -->
                <Border Grid.Row="1"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,7"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MaxWidth="360"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      Content="统一目标目录"
                                      IsChecked="{Binding UseUnifiedTarget}"
                                      FontSize="12.5"
                                      Foreground="#374151"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>

                            <TextBox Grid.Column="1"
                                     Text="{Binding UnifiedTargetRoot, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="160"
                                     IsEnabled="{Binding UseUnifiedTarget}"
                                     Style="{StaticResource CompactInputBoxStyle}"
                                     VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Content="浏览…"
                                    Command="{Binding BrowseUnifiedTargetCommand}"
                                    IsEnabled="{Binding UseUnifiedTarget}"
                                    Style="{StaticResource PageSecondaryButtonStyle}"
                                    Height="30"
                                    MinWidth="64"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <CheckBox Grid.Column="1"
                                  Content="完整内容哈希（可选）"
                                  IsChecked="{Binding UseContentHash}"
                                  FontSize="12.5"
                                  Foreground="#4B5563"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"
                                  ToolTip="默认执行快速核对（相对路径清单、文件大小与必要元数据）；勾选后会额外计算完整内容 SHA-256 哈希，耗时较长。"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Tab Content Area -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource ModernTabControlStyle}">
            <!-- 未迁移任务 -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     AutomationProperties.Name="未迁移">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="未迁移" VerticalAlignment="Center"/>
                        <Border Background="#F3F4F6"
                                CornerRadius="9"
                                Padding="6,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PendingTaskCount}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#4B5563"/>
                        </Border>
                        <Border Background="#FEF3C7"
                                BorderBrush="#FCD34D"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="6,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding UnverifiedPendingCount, Converter={StaticResource IntToVisibilityConverter}}">
                            <TextBlock Text="{Binding UnverifiedPendingBadgeText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#92400E"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource ModernScrollViewer}">
                    <StackPanel Margin="16,12,16,16">
                        <!-- Batch Selection Sub-bar (only when pending tasks exist) -->
                        <Grid Margin="2,0,2,10"
                              Visibility="{Binding HasPendingTasks, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="全选"
                                          IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                                          FontSize="12.5"
                                          FontWeight="Medium"
                                          Foreground="#374151"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectionSummaryText}"
                                           FontSize="12"
                                           Foreground="#6B7280"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="勾选多项后点击右上角「开始一键迁移」批量执行，或点击单项右侧「迁移」"
                                       FontSize="11.5"
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Empty State: No Valid Config/Tasks -->
                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Padding="40,36"
                                CornerRadius="8"
                                Visibility="{Binding HasValidTasks, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📂"
                                           FontSize="40"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="无可一键迁移目录"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="请检查配置文件或点击右上角「刷新扫描」"
                                           FontSize="13"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Empty State: All Tasks Already Migrated -->
                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Padding="40,36"
                                CornerRadius="8"
                                Visibility="{Binding AllTasksMigrated, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✅"
                                           FontSize="36"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="所有检测到的目录均已完成迁移"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="可切换到「已迁移」标签页查看状态、确认验证或管理原始备份"
                                           FontSize="13"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Pending Task Groups -->
                        <ItemsControl ItemsSource="{Binding PendingTaskGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <!-- Clean Section Header -->
                                        <StackPanel Orientation="Horizontal" Margin="2,2,0,8">
                                            <TextBlock Text="{Binding GroupName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Tasks.Count, StringFormat='· {0} 项'}"
                                                       FontSize="12"
                                                       Foreground="#9CA3AF"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="TaskItemRoot">
                                                        <Border Style="{StaticResource PendingTaskCardStyle}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- Row 0: Checkbox, Title, Optional Badges, and Actions -->
                                                                <Grid Grid.Row="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <CheckBox Grid.Column="0"
                                                                              IsChecked="{Binding IsSelected}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,10,0"/>

                                                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="14"
                                                                                   Foreground="#111827"
                                                                                   VerticalAlignment="Center"/>

                                                                        <!-- 刚还原待验证 / 还原备份保留 徽章（仅还原未收尾时显示） -->
                                                                        <Border Style="{StaticResource VerificationBadgeBorderStyle}"
                                                                                ToolTip="{Binding TransactionStatusText}"
                                                                                Visibility="{Binding ShowPendingVerificationEntry, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding VerificationBadgeText}"
                                                                                       Style="{StaticResource VerificationBadgeTextStyle}"/>
                                                                        </Border>

                                                                        <Border Background="#F3F4F6"
                                                                                BorderBrush="#E5E7EB"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="6,1.5"
                                                                                Margin="6,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip="{Binding BackupStatusText}">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding ShowPendingVerificationEntry}" Value="True"/>
                                                                                                <Condition Binding="{Binding HasBackupShortBadge}" Value="True"/>
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="{Binding BackupShortBadgeText}"
                                                                                       FontSize="11"
                                                                                       Foreground="#4B5563"/>
                                                                        </Border>

                                                                        <!-- 上次取消/失败保留副本的轻量提示（无验证按钮） -->
                                                                        <Border Background="#F3F4F6"
                                                                                BorderBrush="#E5E7EB"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="6,1.5"
                                                                                Margin="8,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip="{Binding StatusMessage}"
                                                                                Visibility="{Binding ShowPendingHistoryNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="上次未完成 · 副本保留"
                                                                                       FontSize="11"
                                                                                       Foreground="#6B7280"/>
                                                                        </Border>

                                                                        <!-- Error Status Indicator -->
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    VerticalAlignment="Center"
                                                                                    Visibility="{Binding Status, Converter={StaticResource ErrorStateToVisibilityConverter}}">
                                                                            <Border x:Name="ErrorTagBorder"
                                                                                    Style="{StaticResource ErrorTagStyle}"
                                                                                    Background="{Binding ErrorMessage, Converter={StaticResource ErrorTypeToColorConverter}}"
                                                                                    Cursor="Hand"
                                                                                    MouseLeftButtonDown="ErrorTag_MouseLeftButtonDown"
                                                                                    MouseEnter="ErrorTag_MouseEnter"
                                                                                    MouseLeave="ErrorTag_MouseLeave">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource ErrorTypeToIconConverter}}"
                                                                                               FontSize="11"
                                                                                               Margin="0,0,4,0"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource ErrorMessageToShortDescriptionConverter}}"
                                                                                               FontSize="11"
                                                                                               Foreground="White"
                                                                                               FontWeight="SemiBold"
                                                                                               VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </WrapPanel>

                                                                    <StackPanel Grid.Column="2"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center"
                                                                                Margin="12,0,0,0"
                                                                                IsEnabled="{Binding DataContext.IsExecuting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}">
                                                                        <!-- 仅刚还原且待验证/有未清理还原备份时显示验证入口 -->
                                                                        <Button Content="{Binding VerifyActionButtonText}"
                                                                                Command="{Binding DataContext.VerifyTaskDataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Visibility="{Binding ShowPendingVerificationEntry, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                Style="{StaticResource VerifyActionButtonStyle}"
                                                                                Margin="0,0,6,0"
                                                                                AutomationProperties.AutomationId="TaskVerifyData"/>

                                                                        <!-- 非统一模式下显示浏览按钮 -->
                                                                        <Button Content="浏览…"
                                                                                Command="{Binding DataContext.BrowseTaskTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Visibility="{Binding DataContext.UseUnifiedTarget, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                                                Style="{StaticResource CardSecondaryButtonStyle}"
                                                                                Margin="0,0,6,0"/>

                                                                        <!-- 迁移按钮 -->
                                                                        <Button Content="迁移"
                                                                                Command="{Binding DataContext.MigrateSingleTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource CardPrimaryButtonStyle}"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Row 1: Paths -->
                                                                <Grid Grid.Row="1" Margin="26,8,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="42"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                                               Text="源:"
                                                                               FontSize="11.5"
                                                                               Foreground="#6B7280"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                                                               Text="{Binding SourcePath}"
                                                                               FontSize="11.5"
                                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                                               Foreground="#374151"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="NoWrap"
                                                                               ToolTip="{Binding SourcePath}"/>

                                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                                               Text="目标:"
                                                                               FontSize="11.5"
                                                                               Foreground="#6B7280"
                                                                               Margin="0,4,0,0"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                                                               Text="{Binding TargetPath}"
                                                                               FontSize="11.5"
                                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                                               Foreground="#374151"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="NoWrap"
                                                                               Margin="0,4,0,0"
                                                                               ToolTip="{Binding TargetPath}"/>
                                                                </Grid>

                                                                <!-- Row 2: Progress Bar and Phase Info (when executing) -->
                                                                <StackPanel Grid.Row="2"
                                                                            Margin="26,8,0,0"
                                                                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock FontSize="11"
                                                                               Foreground="#0078D4"
                                                                               FontWeight="Medium"
                                                                               Margin="0,0,0,3">
                                                                        <Run Text="["/>
                                                                        <Run Text="{Binding CurrentPhase, Mode=OneWay}"/>
                                                                        <Run Text="/6] "/>
                                                                        <Run Text="{Binding PhaseDescription, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <ProgressBar Value="{Binding ProgressPercent}"
                                                                                 Maximum="100"
                                                                                 Height="6"
                                                                                 Margin="0,2"/>
                                                                    <TextBlock Text="{Binding StatusMessage}"
                                                                               FontSize="11"
                                                                               Foreground="#6B7280"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>

                                                                <!-- Row 3: Restore Verification / Backup Footer (ONLY for restored items awaiting verification or with retained restore backup) -->
                                                                <Border Grid.Row="3"
                                                                        Background="#FFFBEB"
                                                                        BorderBrush="#FDE68A"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        Padding="10,7"
                                                                        Margin="26,9,0,0"
                                                                        Visibility="{Binding ShowPendingVerificationEntry, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding TransactionStatusText}"
                                                                                   FontSize="11.5"
                                                                                   Foreground="#92400E"
                                                                                   TextWrapping="Wrap"/>
                                                                        <Grid Margin="0,5,0,0"
                                                                              Visibility="{Binding HasBackupPath, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="62"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding BackupPathLabel}"
                                                                                       FontSize="11.5"
                                                                                       Foreground="#92400E"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBox Grid.Column="1"
                                                                                     Text="{Binding BackupPath, Mode=OneWay}"
                                                                                     Style="{StaticResource CompactBackupPathBoxStyle}"
                                                                                     ToolTip="{Binding BackupPath}"
                                                                                     AutomationProperties.AutomationId="TaskBackupPath"/>
                                                                            <Button Grid.Column="2"
                                                                                    Content="{Binding DeletionDetailsButtonText}"
                                                                                    Command="{Binding DataContext.ViewDeletionDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Style="{StaticResource InlineBackupActionButtonStyle}"
                                                                                    Margin="6,0,0,0"
                                                                                    VerticalAlignment="Center"
                                                                                    ToolTip="弹窗查看完整备份处理逐项明细（支持筛选与搜索）"
                                                                                    Visibility="{Binding HasDeletionDetails, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Popup Error Details -->
                                                        <Popup x:Name="ErrorPopup"
                                                               PlacementTarget="{Binding ElementName=ErrorTagBorder}"
                                                               Placement="Bottom"
                                                               HorizontalOffset="0"
                                                               VerticalOffset="5"
                                                               AllowsTransparency="True"
                                                               PopupAnimation="Fade"
                                                               StaysOpen="True"
                                                               MouseEnter="ErrorPopup_MouseEnter"
                                                               MouseLeave="ErrorPopup_MouseLeave">
                                                            <Border Background="White"
                                                                    BorderBrush="{Binding ErrorType, Converter={StaticResource ErrorTypeToColorConverter}}"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="8"
                                                                    Padding="12"
                                                                    MaxWidth="400"
                                                                    Effect="{StaticResource PopupShadowEffect}">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border Grid.Column="0"
                                                                                Background="{Binding ErrorType, Converter={StaticResource ErrorTypeToColorConverter}}"
                                                                                CornerRadius="4"
                                                                                Padding="6,3"
                                                                                Margin="0,0,8,0">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding ErrorType, Converter={StaticResource ErrorTypeToIconConverter}}"
                                                                                           Foreground="White"
                                                                                           FontSize="12"
                                                                                           Margin="0,0,4,0"/>
                                                                                <TextBlock Text="{Binding ErrorType, Converter={StaticResource ErrorTypeToDescriptionConverter}}"
                                                                                           Foreground="White"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"/>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding DisplayName}"
                                                                                   FontSize="11"
                                                                                   Foreground="#6B7280"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </Grid>

                                                                    <TextBlock Text="详细错误信息"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="11"
                                                                               Foreground="#374151"
                                                                               Margin="0,0,0,4"/>
                                                                    <Border Background="#F9FAFB"
                                                                            BorderBrush="#E5E7EB"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Margin="0,0,0,10">
                                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                                      MaxHeight="200"
                                                                                      Style="{StaticResource ModernScrollViewer}">
                                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                                       TextWrapping="Wrap"
                                                                                       FontFamily="Consolas"
                                                                                       FontSize="10.5"
                                                                                       Foreground="#374151"
                                                                                       Padding="8"/>
                                                                        </ScrollViewer>
                                                                    </Border>

                                                                    <TextBlock Text="💡 建议解决方案"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="11"
                                                                               Foreground="#059669"
                                                                               Margin="0,0,0,4"/>
                                                                    <Border Background="#ECFDF5"
                                                                            BorderBrush="#A7F3D0"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Padding="8">
                                                                        <TextBlock Text="{Binding ErrorType, Converter={StaticResource ErrorTypeToSolutionConverter}}"
                                                                                   TextWrapping="Wrap"
                                                                                   FontSize="10.5"
                                                                                   Foreground="#065F46"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 已迁移任务 -->
            <TabItem Style="{StaticResource ModernTabItemStyle}"
                     AutomationProperties.Name="已迁移">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="已迁移" VerticalAlignment="Center"/>
                        <Border Background="#F3F4F6"
                                CornerRadius="9"
                                Padding="6,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding MigratedTaskCount}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#4B5563"/>
                        </Border>
                        <Border Background="#FEF3C7"
                                BorderBrush="#FCD34D"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="6,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding UnverifiedMigratedCount, Converter={StaticResource IntToVisibilityConverter}}">
                            <TextBlock Text="{Binding UnverifiedMigratedBadgeText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#92400E"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource ModernScrollViewer}">
                    <StackPanel Margin="16,12,16,16">
                        <!-- Filter Bar (only when migrated tasks exist) -->
                        <Grid Margin="2,0,2,10"
                              Visibility="{Binding HasMigratedTasks, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <RadioButton GroupName="MigratedFilterGroup"
                                             Style="{StaticResource FilterChipRadioStyle}"
                                             IsChecked="{Binding IsMigratedFilterAll, Mode=OneWay}"
                                             Command="{Binding SetMigratedFilterCommand}"
                                             CommandParameter="{x:Static vm:MigratedTaskFilter.All}"
                                             AutomationProperties.AutomationId="MigratedFilterAll">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="全部" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MigratedTaskCount}"
                                                   Margin="5,0,0,0"
                                                   Opacity="0.8"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="MigratedFilterGroup"
                                             Style="{StaticResource FilterChipAmberRadioStyle}"
                                             IsChecked="{Binding IsMigratedFilterUnverified, Mode=OneWay}"
                                             Command="{Binding SetMigratedFilterCommand}"
                                             CommandParameter="{x:Static vm:MigratedTaskFilter.Unverified}"
                                             AutomationProperties.AutomationId="MigratedFilterUnverified">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="待验证" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UnverifiedMigratedCount}"
                                                   Margin="5,0,0,0"
                                                   Opacity="0.85"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="MigratedFilterGroup"
                                             Style="{StaticResource FilterChipRadioStyle}"
                                             IsChecked="{Binding IsMigratedFilterRetainedBackup, Mode=OneWay}"
                                             Command="{Binding SetMigratedFilterCommand}"
                                             CommandParameter="{x:Static vm:MigratedTaskFilter.RetainedBackup}"
                                             AutomationProperties.AutomationId="MigratedFilterRetainedBackup">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="保留备份" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RetainedBackupMigratedCount}"
                                                   Margin="5,0,0,0"
                                                   Opacity="0.8"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="MigratedFilterGroup"
                                             Style="{StaticResource FilterChipRadioStyle}"
                                             IsChecked="{Binding IsMigratedFilterAbnormal, Mode=OneWay}"
                                             Command="{Binding SetMigratedFilterCommand}"
                                             CommandParameter="{x:Static vm:MigratedTaskFilter.Abnormal}"
                                             AutomationProperties.AutomationId="MigratedFilterAbnormal">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="异常" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AbnormalMigratedCount}"
                                                   Margin="5,0,0,0"
                                                   Opacity="0.8"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding MigratedFilterSummaryText}"
                                       FontSize="11.5"
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Empty State: No Migrated Tasks At All -->
                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Padding="40,36"
                                CornerRadius="8"
                                Visibility="{Binding HasMigratedTasks, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📦"
                                           FontSize="36"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="暂无已迁移任务"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="完成迁移后的目录会显示在这里，可进行使用验证、管理原始备份或一键还原"
                                           FontSize="13"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Empty State: Filtered Result Empty -->
                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Padding="36,30"
                                CornerRadius="8"
                                Visibility="{Binding ShowMigratedFilterEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔍"
                                           FontSize="32"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="当前筛选条件下暂无已迁移任务"
                                           FontSize="14.5"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <Button Content="显示全部已迁移"
                                        Command="{Binding SetMigratedFilterCommand}"
                                        CommandParameter="{x:Static vm:MigratedTaskFilter.All}"
                                        Style="{StaticResource PageSecondaryButtonStyle}"
                                        HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Migrated Task Groups -->
                        <ItemsControl ItemsSource="{Binding MigratedTaskGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <!-- Clean Section Header -->
                                        <StackPanel Orientation="Horizontal" Margin="2,2,0,8">
                                            <TextBlock Text="{Binding GroupName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Tasks.Count, StringFormat='· {0} 项'}"
                                                       FontSize="12"
                                                       Foreground="#9CA3AF"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid x:Name="MigratedTaskItemRoot">
                                                        <Border Style="{StaticResource MigratedTaskCardStyle}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- Row 0: Display Name, Status Pills, Error Tag, and Action Buttons -->
                                                                <Grid Grid.Row="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="14"
                                                                                   Foreground="#111827"
                                                                                   VerticalAlignment="Center"/>

                                                                        <!-- Verification Status Badge -->
                                                                        <Border Style="{StaticResource VerificationBadgeBorderStyle}"
                                                                                Cursor="Help"
                                                                                Visibility="{Binding HasVerificationBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <Border.ToolTip>
                                                                                <StackPanel MaxWidth="360">
                                                                                    <TextBlock Text="{Binding TransactionStatusText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                                    <TextBlock Text="{Binding VerificationText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                                </StackPanel>
                                                                            </Border.ToolTip>
                                                                            <TextBlock Text="{Binding VerificationBadgeText}"
                                                                                       Style="{StaticResource VerificationBadgeTextStyle}"/>
                                                                        </Border>

                                                                        <!-- Backup Short Status Badge -->
                                                                        <Border Background="#F3F4F6"
                                                                                BorderBrush="#E5E7EB"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="6,1.5"
                                                                                Margin="6,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                Cursor="Help"
                                                                                ToolTip="{Binding BackupStatusText}"
                                                                                Visibility="{Binding HasBackupShortBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="{Binding BackupShortBadgeText}"
                                                                                       FontSize="11"
                                                                                       Foreground="#4B5563"/>
                                                                        </Border>

                                                                        <!-- Error Status Indicator (for failed restore etc.) -->
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    VerticalAlignment="Center"
                                                                                    Visibility="{Binding Status, Converter={StaticResource ErrorStateToVisibilityConverter}}">
                                                                            <Border x:Name="ErrorTagBorder"
                                                                                    Style="{StaticResource ErrorTagStyle}"
                                                                                    Background="{Binding ErrorMessage, Converter={StaticResource ErrorTypeToColorConverter}}"
                                                                                    Cursor="Hand"
                                                                                    MouseLeftButtonDown="ErrorTag_MouseLeftButtonDown"
                                                                                    MouseEnter="ErrorTag_MouseEnter"
                                                                                    MouseLeave="ErrorTag_MouseLeave">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource ErrorTypeToIconConverter}}"
                                                                                               FontSize="11"
                                                                                               Margin="0,0,4,0"
                                                                                               VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding ErrorMessage, Converter={StaticResource ErrorMessageToShortDescriptionConverter}}"
                                                                                               FontSize="11"
                                                                                               Foreground="White"
                                                                                               FontWeight="SemiBold"
                                                                                               VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </WrapPanel>

                                                                    <!-- Right Action Bar: Verify/Manage Backup + Restore -->
                                                                    <StackPanel Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center"
                                                                                Margin="12,0,0,0"
                                                                                IsEnabled="{Binding DataContext.IsExecuting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}">
                                                                        <Button Content="{Binding VerifyActionButtonText}"
                                                                                Command="{Binding DataContext.VerifyTaskDataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Visibility="{Binding HasTransaction, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                Style="{StaticResource VerifyActionButtonStyle}"
                                                                                Margin="0,0,6,0"
                                                                                AutomationProperties.AutomationId="TaskVerifyData"/>
                                                                        <Button Content="还原"
                                                                                Command="{Binding DataContext.RestoreTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Style="{StaticResource CardSecondaryButtonStyle}"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Row 1: Paths & Compact Backup Path -->
                                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="58"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                                               Text="链接:"
                                                                               FontSize="11.5"
                                                                               Foreground="#6B7280"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                                                               Text="{Binding SourcePath}"
                                                                               FontSize="11.5"
                                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                                               Foreground="#374151"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="NoWrap"
                                                                               ToolTip="{Binding SourcePath}"/>

                                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                                               Text="目标:"
                                                                               FontSize="11.5"
                                                                               Foreground="#6B7280"
                                                                               Margin="0,4,0,0"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                               Text="{Binding DisplayMigratedTarget}"
                                                                               FontSize="11.5"
                                                                               FontFamily="Consolas, Microsoft YaHei UI"
                                                                               Foreground="#374151"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="NoWrap"
                                                                               Margin="0,4,0,0"
                                                                               ToolTip="{Binding DisplayMigratedTarget}"/>

                                                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                                                               Text="时间:"
                                                                               FontSize="11.5"
                                                                               Foreground="#6B7280"
                                                                               Margin="0,4,0,0"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding HasDisplayMigratedAt, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                                               Text="{Binding DisplayMigratedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                                               FontSize="11.5"
                                                                               Foreground="#6B7280"
                                                                               Margin="0,4,0,0"
                                                                               Visibility="{Binding HasDisplayMigratedAt, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                                    <!-- Compact Backup Path Row + Inline Deletion Details Button (preserves TaskBackupPath AutomationId) -->
                                                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                                                               Text="{Binding BackupPathLabel}"
                                                                               FontSize="11.5"
                                                                               Foreground="#6B7280"
                                                                               Margin="0,6,0,0"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding HasBackupPath, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    <TextBox Grid.Row="3" Grid.Column="1"
                                                                             Text="{Binding BackupPath, Mode=OneWay}"
                                                                             Style="{StaticResource CompactBackupPathBoxStyle}"
                                                                             Margin="0,6,0,0"
                                                                             ToolTip="{Binding BackupPath}"
                                                                             Visibility="{Binding HasBackupPath, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                             AutomationProperties.AutomationId="TaskBackupPath"/>
                                                                    <Button Grid.Row="3" Grid.Column="2"
                                                                            Content="{Binding DeletionDetailsButtonText}"
                                                                            Command="{Binding DataContext.ViewDeletionDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Style="{StaticResource InlineBackupActionButtonStyle}"
                                                                            Margin="6,6,0,0"
                                                                            VerticalAlignment="Center"
                                                                            ToolTip="弹窗查看完整备份处理逐项明细（支持筛选与搜索）"
                                                                            Visibility="{Binding HasDeletionDetails, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                </Grid>

                                                                <!-- Row 2: Progress Bar (when restoring) -->
                                                                <StackPanel Grid.Row="2"
                                                                            Margin="0,8,0,0"
                                                                            Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock FontSize="11"
                                                                               Foreground="#0078D4"
                                                                               FontWeight="Medium"
                                                                               Margin="0,0,0,3">
                                                                        <Run Text="["/>
                                                                        <Run Text="{Binding CurrentPhase, Mode=OneWay}"/>
                                                                        <Run Text="/6] "/>
                                                                        <Run Text="{Binding PhaseDescription, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <ProgressBar Value="{Binding ProgressPercent}"
                                                                                 Maximum="100"
                                                                                 Height="6"
                                                                                 Margin="0,2"/>
                                                                    <TextBlock Text="{Binding StatusMessage}"
                                                                               FontSize="11"
                                                                               Foreground="#6B7280"
                                                                               Margin="0,3,0,0"/>
                                                                </StackPanel>

                                                                <!-- Row 3: Warning Banner (for abnormal/inconsistent items) -->
                                                                <Border Grid.Row="3"
                                                                        Background="#FFFBEB"
                                                                        BorderBrush="#FDE68A"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5"
                                                                        Padding="9,6"
                                                                        Margin="0,8,0,0"
                                                                        Visibility="{Binding ShowMigratedWarningBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding StatusMessage}"
                                                                               FontSize="11.5"
                                                                               Foreground="#92400E"
                                                                               TextWrapping="Wrap"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Popup Error Details -->
                                                        <Popup x:Name="ErrorPopup"
                                                               PlacementTarget="{Binding ElementName=ErrorTagBorder}"
                                                               Placement="Bottom"
                                                               HorizontalOffset="0"
                                                               VerticalOffset="5"
                                                               AllowsTransparency="True"
                                                               PopupAnimation="Fade"
                                                               StaysOpen="True"
                                                               MouseEnter="ErrorPopup_MouseEnter"
                                                               MouseLeave="ErrorPopup_MouseLeave">
                                                            <Border Background="White"
                                                                    BorderBrush="{Binding ErrorType, Converter={StaticResource ErrorTypeToColorConverter}}"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="8"
                                                                    Padding="12"
                                                                    MaxWidth="400"
                                                                    Effect="{StaticResource PopupShadowEffect}">
                                                                <StackPanel>
                                                                    <Grid Margin="0,0,0,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <Border Grid.Column="0"
                                                                                Background="{Binding ErrorType, Converter={StaticResource ErrorTypeToColorConverter}}"
                                                                                CornerRadius="4"
                                                                                Padding="6,3"
                                                                                Margin="0,0,8,0">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding ErrorType, Converter={StaticResource ErrorTypeToIconConverter}}"
                                                                                           Foreground="White"
                                                                                           FontSize="12"
                                                                                           Margin="0,0,4,0"/>
                                                                                <TextBlock Text="{Binding ErrorType, Converter={StaticResource ErrorTypeToDescriptionConverter}}"
                                                                                           Foreground="White"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"/>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding DisplayName}"
                                                                                   FontSize="11"
                                                                                   Foreground="#6B7280"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </Grid>

                                                                    <TextBlock Text="详细错误信息"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="11"
                                                                               Foreground="#374151"
                                                                               Margin="0,0,0,4"/>
                                                                    <Border Background="#F9FAFB"
                                                                            BorderBrush="#E5E7EB"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Margin="0,0,0,10">
                                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                                      MaxHeight="200"
                                                                                      Style="{StaticResource ModernScrollViewer}">
                                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                                       TextWrapping="Wrap"
                                                                                       FontFamily="Consolas"
                                                                                       FontSize="10.5"
                                                                                       Foreground="#374151"
                                                                                       Padding="8"/>
                                                                        </ScrollViewer>
                                                                    </Border>

                                                                    <TextBlock Text="💡 建议解决方案"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="11"
                                                                               Foreground="#059669"
                                                                               Margin="0,0,0,4"/>
                                                                    <Border Background="#ECFDF5"
                                                                            BorderBrush="#A7F3D0"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Padding="8">
                                                                        <TextBlock Text="{Binding ErrorType, Converter={StaticResource ErrorTypeToSolutionConverter}}"
                                                                                   TextWrapping="Wrap"
                                                                                   FontSize="10.5"
                                                                                   Foreground="#065F46"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Log Area (Collapsible Bottom Drawer) -->
        <Expander Grid.Row="2"
                  IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}"
                  Style="{StaticResource BottomDrawerExpanderStyle}"
                  Background="White"
                  BorderBrush="#E5E7EB"
                  BorderThickness="0,1,0,0"
                  Padding="12,5">
            <Expander.Header>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <TextBlock Text="📋 执行日志"
                                   FontWeight="SemiBold"
                                   FontSize="12.5"
                                   Foreground="#374151"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>

                        <!-- Success Status -->
                        <Border Background="#10B981"
                                CornerRadius="10"
                                Padding="8,2"
                                Margin="0,0,6,0"
                                Visibility="{Binding CompletedCount, Converter={StaticResource IntToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CompletedCount}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="0,0,3,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="已完成"
                                           Foreground="White"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Failed Status -->
                        <Border Background="#EF4444"
                                CornerRadius="10"
                                Padding="8,2"
                                Visibility="{Binding FailedCount, Converter={StaticResource IntToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✗"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FailedCount}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="0,0,3,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="失败"
                                           Foreground="White"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Expander.Header>

            <Border Height="150"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    Padding="12,6">
                <ScrollViewer x:Name="QuickMigrateLogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource ModernScrollViewer}">
                    <i:Interaction.Behaviors>
                        <behaviors:AutoScrollBehavior/>
                    </i:Interaction.Behaviors>
                    <ItemsControl ItemsSource="{Binding LogMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#374151"
                                           TextWrapping="Wrap"
                                           Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>
    </Grid>
</UserControl>
