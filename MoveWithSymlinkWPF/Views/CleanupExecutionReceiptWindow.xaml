<Window x:Class="MoveWithSymlinkWPF.Views.CleanupExecutionReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MoveWithSymlinkWPF.Views"
        xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
        Title="{Binding WindowTitle}"
        AutomationProperties.AutomationId="CleanupExecutionReceiptWindow"
        Width="900" Height="660"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 模板 1：规则摘要头行 -->
        <DataTemplate x:Key="RuleHeaderTemplate">
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 行 1：状态胶囊 + 规则名称 + 右侧文件数与体积 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{Binding StatusBadgeBackground}"
                                BorderBrush="{Binding StatusBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="8,2" Margin="0,0,9,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{Binding StatusBadgeForeground}"/>
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProcessedCountText}" FontSize="11.5" Foreground="#64748B"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SizeText}" FontSize="13" FontWeight="Bold"
                                       Foreground="{Binding SizeForeground}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 行 2：摘要说明 + 跳过/失败胶囊 + 展开/收起全部明细按钮 -->
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Message}" FontSize="11.5" Foreground="#475569"
                                   TextWrapping="Wrap" LineHeight="17" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="7" Padding="6,1" Margin="0,0,6,0"
                                    Visibility="{Binding HasSkippedCount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding SkippedBadgeText}" FontSize="10.5" Foreground="#64748B"/>
                            </Border>
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                    CornerRadius="7" Padding="6,1" Margin="0,0,6,0"
                                    Visibility="{Binding HasFailedCount, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding FailedBadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C42B1C"/>
                            </Border>
                            <Button Content="{Binding ToggleDetailsText}"
                                    Command="{Binding ToggleExpandCommand}"
                                    Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Style="{StaticResource FluentLinkButtonStyle}"
                                    FontSize="11" Padding="6,2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 模板 2：单条独立虚拟化明细行（支持万级明细丝滑滚动、完整路径与单行复制） -->
        <DataTemplate x:Key="DetailLineTemplate">
            <Border Background="#F8FAFC" BorderBrush="#EEF2F6" BorderThickness="0,0,0,1" Padding="18,6,14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧归属竖线 -->
                    <Border Grid.Column="0" Background="{Binding GuideLineBrush}" CornerRadius="1.5" Margin="0,1,0,1"/>

                    <!-- 序号 -->
                    <TextBlock Grid.Column="1" Text="{Binding IndexText}" FontSize="10.5" Foreground="#94A3B8"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="6,0,8,0"/>

                    <!-- 轻量语义标签 -->
                    <Border Grid.Column="2"
                            Background="{Binding TagBackground}"
                            BorderBrush="{Binding TagBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TagText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding TagForeground}"/>
                    </Border>

                    <!-- 完整明细正文（支持换行且悬停显示全文） -->
                    <TextBlock Grid.Column="3" Text="{Binding DetailText}" FontSize="11.5" Foreground="#334155"
                               TextWrapping="Wrap" LineHeight="17" VerticalAlignment="Center"
                               ToolTip="{Binding DetailText}" Margin="0,0,8,0"/>

                    <!-- 单行一键复制 -->
                    <Button Grid.Column="4"
                            Content="{Binding CopyHintText}"
                            Command="{Binding CopyLineCommand}"
                            Style="{StaticResource FluentLinkButtonStyle}"
                            FontSize="10.5" Foreground="#64748B" Padding="6,1" VerticalAlignment="Center"
                            ToolTip="复制该条明细文本"/>
                </Grid>
            </Border>
        </DataTemplate>

        <views:CleanupReceiptEntryTemplateSelector x:Key="ReceiptEntryTemplateSelector"
                                                   RuleTemplate="{StaticResource RuleHeaderTemplate}"
                                                   DetailTemplate="{StaticResource DetailLineTemplate}"/>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. 顶部状态头 -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{Binding HeaderAccentBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,11"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                        Background="{Binding HeaderAccentBackground}"
                        BorderBrush="{Binding HeaderAccentBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid>
                        <Path Data="{StaticResource IconCheckCircle}" Width="19" Height="19" Stretch="Uniform"
                              Stroke="{Binding HeaderAccentForeground}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{Binding IsSuccessHeader, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Path Data="{StaticResource IconTriangleAlert}" Width="19" Height="19" Stretch="Uniform"
                              Stroke="{Binding HeaderAccentForeground}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{Binding IsWarningHeader, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Path Data="{StaticResource IconShieldAlert}" Width="19" Height="19" Stretch="Uniform"
                              Stroke="{Binding HeaderAccentForeground}" StrokeThickness="1.9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{Binding IsErrorHeader, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="15.5" FontWeight="Bold"
                               Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding HeaderMetaText}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{Binding HeaderAccentBackground}"
                        BorderBrush="{Binding HeaderAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12" Padding="11,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusChipText}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{Binding HeaderAccentForeground}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 1. 4 格 KPI 汇总卡 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="已同卷隔离" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                    <TextBlock Text="{Binding QuarantinedSizeText}" FontSize="18" FontWeight="Bold"
                               Foreground="{Binding QuarantinedValueBrush}" Margin="0,3,0,2"/>
                    <TextBlock Text="{Binding QuarantinedSubText}" FontSize="10.5" Foreground="#64748B"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding QuarantinedSubText}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="官方接口 / 回收站已回收" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ReclaimedSizeText}" FontSize="18" FontWeight="Bold"
                               Foreground="{Binding ReclaimedValueBrush}" Margin="0,3,0,2"/>
                    <TextBlock Text="{Binding ReclaimedSubText}" FontSize="10.5" Foreground="#64748B"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ReclaimedSubText}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="安全跳过" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                    <TextBlock Text="{Binding SkippedCountText}" FontSize="18" FontWeight="Bold"
                               Foreground="#334155" Margin="0,3,0,2"/>
                    <TextBlock Text="{Binding SkippedSubText}" FontSize="10.5" Foreground="#64748B"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SkippedSubText}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="失败 / 保留原状" FontSize="11" FontWeight="Medium" Foreground="#64748B"/>
                    <TextBlock Text="{Binding FailedCountText}" FontSize="18" FontWeight="Bold"
                               Foreground="{Binding FailedValueBrush}" Margin="0,3,0,2"/>
                    <TextBlock Text="{Binding FailedSubText}" FontSize="10.5" Foreground="#64748B"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FailedSubText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. 筛选胶囊栏 + 展开全部 + 实时搜索框 -->
        <Grid Grid.Row="2" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EEF2F6" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding TabAllText}" Command="{Binding SetFilterCommand}" CommandParameter="All"
                            AutomationProperties.AutomationId="ReceiptFilterAll"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5"
                            Tag="{Binding FilterAllTag}" Margin="0,0,2,0"/>
                    <Button Content="{Binding TabSucceededText}" Command="{Binding SetFilterCommand}" CommandParameter="Succeeded"
                            AutomationProperties.AutomationId="ReceiptFilterSucceeded"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5"
                            Tag="{Binding FilterSucceededTag}" Margin="0,0,2,0"/>
                    <Button Content="{Binding TabSkippedText}" Command="{Binding SetFilterCommand}" CommandParameter="Skipped"
                            AutomationProperties.AutomationId="ReceiptFilterSkipped"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5"
                            Tag="{Binding FilterSkippedTag}" Margin="0,0,2,0"/>
                    <Button Content="{Binding TabIssuesText}" Command="{Binding SetFilterCommand}" CommandParameter="Issues"
                            AutomationProperties.AutomationId="ReceiptFilterIssues"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5"
                            Tag="{Binding FilterIssuesTag}"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1" Text="{Binding VisibleCountHintText}" FontSize="11" Foreground="#64748B"
                       VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,8,0"/>

            <Button Grid.Column="2"
                    Content="{Binding ToggleAllDetailsButtonText}"
                    Command="{Binding ToggleAllDetailsCommand}"
                    AutomationProperties.AutomationId="ReceiptToggleAllDetailsButton"
                    Visibility="{Binding HasAnyDetails, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource FluentLinkButtonStyle}"
                    FontSize="11.5" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center"/>

            <Grid Grid.Column="3">
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FluentCompactTextBoxStyle}"
                         Height="32" Padding="28,0,26,0"
                         Tag="搜索规则、文件名或失败原因…"
                         AutomationProperties.AutomationId="ReceiptSearchBox"/>
                <Path Data="{StaticResource IconSearch}" Width="13" Height="13" Stretch="Uniform"
                      Stroke="#94A3B8" StrokeThickness="1.9"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                <Button Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource FluentIconButtonStyle}"
                        Width="22" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                        ToolTip="清空搜索">
                    <Path Data="{StaticResource IconX}" Width="11" Height="11" Stretch="Uniform" Stroke="#64748B" StrokeThickness="2"/>
                </Button>
            </Grid>
        </Grid>

        <!-- 3. 扁平化完整回执虚拟列表（规则头 + 逐条独立明细行，承载上万条明细 0ms 流畅滚动） -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <ListView ItemsSource="{Binding VisibleEntries}"
                          ItemTemplateSelector="{StaticResource ReceiptEntryTemplateSelector}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          AutomationProperties.AutomationId="CleanupReceiptListView">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- 筛选无结果空态 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="当前筛选条件下暂无匹配的回执记录" FontSize="13" FontWeight="SemiBold"
                               Foreground="#64748B" HorizontalAlignment="Center"/>
                    <TextBlock Text="可切换到「全部」标签或清空右上角搜索关键词查看完整明细。" FontSize="11.5"
                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. 底栏（Grid 自动约束提示换行，绝不被右侧按钮截断） -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconInfo}" Width="13.5" Height="13.5" Stretch="Uniform"
                      Stroke="#64748B" StrokeThickness="1.8" Margin="0,1,7,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding FooterHintText}" FontSize="11.5" Foreground="#475569"
                           TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding CopyReportCommand}"
                        AutomationProperties.AutomationId="ReceiptCopyReportButton"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        Height="32" Padding="12,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCopy}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="#334155" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CopyButtonText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding OpenQuarantineCommand}"
                        AutomationProperties.AutomationId="ReceiptOpenQuarantineButton"
                        Visibility="{Binding CanOpenQuarantine, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource FluentSoftPrimaryButtonStyle}"
                        Height="32" Padding="13,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconShieldCheck}" Width="13.5" Height="13.5" Stretch="Uniform"
                              Stroke="#0078D4" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="前往隔离区释放空间" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Content="关闭"
                        Command="{Binding CloseWindowCommand}"
                        IsDefault="True" IsCancel="True"
                        AutomationProperties.AutomationId="ReceiptCloseButton"
                        Style="{StaticResource FluentPrimaryButtonStyle}"
                        Height="32" MinWidth="84" Padding="18,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
