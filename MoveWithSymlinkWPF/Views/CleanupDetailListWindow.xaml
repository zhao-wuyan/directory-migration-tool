<Window x:Class="MoveWithSymlinkWPF.Views.CleanupDetailListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清理项完整明细与搜索"
        AutomationProperties.AutomationId="CleanupDetailListWindow"
        Width="860" Height="600"
        MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：规则标题 + 建议度徽章 + 统计 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Border x:Name="TierBadgeBorder" DockPanel.Dock="Right"
                    Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                    CornerRadius="10" Padding="9,3" VerticalAlignment="Top" Margin="10,2,0,0">
                <TextBlock x:Name="TierBadgeText" Text="建议清理" FontSize="11" FontWeight="SemiBold" Foreground="#0F7B4B"/>
            </Border>
            <StackPanel>
                <TextBlock x:Name="RuleTitleText" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RuleSummaryText" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- 工具栏：实时搜索框 + 排序切换 -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource FluentCompactTextBoxStyle}"
                             Padding="30,0,28,0"
                             Tag="按文件名、扩展名或路径关键词搜索（支持空格多关键词）…"
                             TextChanged="SearchTextBox_OnTextChanged"
                             AutomationProperties.AutomationId="CleanupDetailSearchBox"/>
                    <Path Data="{StaticResource IconSearch}" Width="13" Height="13" Stretch="Uniform"
                          Stroke="#94A3B8" StrokeThickness="1.9"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <Button x:Name="ClearSearchButton" Visibility="Collapsed"
                            Click="ClearSearchButton_OnClick"
                            Style="{StaticResource FluentIconButtonStyle}"
                            Width="22" Height="22"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                            ToolTip="清空搜索关键词">
                        <Path Data="{StaticResource IconX}" Width="11" Height="11" Stretch="Uniform" Stroke="#64748B" StrokeThickness="2"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="排序：" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button x:Name="SortSizeButton" Content="按大小" Tag="Active" Height="28" Padding="10,0" Margin="0,0,5,0"
                            FontSize="11.5" Style="{StaticResource FluentSecondaryButtonStyle}" Click="SortSizeButton_OnClick"/>
                    <Button x:Name="SortNameButton" Content="按名称" Height="28" Padding="10,0" Margin="0,0,5,0"
                            FontSize="11.5" Style="{StaticResource FluentSecondaryButtonStyle}" Click="SortNameButton_OnClick"/>
                    <Button x:Name="SortPathButton" Content="按路径" Height="28" Padding="10,0"
                            FontSize="11.5" Style="{StaticResource FluentSecondaryButtonStyle}" Click="SortPathButton_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主列表区：严格 UI 虚拟化 + 容器回收（支持 5 万条记录丝滑滚动零卡顿） -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Padding="12,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文件名 / 条目" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Grid.Column="1" Text="完整路径" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="类型 · 大小" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="操作" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 虚拟化列表 -->
                <ListView x:Name="DetailListView"
                          Grid.Row="1"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          MouseDoubleClick="DetailListView_OnMouseDoubleClick"
                          AutomationProperties.AutomationId="CleanupDetailVirtualizedList">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="rowBd" Background="{TemplateBinding Background}" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="rowBd" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="rowBd" Property="Background" Value="#EBF5FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="11.5" FontWeight="Medium" Foreground="#0F172A"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DirectoryPath}" FontSize="11" Foreground="#64748B"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding TypeAndSizeText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding AccentFg}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Click="LocateRowButton_OnClick" Tag="{Binding FullPath}"
                                        Style="{StaticResource FluentLinkButtonStyle}"
                                        FontSize="11" Content="定位" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ToolTip="在资源管理器中只读定位该文件（不执行任何删除）"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 加载中/空搜索结果提示 -->
                <Border x:Name="EmptyOverlay" Grid.Row="1" Background="#F2FFFFFF" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyOverlayText" Text="正在准备明细列表…" FontSize="12.5" Foreground="#64748B"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- 底栏：实时筛选统计 + 关闭按钮 -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" IsDefault="True"
                    Click="CloseButton_OnClick" Style="{StaticResource FluentSecondaryButtonStyle}"
                    Height="32" Padding="18,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconInfo}" Width="13" Height="13" Stretch="Uniform"
                      Stroke="#64748B" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="FooterStatsText" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
