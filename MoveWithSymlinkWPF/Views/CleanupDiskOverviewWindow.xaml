<Window x:Class="MoveWithSymlinkWPF.Views.CleanupDiskOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
        Title="本机全部磁盘空间与清理态势"
        AutomationProperties.AutomationId="CleanupDiskOverviewWindow"
        Width="780" Height="560"
        MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：标题与全局统计 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1"
                    CornerRadius="10" Padding="10,4" VerticalAlignment="Top" Margin="10,2,0,0">
                <TextBlock x:Name="TotalSummaryBadge" Text="共 0 块固定磁盘" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4"/>
            </Border>
            <StackPanel>
                <TextBlock Text="本机全部磁盘空间与清理态势" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="SubtitleText"
                           Text="实时读取所有就绪固定磁盘的容量、MFT 缓存、隔离区占用与跨盘缓存源（零磁盘遍历开销）。"
                           FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- 搜索与排序工具栏 -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource FluentCompactTextBoxStyle}"
                             Padding="30,0,28,0"
                             Tag="按盘符或卷标搜索（如 C:、D:、游戏盘）…"
                             TextChanged="SearchTextBox_OnTextChanged"
                             AutomationProperties.AutomationId="DiskOverviewSearchBox"/>
                    <Path Data="{StaticResource IconSearch}" Width="13" Height="13" Stretch="Uniform"
                          Stroke="#94A3B8" StrokeThickness="1.9"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    <Button x:Name="ClearSearchButton" Visibility="Collapsed"
                            Click="ClearSearchButton_OnClick"
                            Style="{StaticResource FluentIconButtonStyle}"
                            Width="22" Height="22"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                            ToolTip="清空搜索">
                        <Path Data="{StaticResource IconX}" Width="11" Height="11" Stretch="Uniform" Stroke="#64748B" StrokeThickness="2"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="排序：" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <Button x:Name="SortUrgencyButton" Content="按紧张度" Height="28" Padding="10,0" Margin="0,0,5,0"
                            FontSize="11.5" Style="{StaticResource FluentSoftPrimaryButtonStyle}" Click="SortUrgencyButton_OnClick"/>
                    <Button x:Name="SortFreeButton" Content="按剩余空间" Height="28" Padding="10,0" Margin="0,0,5,0"
                            FontSize="11.5" Style="{StaticResource FluentSecondaryButtonStyle}" Click="SortFreeButton_OnClick"/>
                    <Button x:Name="SortLetterButton" Content="按盘符" Height="28" Padding="10,0"
                            FontSize="11.5" Style="{StaticResource FluentSecondaryButtonStyle}" Click="SortLetterButton_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 虚拟化磁盘列表（轻松承载十几甚至二十几块磁盘） -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <ListView x:Name="DiskListView"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      AutomationProperties.AutomationId="DiskOverviewVirtualizedList">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="rowBd" Background="{TemplateBinding Background}"
                                            BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,10">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="rowBd" Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 顶行：图标 + 盘名 + 状态胶囊 + 容量文字 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CapacitySummaryText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}"
                                            BorderThickness="1" CornerRadius="9" Padding="7,1.5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBadgeFg}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" Background="{Binding IconBg}" CornerRadius="6" Margin="0,0,8,0">
                                        <Path Data="{StaticResource IconHardDrive}" Width="13" Height="13" Stretch="Uniform"
                                              Stroke="{Binding IconStroke}" StrokeThickness="1.9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A"
                                               VerticalAlignment="Center" Margin="0,0,7,0"/>

                                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8"
                                            Padding="6,1" Margin="0,0,5,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasFreshMftCache, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding MftBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#0F7B4B"/>
                                    </Border>
                                    <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8"
                                            Padding="6,1" Margin="0,0,5,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasCrossDriveSources, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding CrossDriveBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#0078D4"/>
                                    </Border>
                                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8"
                                            Padding="6,1" VerticalAlignment="Center"
                                            Visibility="{Binding HasQuarantineData, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding QuarantineBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#B45309"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- 底行：容量进度条 + 已用百分比 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="6"
                                             Foreground="{Binding BarBrush}" Style="{StaticResource FluentProgressBarStyle}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding UsedPercentText}" FontSize="10.5" Foreground="#64748B"
                                           Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="54" TextAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 底栏 -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenQuarantineButton" Content="前往隔离区管理"
                        Click="OpenQuarantineButton_OnClick"
                        Style="{StaticResource FluentSoftPrimaryButtonStyle}"
                        Height="32" Padding="14,0" Margin="0,0,8,0"
                        Visibility="Collapsed"/>
                <Button Content="关闭" IsCancel="True" IsDefault="True"
                        Click="CloseButton_OnClick"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        Height="32" Padding="18,0"/>
            </StackPanel>
            <TextBlock x:Name="FooterSummaryText" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
