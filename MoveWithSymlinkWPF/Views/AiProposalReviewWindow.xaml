<Window x:Class="MoveWithSymlinkWPF.Views.AiProposalReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
        xmlns:vm="clr-namespace:MoveWithSymlinkWPF.ViewModels"
        Title="{Binding WindowTitle}"
        AutomationProperties.AutomationId="AiProposalReviewWindow"
        Width="920" Height="680"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        KeyDown="Window_OnKeyDown">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="14,11">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 紧凑顶栏：标题 + 总览统计 + 免责徽章一行收拢 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Border DockPanel.Dock="Right"
                    Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                    CornerRadius="9" Padding="8,2.5" VerticalAlignment="Center" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconShieldCheck}" Width="11.5" Height="11.5" Stretch="Uniform"
                          Stroke="#B45309" StrokeThickness="1.9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="仅勾选加入清单 · 绝不立即执行" FontSize="10.5" FontWeight="SemiBold" Foreground="#B45309"/>
                </StackPanel>
            </Border>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding WindowTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                           ToolTip="{Binding HeaderSubtitle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalScopeMetaText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0078D4"/>
                </Border>
            </WrapPanel>
        </DockPanel>

        <!-- 紧凑工具栏：仅多分类时显示标签行；搜索、筛选、全选收拢为单行 -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="9,7" Margin="0,0,0,7">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6"
                           Visibility="{Binding HasMultipleCategoryTabs, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="All"
                            Tag="{Binding AllTabTag}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="24" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,5,2">
                        <TextBlock Text="{Binding AllTabText}"/>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Migration"
                            Tag="{Binding MigrationTabTag}"
                            Visibility="{Binding HasMigrationTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="24" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,5,2">
                        <TextBlock Text="{Binding MigrationTabText}"/>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="CleanupResidual"
                            Tag="{Binding ResidualTabTag}"
                            Visibility="{Binding HasResidualTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="24" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,5,2">
                        <TextBlock Text="{Binding ResidualTabText}"/>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="CleanupRule"
                            Tag="{Binding RuleTabTag}"
                            Visibility="{Binding HasRuleTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="24" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,5,2">
                        <TextBlock Text="{Binding RuleTabText}"/>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="RuleRecommended"
                            Tag="{Binding RuleRecommendedTabTag}"
                            Visibility="{Binding HasRuleRecommendedTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Foreground="#0F7B4B"
                            Height="24" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,5,2">
                        <TextBlock Text="{Binding RuleRecommendedTabText}"/>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="RuleOnDemand"
                            Tag="{Binding RuleOnDemandTabTag}"
                            Visibility="{Binding HasRuleOnDemandTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Foreground="#0078D4"
                            Height="24" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,5,2">
                        <TextBlock Text="{Binding RuleOnDemandTabText}"/>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="RuleCaution"
                            Tag="{Binding RuleCautionTabTag}"
                            Visibility="{Binding HasRuleCautionTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Foreground="#B45309"
                            Height="24" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,5,2">
                        <TextBlock Text="{Binding RuleCautionTabText}"/>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="NativeGuide"
                            Tag="{Binding NativeTabTag}"
                            Visibility="{Binding HasNativeTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="24" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,5,2">
                        <TextBlock Text="{Binding NativeTabText}"/>
                    </Button>
                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Blocked"
                            Tag="{Binding BlockedTabTag}"
                            Visibility="{Binding HasBlockedTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="24" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,5,2">
                        <TextBlock Text="{Binding BlockedTabText}"/>
                    </Button>
                </WrapPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FluentCompactTextBoxStyle}"
                                 Height="28" Padding="27,0,24,0" FontSize="11"
                                 Tag="按目录名、规则 ID、路径或理由搜索（空格多关键词）…"
                                 AutomationProperties.AutomationId="AiProposalReviewSearchBox"/>
                        <Path Data="{StaticResource IconSearch}" Width="12" Height="12" Stretch="Uniform"
                              Stroke="#94A3B8" StrokeThickness="1.9"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                        <Button Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding HasSearchKeyword, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource FluentIconButtonStyle}"
                                Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                ToolTip="清空搜索">
                            <Path Data="{StaticResource IconX}" Width="10" Height="10" Stretch="Uniform" Stroke="#64748B" StrokeThickness="2"/>
                        </Button>
                    </Grid>

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding OnlyShowPendingActionable, Mode=TwoWay}"
                              VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="仅看可添加" FontSize="11" Foreground="#334155"/>
                    </CheckBox>

                    <Button Grid.Column="2"
                            Command="{Binding ToggleSelectAllVisibleCommand}"
                            IsEnabled="{Binding HasSelectableInVisible}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="28" MinWidth="0" Padding="10,0" FontSize="11"
                            AutomationProperties.AutomationId="AiProposalReviewSelectAllButton">
                        <TextBlock Text="{Binding ToggleSelectVisibleText}"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 非阻塞反馈横幅（批量添加后展示回执 + 一键跳转入口） -->
        <Border Grid.Row="2"
                Background="{Binding FeedbackBg}" BorderBrush="{Binding FeedbackBorder}" BorderThickness="1"
                CornerRadius="7" Padding="10,6" Margin="0,0,0,7"
                Visibility="{Binding HasFeedbackBanner, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Command="{Binding JumpToMigrationPlanCommand}"
                            Visibility="{Binding ShowJumpToMigrationButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentLinkButtonStyle}" Foreground="#0F7B4B" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,10,0">
                        <TextBlock Text="前往待迁移清单 →"/>
                    </Button>
                    <Button Command="{Binding JumpToCleanupResidualCommand}"
                            Visibility="{Binding ShowJumpToResidualButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentLinkButtonStyle}" Foreground="#B45309" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,10,0">
                        <TextBlock Text="前往「AI 疑似残留」复核 →"/>
                    </Button>
                    <Button Command="{Binding JumpToCleanupPageCommand}"
                            Visibility="{Binding ShowJumpToCleanupRulesButton, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentLinkButtonStyle}" Foreground="#0078D4" FontSize="10.5" FontWeight="SemiBold">
                        <TextBlock Text="前往垃圾清理页 →"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding FeedbackMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding FeedbackFg}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 高信息密度明细主列表区（单屏可同时浏览 6~8 项） -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="6">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasVisibleRows, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="当前筛选条件下没有匹配的建议条目" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                    <TextBlock Text="可切换分类标签、取消「仅看可添加」或清空搜索关键词查看全部建议。" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 严格 UI 虚拟化 + 容器回收 + 预冻结画刷 + 零 RelativeSource 树遍历，首帧仅渲染可视行，消除开窗白屏 -->
                <ListView ItemsSource="{Binding VisibleRows}"
                          Visibility="{Binding HasVisibleRows, Converter={StaticResource BoolToVisibilityConverter}}"
                          BorderThickness="0"
                          Background="Transparent"
                          Padding="1"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          AutomationProperties.AutomationId="AiProposalReviewVirtualizedList">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AiProposalReviewRowItem}">
                            <Border Background="{Binding RowBgBrush}" BorderBrush="{Binding RowBorderBrush}" BorderThickness="1"
                                    CornerRadius="7" Padding="0" Margin="0,0,3,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧 4px 档位/类型识别色条（1档绿 / 2档蓝 / 3档与疑似残留琥珀 / 拦截红） -->
                                    <Border Grid.Column="0" Background="{Binding AccentStripeBrush, Mode=OneWay}" CornerRadius="6,0,0,6"/>

                                    <!-- 左列：复选框 / 单一状态符号 -->
                                    <Grid Grid.Column="1" VerticalAlignment="Top" Margin="8,9,0,7">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding NonCheckboxGlyph}"
                                                   Foreground="{Binding NonCheckboxGlyphBrush}"
                                                   FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,-1,0,0"
                                                   Visibility="{Binding ShowNonCheckboxGlyph, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>

                                    <!-- 中列：紧凑两行（首行：徽章 + 标题 + 内联路径/规则ID；次行：理由 + 可选精简风险行） -->
                                    <StackPanel Grid.Column="2" Margin="0,7,12,7">
                                        <DockPanel Margin="0,0,0,2.5">
                                            <Border DockPanel.Dock="Left"
                                                    Background="{Binding CategoryBadgeBgBrush, Mode=OneWay}"
                                                    BorderBrush="{Binding CategoryBadgeBorderBrush, Mode=OneWay}"
                                                    BorderThickness="1"
                                                    CornerRadius="7" Padding="5.5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryBadgeText, Mode=OneWay}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{Binding CategoryBadgeFgBrush, Mode=OneWay}"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SanitizedPath, Mode=OneWay}"
                                                       ToolTip="{Binding PathToolTip, Mode=OneWay}"
                                                       Visibility="{Binding HasPathText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       FontSize="10.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding Reason, Mode=OneWay}" FontSize="11" Foreground="#334155" TextWrapping="Wrap" LineHeight="15.5"/>

                                        <TextBlock Visibility="{Binding HasRiskWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   FontSize="10.5" Foreground="#B45309" TextWrapping="Wrap" LineHeight="14.5" Margin="0,2.5,0,0">
                                            <Run Text="⚠ 风险：" FontWeight="Bold"/>
                                            <Run Text="{Binding RiskWarning, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 右列：体积 + 非默认状态徽章 + 内联轻动作按钮 -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="104" Margin="0,7,10,7">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="{Binding StatusBadgeBgBrush}" BorderBrush="{Binding StatusBadgeBorderBrush}" BorderThickness="1"
                                                    CornerRadius="7" Padding="5.5,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                    Visibility="{Binding ShowStatusBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeFgBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding SizeText, Mode=OneWay}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding CategoryBadgeFgBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Command="{Binding OpenDirectoryInExplorerCommand, Mode=OneWay}"
                                                    Visibility="{Binding CanOpenInExplorer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource FluentLinkButtonStyle}"
                                                    Foreground="#0078D4" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,8,0"
                                                    ToolTip="在资源管理器中打开该目录核实内容">
                                                <TextBlock Text="核实目录"/>
                                            </Button>

                                            <Button Command="{Binding LocateInTreeCommand, Mode=OneWay}"
                                                    Visibility="{Binding CanLocateInTree, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource FluentLinkButtonStyle}"
                                                    Foreground="#475569" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,8,0">
                                                <TextBlock Text="目录树定位"/>
                                            </Button>

                                            <Button Command="{Binding LocateCleanupRuleCommand, Mode=OneWay}"
                                                    Visibility="{Binding CanLocateCleanupRule, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource FluentLinkButtonStyle}"
                                                    Foreground="#0078D4" FontSize="10.5" FontWeight="SemiBold">
                                                <TextBlock Text="{Binding LocateCleanupRuleButtonText, Mode=OneWay}"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 紧凑底栏：勾选汇总 + 批量添加主按钮 + 关闭 -->
        <DockPanel Grid.Row="4" Margin="0,9,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ConfirmSelectedCommand}"
                        IsEnabled="{Binding CanConfirmSelected}"
                        Style="{StaticResource FluentPrimaryButtonStyle}"
                        Height="31" Padding="15,0" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="AiProposalReviewConfirmButton">
                    <TextBlock Text="{Binding ConfirmButtonText}"/>
                </Button>
                <Button Command="{Binding CloseDialogCommand}"
                        IsCancel="True"
                        Style="{StaticResource FluentSecondaryButtonStyle}"
                        Height="31" Padding="14,0" FontSize="11.5"
                        AutomationProperties.AutomationId="AiProposalReviewCloseButton">
                    <TextBlock Text="关闭"/>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding SelectionSummaryText}"
                       FontSize="11" Foreground="#475569" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
