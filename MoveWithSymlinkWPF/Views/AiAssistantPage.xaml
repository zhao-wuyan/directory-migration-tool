<UserControl x:Class="MoveWithSymlinkWPF.Views.AiAssistantPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
             xmlns:views="clr-namespace:MoveWithSymlinkWPF.Views"
             xmlns:vm="clr-namespace:MoveWithSymlinkWPF.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="610"
             d:DesignWidth="1000"
             Background="#F4F6F9"
             FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <!-- 左侧：全局上下文驾驶舱 / 模型配置双标签；右侧：支持三会话切换的宽屏 AI 分析助手 -->
    <Grid x:Name="RootLayoutGrid" Margin="18,14" SizeChanged="RootLayoutGrid_OnSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftMainColumn" Width="*" MinWidth="460"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition x:Name="RightDrawerColumn" Width="410" MinWidth="340" MaxWidth="920"/>
        </Grid.ColumnDefinitions>

        <!-- LeftMainArea -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题 + 左栏视图切换（分析上下文 | 模型配置） -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Border DockPanel.Dock="Right" Background="#EEF2F6" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SelectLeftTabCommand}" CommandParameter="Context"
                                AutomationProperties.AutomationId="AiLeftTabContext"
                                Tag="{Binding ContextTabChipTag}"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                Height="27" MinWidth="0" Padding="11,0" FontSize="11" Margin="0,0,3,0">
                            <TextBlock Text="分析上下文"/>
                        </Button>
                        <Button Command="{Binding SelectLeftTabCommand}" CommandParameter="Config"
                                AutomationProperties.AutomationId="AiLeftTabConfig"
                                Tag="{Binding ConfigTabChipTag}"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                Height="27" MinWidth="0" Padding="11,0" FontSize="11">
                            <TextBlock Text="模型配置"/>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AI 空间诊断中心" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShieldCheck}" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="#0078D4" StrokeThickness="1.9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="三会话隔离 · 零执行权" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="联合各盘余量、双扫描快照与备份/隔离区做全局腾空间规划；右侧可随时切回扫描或清理会话宽屏续聊。"
                               FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Tab 1：全局分析上下文（已配好模型时默认展示） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsContextTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <!-- 卡片 1：共享本机各盘空间余量 -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshSharedContextCommand}"
                                        Style="{StaticResource FluentLinkButtonStyle}" FontSize="11" VerticalAlignment="Center">
                                    <TextBlock Text="刷新状态"/>
                                </Button>
                                <TextBlock Text="本机磁盘空间态势（多页共享缓存）" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding SharedDriveRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AiSharedDriveRowItem}">
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeBg}" BorderBrush="{Binding StatusBadgeBorder}"
                                                            BorderThickness="1" CornerRadius="8" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeFg}"/>
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SpaceMetaText}" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TitleText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="4"
                                                             Foreground="{Binding BarColor}" Background="#E2E8F0"
                                                             Style="{StaticResource FluentProgressBarStyle}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 2：双快照授权状态（磁盘扫描多盘共存 + 垃圾清理快照） -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="AI 只读数据授权（双快照上下文）" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                            <!-- 磁盘扫描多盘快照 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding ToggleSnapshotSharingCommand}"
                                                    Style="{StaticResource FluentLinkButtonStyle}" FontSize="10.5" Margin="0,0,8,0"
                                                    Visibility="{Binding HasAuthorizedSnapshot, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="撤销共享"/>
                                            </Button>
                                            <Button Command="{Binding OpenDiskScanCommand}"
                                                    Style="{StaticResource FluentSoftPrimaryButtonStyle}" Height="25" Padding="9,0" FontSize="10.5">
                                                <TextBlock Text="磁盘扫描"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SnapshotContextTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SnapshotContextMeta}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- 已授权的多盘快照胶囊列表 -->
                                    <ItemsControl ItemsSource="{Binding AuthorizedDiskScans}" Margin="0,7,0,0"
                                                  Visibility="{Binding HasAuthorizedSnapshot, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AiAuthorizedScanRowItem}">
                                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SummaryText}" FontSize="10" FontWeight="SemiBold" Foreground="#0F7B4B" VerticalAlignment="Center"/>
                                                        <Button Command="{Binding DataContext.RevokeSingleDiskScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource FluentLinkButtonStyle}"
                                                                Foreground="#0F7B4B" FontSize="10" Margin="5,0,0,0" ToolTip="撤销此盘快照共享">
                                                            <TextBlock Text="✕"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 垃圾清理快照 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding OpenCleanupCommand}"
                                            Style="{StaticResource FluentSoftPrimaryButtonStyle}" Height="25" Padding="9,0" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="垃圾清理"/>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CleanupSnapshotTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CleanupSnapshotMeta}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 3：已有留存空间（备份 + 清理隔离区）与本轮建议汇总 -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="可直接安全释放的留存空间 &amp; 建议汇总" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Command="{Binding OpenBackupCenterCommand}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}" Height="24" Padding="9,0" FontSize="10.5" Margin="8,0,0,0">
                                    <TextBlock Text="备份管理"/>
                                </Button>
                                <TextBlock Text="{Binding BackupSummaryTitle}" FontSize="11" Foreground="#334155" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Command="{Binding OpenQuarantineCommand}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}" Height="24" Padding="9,0" FontSize="10.5" Margin="8,0,0,0">
                                    <TextBlock Text="清理隔离区"/>
                                </Button>
                                <TextBlock Text="{Binding QuarantineSummaryTitle}" FontSize="11" Foreground="#334155" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="9,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding OpenAllProposalsReviewCommand}"
                                            Style="{StaticResource FluentLinkButtonStyle}" FontSize="10.5" FontWeight="SemiBold"
                                            Foreground="#0078D4" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding HasAnyProposalSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="统一审阅 ↗"/>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Left" Text="建议收件箱：" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProposalInboxSummaryText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 4：脱敏热点大目录预览（有磁盘扫描快照时展示） -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12"
                            Visibility="{Binding HasAuthorizedSnapshot, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="最新扫描热点大目录（用户名已脱敏为 &lt;USER&gt;）" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding ContextHotspots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="12" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconFolder}" Width="13" Height="13" Stretch="Uniform"
                                                              Stroke="#0078D4" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <Border Background="{Binding BadgeBg}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1"
                                                                CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SanitizedPath}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Tab 2：BYOK / 本地 Ollama 模型配置卡（未配置模型时默认显示，点设置齿轮可随时切回） -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#BFDBFE" BorderThickness="1.2" CornerRadius="10" Padding="14"
                    Visibility="{Binding IsConfigTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <!-- CfgFoot 固定吸底 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ConfigFeedbackMessage}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasConfigFeedback, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding TestConnectionCommand}"
                                        AutomationProperties.AutomationId="AiTestConnectionButton"
                                        IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                        Height="30" Padding="12,0" FontSize="11.5" Margin="0,0,6,0">
                                    <TextBlock Text="测试连接"/>
                                </Button>
                                <Button Command="{Binding SaveConfigCommand}"
                                        AutomationProperties.AutomationId="AiSaveConfigButton"
                                        Style="{StaticResource FluentPrimaryButtonStyle}"
                                        Height="30" Padding="14,0" FontSize="11.5">
                                    <TextBlock Text="保存配置"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Path Data="{StaticResource IconLock}" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{Binding PrivacyNoticeFg}" StrokeThickness="1.9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PrivacyNoticeText}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding PrivacyNoticeFg}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" Background="{Binding ConnectionBadgeBg}" BorderBrush="{Binding ConnectionBadgeBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheckCircle}" Width="11" Height="11" Stretch="Uniform"
                                              Stroke="{Binding ConnectionBadgeFg}" StrokeThickness="1.9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ConnectionBadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ConnectionBadgeFg}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconSliders}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="#0078D4" StrokeThickness="1.9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AI 模型配置（BYOK · OpenAI 兼容 / 本地 Ollama）" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding PresetChips}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Tag="{Binding ChipTag}"
                                                ToolTip="{Binding HintText}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="28" MinWidth="0" Padding="10,0" FontSize="11" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="API Endpoint" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="https://api.deepseek.com/v1 （本地 Ollama 填 http://localhost:11434/v1）"
                                         AutomationProperties.AutomationId="AiEndpointInput"
                                         Style="{StaticResource FluentCompactTextBoxStyle}"
                                         Background="#F8FAFC" Height="30" FontSize="11"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="模型名称" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="例如 deepseek-chat / qwen-plus / qwen2.5:14b"
                                         AutomationProperties.AutomationId="AiModelNameInput"
                                         Style="{StaticResource FluentCompactTextBoxStyle}"
                                         Background="#F8FAFC" Height="30" FontSize="11"/>
                                <TextBlock Grid.Column="3" Text="步数 (0不限)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding MaxToolSteps, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="AiMaxToolStepsInput"
                                         ToolTip="单次分析工具调用步数上限：填 0 表示不限制（推荐）；也可填写 1~200 指定具体上限"
                                         Style="{StaticResource FluentCompactTextBoxStyle}"
                                         Background="#F8FAFC" Height="30" FontSize="11" HorizontalContentAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="无响应 (秒)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="7"
                                         Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="AiTimeoutSecondsInput"
                                         ToolTip="动态无响应超时（默认 90 秒，范围 15~300 秒）"
                                         Style="{StaticResource FluentCompactTextBoxStyle}"
                                         Background="#F8FAFC" Height="30" FontSize="11" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="API Key" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7" Height="30" Padding="8,0">
                                    <PasswordBox x:Name="ApiKeyPasswordBox"
                                                 AutomationProperties.AutomationId="AiApiKeyPasswordBox"
                                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                                 FontSize="11" Foreground="#0F172A"/>
                                </Border>
                                <Button Grid.Column="2" Content="清除密钥"
                                        Command="{Binding ClearSavedApiKeyCommand}"
                                        Style="{StaticResource FluentLinkButtonStyle}"
                                        Foreground="#C42B1C" FontSize="11" Margin="6,0,0,0"
                                        Visibility="{Binding HasSavedApiKey, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>

                            <TextBlock Text="{Binding ApiKeyStatusHint}" FontSize="10.5" Foreground="#64748B" Margin="78,2,0,8" TextWrapping="Wrap"/>

                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="回复语言" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Command="{Binding SelectResponseLanguageCommand}"
                                            CommandParameter="Chinese"
                                            AutomationProperties.AutomationId="AiResponseLangChineseButton"
                                            Tag="{Binding ChineseLanguageChipTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                            Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="26" MinWidth="0" Padding="10,0" FontSize="11" Margin="0,0,6,0"
                                            ToolTip="引导 AI 尽量使用简体中文进行推理、过程说明与最终回复">
                                        <TextBlock Text="简体中文（默认）"/>
                                    </Button>
                                    <Button Command="{Binding SelectResponseLanguageCommand}"
                                            CommandParameter="English"
                                            AutomationProperties.AutomationId="AiResponseLangEnglishButton"
                                            Tag="{Binding EnglishLanguageChipTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                            Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="26" MinWidth="0" Padding="10,0" FontSize="11" Margin="0,0,8,0"
                                            ToolTip="Guide the AI to respond in concise English">
                                        <TextBlock Text="English"/>
                                    </Button>
                                    <TextBlock Text="引导 AI 思考、过程说明与结论使用所选语言" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </Grid>

                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="思考等级" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Command="{Binding SelectReasoningEffortCommand}" CommandParameter="Default" Tag="{Binding ReasoningDefaultTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="25" MinWidth="0" Padding="8,0" FontSize="10.5" Margin="0,0,5,4">
                                        <TextBlock Text="默认"/>
                                    </Button>
                                    <Button Command="{Binding SelectReasoningEffortCommand}" CommandParameter="None" Tag="{Binding ReasoningNoneTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="25" MinWidth="0" Padding="8,0" FontSize="10.5" Margin="0,0,5,4">
                                        <TextBlock Text="关闭"/>
                                    </Button>
                                    <Button Command="{Binding SelectReasoningEffortCommand}" CommandParameter="Minimal" Tag="{Binding ReasoningMinimalTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="25" MinWidth="0" Padding="8,0" FontSize="10.5" Margin="0,0,5,4">
                                        <TextBlock Text="极低"/>
                                    </Button>
                                    <Button Command="{Binding SelectReasoningEffortCommand}" CommandParameter="Low" Tag="{Binding ReasoningLowTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="25" MinWidth="0" Padding="8,0" FontSize="10.5" Margin="0,0,5,4">
                                        <TextBlock Text="低"/>
                                    </Button>
                                    <Button Command="{Binding SelectReasoningEffortCommand}" CommandParameter="Medium" Tag="{Binding ReasoningMediumTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="25" MinWidth="0" Padding="8,0" FontSize="10.5" Margin="0,0,5,4">
                                        <TextBlock Text="中"/>
                                    </Button>
                                    <Button Command="{Binding SelectReasoningEffortCommand}" CommandParameter="High" Tag="{Binding ReasoningHighTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="25" MinWidth="0" Padding="8,0" FontSize="10.5" Margin="0,0,5,4">
                                        <TextBlock Text="高"/>
                                    </Button>
                                    <Button Command="{Binding SelectReasoningEffortCommand}" CommandParameter="XHigh" Tag="{Binding ReasoningXHighTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="25" MinWidth="0" Padding="8,0" FontSize="10.5" Margin="0,0,5,4">
                                        <TextBlock Text="超高"/>
                                    </Button>
                                    <Button Command="{Binding SelectReasoningEffortCommand}" CommandParameter="Max" Tag="{Binding ReasoningMaxTag}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                            Height="25" MinWidth="0" Padding="8,0" FontSize="10.5" Margin="0,0,5,4">
                                        <TextBlock Text="极限"/>
                                    </Button>
                                </WrapPanel>
                            </Grid>

                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="上下文窗口" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBox Text="{Binding ContextWindowTokens, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="AiContextWindowInput"
                                                 ToolTip="模型上下文上限（tokens）：填 0 表示自动（优先从 API 自动获取，回退型号估算）；也可手动填写 2048 ~ 2097152"
                                                 Style="{StaticResource FluentCompactTextBoxStyle}"
                                                 Background="#F8FAFC" Width="76" Height="26" FontSize="11"
                                                 HorizontalContentAlignment="Center" Margin="0,0,6,4"/>
                                        <Button Command="{Binding ProbeContextWindowCommand}"
                                                AutomationProperties.AutomationId="AiProbeContextWindowButton"
                                                IsEnabled="{Binding IsProbingContextWindow, Converter={StaticResource InverseBoolConverter}}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Background="#EBF5FF" BorderBrush="#BFDBFE" Foreground="#0078D4"
                                                Height="26" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="0,0,6,4"
                                                ToolTip="向当前端点只读查询真实上下文上限（兼容 Halogen / LM Studio / Ollama / llama.cpp / vLLM / OpenRouter 等，不消耗对话 Token）">
                                            <TextBlock Text="从 API 自动获取"/>
                                        </Button>
                                        <Button Command="{Binding SelectContextWindowPresetCommand}" CommandParameter="Auto" Tag="{Binding ContextAutoChipTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,4">
                                            <TextBlock Text="自动"/>
                                        </Button>
                                        <Button Command="{Binding SelectContextWindowPresetCommand}" CommandParameter="32K" Tag="{Binding Context32kChipTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,4">
                                            <TextBlock Text="32K"/>
                                        </Button>
                                        <Button Command="{Binding SelectContextWindowPresetCommand}" CommandParameter="64K" Tag="{Binding Context64kChipTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,4">
                                            <TextBlock Text="64K"/>
                                        </Button>
                                        <Button Command="{Binding SelectContextWindowPresetCommand}" CommandParameter="128K" Tag="{Binding Context128kChipTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,4">
                                            <TextBlock Text="128K"/>
                                        </Button>
                                        <Button Command="{Binding SelectContextWindowPresetCommand}" CommandParameter="256K" Tag="{Binding Context256kChipTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,4">
                                            <TextBlock Text="256K"/>
                                        </Button>
                                        <Button Command="{Binding SelectContextWindowPresetCommand}" CommandParameter="1M" Tag="{Binding Context1mChipTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,0,4">
                                            <TextBlock Text="1M"/>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap">
                                        <Run Text="当前生效："/>
                                        <Run Text="{Binding ContextWindowSummaryText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#334155"/>
                                        <Run Text=" · 填 0 表示自动探测（测试连接或首次对话时也会自动尝试获取）"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="总耗时上限" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBox Text="{Binding OverallTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="AiOverallTimeoutMinutesInput"
                                                 ToolTip="单次分析整体安全兜底上限（单位：分钟，范围 2~120 分钟，默认 20 分钟）"
                                                 Style="{StaticResource FluentCompactTextBoxStyle}"
                                                 Background="#F8FAFC" Width="56" Height="26" FontSize="11"
                                                 HorizontalContentAlignment="Center" Margin="0,0,5,4"/>
                                        <TextBlock Text="分钟" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                        <Button Command="{Binding SelectOverallTimeoutPresetCommand}" CommandParameter="10" Tag="{Binding OverallTimeout10mTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,4">
                                            <TextBlock Text="10分"/>
                                        </Button>
                                        <Button Command="{Binding SelectOverallTimeoutPresetCommand}" CommandParameter="20" Tag="{Binding OverallTimeout20mTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,4">
                                            <TextBlock Text="20分(默认)"/>
                                        </Button>
                                        <Button Command="{Binding SelectOverallTimeoutPresetCommand}" CommandParameter="30" Tag="{Binding OverallTimeout30mTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,4">
                                            <TextBlock Text="30分"/>
                                        </Button>
                                        <Button Command="{Binding SelectOverallTimeoutPresetCommand}" CommandParameter="60" Tag="{Binding OverallTimeout60mTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,4">
                                            <TextBlock Text="60分"/>
                                        </Button>
                                        <Button Command="{Binding SelectOverallTimeoutPresetCommand}" CommandParameter="120" Tag="{Binding OverallTimeout120mTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Background="#F8FAFC" BorderBrush="#E2E8F0"
                                                Height="25" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,0,4">
                                            <TextBlock Text="120分"/>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock Text="单次分析整体兜底安全上限（范围 2~120 分钟，默认 20 分钟；超时将强制中止防止任务挂起）"
                                               FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 左右可拖动分隔条 -->
        <GridSplitter x:Name="DrawerGridSplitter"
                      Grid.Column="1"
                      Style="{StaticResource FluentVerticalGridSplitterStyle}"
                      AutomationProperties.AutomationId="AiPageDrawerSplitter"
                      ToolTip="左右拖动调整 AI 分析助手宽度（双击恢复默认宽度）"
                      DragCompleted="DrawerGridSplitter_OnDragCompleted"
                      MouseDoubleClick="DrawerGridSplitter_OnMouseDoubleClick"/>

        <!-- RightAiDrawer：绑定当前活动独立会话，并开启顶部三会话切换条 -->
        <views:AiAssistantDrawerControl Grid.Column="2"
                                          DataContext="{Binding ActiveStandaloneSession}"
                                          ShowCloseButton="False"
                                          ShowSessionSwitcher="True"/>
    </Grid>
</UserControl>
