<UserControl x:Class="MoveWithSymlinkWPF.Views.AiAssistantDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MoveWithSymlinkWPF.Controls"
             xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
             xmlns:vm="clr-namespace:MoveWithSymlinkWPF.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="374"
             FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <Border Background="#FFFFFF" BorderBrush="#BFDBFE" BorderThickness="1.2" CornerRadius="12" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DrawerHead：机器人图标 + 标题 + 模型来源徽章 + 字号/清空/设置/收起按钮 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 字号调整按钮 + 浮层卡片 -->
                    <Grid Margin="0,0,5,0">
                        <ToggleButton x:Name="FontSizeToggle"
                                      AutomationProperties.AutomationId="AiDrawerFontSizeButton"
                                      ToolTip="调整 AI 对话区域字体大小"
                                      Style="{StaticResource FluentTimelineToggleStyle}"
                                      Padding="0" Width="26" Height="24">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Width="26" Height="24">
                                <TextBlock Text="Aa" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=FontSizeToggle, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=FontSizeToggle}"
                               Placement="Bottom"
                               HorizontalOffset="-154"
                               VerticalOffset="4"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="11" Width="206">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0F172A" Opacity="0.12" BlurRadius="14" ShadowDepth="3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Host.ChatFontSizeLabel}" FontSize="11" FontWeight="Bold" Foreground="#0078D4"/>
                                        <TextBlock Text="对话字体大小" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"/>
                                    </DockPanel>
                                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,7">
                                        <Button Command="{Binding Host.DecreaseChatFontSizeCommand}"
                                                IsEnabled="{Binding Host.CanDecreaseChatFontSize}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Height="25" MinWidth="0" Padding="0" Margin="0,0,4,0" FontSize="11">
                                            <TextBlock Text="A-"/>
                                        </Button>
                                        <Button Command="{Binding Host.SetChatFontSizeCommand}" CommandParameter="Default"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Height="25" MinWidth="0" Padding="0" Margin="0,0,4,0" FontSize="10.5">
                                            <TextBlock Text="恢复默认"/>
                                        </Button>
                                        <Button Command="{Binding Host.IncreaseChatFontSizeCommand}"
                                                IsEnabled="{Binding Host.CanIncreaseChatFontSize}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Height="25" MinWidth="0" Padding="0" FontSize="11">
                                            <TextBlock Text="A+"/>
                                        </Button>
                                    </UniformGrid>
                                    <UniformGrid Rows="1" Columns="4">
                                        <Button Command="{Binding Host.SetChatFontSizeCommand}" CommandParameter="Small"
                                                Tag="{Binding Host.FontSmallTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Height="23" MinWidth="0" Padding="0" Margin="0,0,3,0" FontSize="10">
                                            <TextBlock Text="小"/>
                                        </Button>
                                        <Button Command="{Binding Host.SetChatFontSizeCommand}" CommandParameter="Default"
                                                Tag="{Binding Host.FontDefaultTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Height="23" MinWidth="0" Padding="0" Margin="0,0,3,0" FontSize="10">
                                            <TextBlock Text="标准"/>
                                        </Button>
                                        <Button Command="{Binding Host.SetChatFontSizeCommand}" CommandParameter="Large"
                                                Tag="{Binding Host.FontLargeTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Height="23" MinWidth="0" Padding="0" Margin="0,0,3,0" FontSize="10">
                                            <TextBlock Text="大"/>
                                        </Button>
                                        <Button Command="{Binding Host.SetChatFontSizeCommand}" CommandParameter="ExtraLarge"
                                                Tag="{Binding Host.FontExtraLargeTag}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Height="23" MinWidth="0" Padding="0" FontSize="10">
                                            <TextBlock Text="特大"/>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Command="{Binding ClearConversationCommand}"
                            AutomationProperties.AutomationId="AiDrawerClearSessionButton"
                            ToolTip="清空当前场景会话记录（不影响其他场景会话）"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBoolConverter}}"
                            Visibility="{Binding HasConversationTurns, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource FluentIconButtonStyle}"
                            Background="#F8FAFC" Width="24" Height="24" Margin="0,0,5,0">
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Width="24" Height="24">
                            <Path Data="{StaticResource IconTrash2}" Width="11.5" Height="11.5" Stretch="Uniform"
                                  Stroke="#64748B" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Button Command="{Binding Host.OpenAiSettingsCommand}"
                            AutomationProperties.AutomationId="AiDrawerOpenSettingsButton"
                            ToolTip="打开 BYOK / 本地模型配置"
                            Style="{StaticResource FluentIconButtonStyle}"
                            Background="#F8FAFC" Width="24" Height="24" Margin="0,0,5,0">
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Width="24" Height="24">
                            <Path Data="{StaticResource IconSettings}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="#64748B" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Button Command="{Binding Host.CloseDrawerCommand}"
                            AutomationProperties.AutomationId="AiDrawerCloseButton"
                            ToolTip="收起 AI 抽屉（会话自动保留）"
                            Style="{StaticResource FluentIconButtonStyle}"
                            Background="#F8FAFC" Width="24" Height="24"
                            Visibility="{Binding ShowCloseButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Width="24" Height="24">
                            <Path Data="{StaticResource IconPanelRightClose}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="#64748B" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBot}" Width="15" Height="15" Stretch="Uniform"
                          Stroke="#0078D4" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="AI 分析助手" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="{Binding Host.OriginBadgeBg}" BorderBrush="{Binding Host.OriginBadgeBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Host.OriginBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding Host.OriginBadgeFg}"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- 独立 AI 页专属三会话切换条（扫描页/清理页抽屉自动隐藏并锁定对应会话） -->
            <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,8"
                    Visibility="{Binding ShowSessionSwitcher, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                <UniformGrid Rows="1" Columns="3">
                    <Button Command="{Binding Host.SelectStandaloneSessionCommand}" CommandParameter="General"
                            AutomationProperties.AutomationId="AiSessionTabGeneral"
                            Tag="{Binding Host.GeneralSessionChipTag}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="25" MinWidth="0" Padding="4,0" Margin="0,0,3,0" FontSize="10.5"
                            ToolTip="综合诊断：联合各盘余量、备份/隔离区、垃圾清理与多盘扫描">
                        <TextBlock Text="{Binding Host.GeneralSession.SessionTabBadgeText}" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <Button Command="{Binding Host.SelectStandaloneSessionCommand}" CommandParameter="DiskScan"
                            AutomationProperties.AutomationId="AiSessionTabDiskScan"
                            Tag="{Binding Host.DiskScanSessionChipTag}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="25" MinWidth="0" Padding="4,0" Margin="0,0,3,0" FontSize="10.5"
                            ToolTip="无缝查看或续聊「磁盘扫描」页抽屉会话">
                        <TextBlock Text="{Binding Host.DiskScanSession.SessionTabBadgeText}" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <Button Command="{Binding Host.SelectStandaloneSessionCommand}" CommandParameter="Cleanup"
                            AutomationProperties.AutomationId="AiSessionTabCleanup"
                            Tag="{Binding Host.CleanupSessionChipTag}"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="25" MinWidth="0" Padding="4,0" FontSize="10.5"
                            ToolTip="无缝查看或续聊「垃圾清理」页抽屉会话">
                        <TextBlock Text="{Binding Host.CleanupSession.SessionTabBadgeText}" TextTrimming="CharacterEllipsis"/>
                    </Button>
                </UniformGrid>
            </Border>

            <!-- QuickPrompts：按入口场景动态定制的 3 个快捷诊断胶囊 -->
            <UniformGrid Grid.Row="2" Rows="1" Columns="3" Margin="0,0,0,9"
                         IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBoolConverter}}">
                <Button Command="{Binding RunQuickPromptCommand}" CommandParameter="{Binding QuickPrompt1Key}"
                        ToolTip="{Binding QuickPrompt1ToolTip}"
                        AutomationProperties.AutomationId="AiQuickPromptLargeDirs"
                        Style="{StaticResource FluentSoftPrimaryButtonStyle}"
                        Height="28" MinWidth="0" Padding="5,0" Margin="0,0,5,0" FontSize="10.5">
                    <TextBlock Text="{Binding QuickPrompt1Title}" TextTrimming="CharacterEllipsis"/>
                </Button>
                <Button Command="{Binding RunQuickPromptCommand}" CommandParameter="{Binding QuickPrompt2Key}"
                        ToolTip="{Binding QuickPrompt2ToolTip}"
                        AutomationProperties.AutomationId="AiQuickPromptUnknownDirs"
                        Style="{StaticResource FluentSoftPrimaryButtonStyle}"
                        Height="28" MinWidth="0" Padding="5,0" Margin="0,0,5,0" FontSize="10.5">
                    <TextBlock Text="{Binding QuickPrompt2Title}" TextTrimming="CharacterEllipsis"/>
                </Button>
                <Button Command="{Binding RunQuickPromptCommand}" CommandParameter="{Binding QuickPrompt3Key}"
                        ToolTip="{Binding QuickPrompt3ToolTip}"
                        AutomationProperties.AutomationId="AiQuickPromptMigrateVsClean"
                        Style="{StaticResource FluentSoftPrimaryButtonStyle}"
                        Height="28" MinWidth="0" Padding="5,0" FontSize="10.5">
                    <TextBlock Text="{Binding QuickPrompt3Title}" TextTrimming="CharacterEllipsis"/>
                </Button>
            </UniformGrid>

            <!-- 对话与受控工具调用流 -->
            <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ChatScrollViewer_OnScrollChanged"
                          Margin="0,0,0,8">
                <StackPanel>
                    <!-- 空态引导（随入口场景定制） -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="11"
                            Visibility="{Binding HasConversationTurns, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding EmptyStateDescription}"
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" LineHeight="17"/>
                            <TextBlock Text="• 绝不读取任何文件内容或敏感凭据&#x0a;• 绝不自动扫描磁盘、迁移、清理或删除&#x0a;• 缺少扫描数据时将弹出选盘确认卡片由你自主决定"
                                       FontSize="10.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 对话轮次列表 -->
                    <ItemsControl ItemsSource="{Binding ConversationTurns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <!-- 用户提问气泡 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,7">
                                        <TextBlock Text="{Binding UserPrompt, StringFormat=我：{0}}"
                                                   FontSize="{Binding DataContext.Host.ChatFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="#0F172A" TextWrapping="Wrap" LineHeight="19"/>
                                    </Border>

                                    <!-- 顶部轻量状态元信息条 -->
                                    <DockPanel Margin="2,0,2,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Medium" Foreground="{Binding StatusBadgeFg}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TraceHeaderText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0078D4" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- 统一自然时间线流 -->
                                    <ItemsControl ItemsSource="{Binding TimelineItems}" Margin="0,0,0,6"
                                                  Visibility="{Binding HasTimelineItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.Resources>
                                            <DataTemplate DataType="{x:Type vm:AiThinkingStepItem}">
                                                <StackPanel Margin="0,2,0,5">
                                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Style="{StaticResource FluentTimelineToggleStyle}"
                                                                  Padding="4,3"
                                                                  ToolTip="点击展开或收起此步骤的思考内容">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChevronGlyph}" FontSize="11" Foreground="#94A3B8" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                                            <TextBlock DockPanel.Dock="Left" Text="•" FontSize="12" FontWeight="Bold" Foreground="{Binding AccentForeground}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding HeaderText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding AccentForeground}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding PreviewText}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                        </DockPanel>
                                                    </ToggleButton>
                                                    <Border BorderBrush="#CBD5E1" BorderThickness="2,0,0,0" Margin="7,2,2,2" Padding="10,2,4,2"
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding Text}"
                                                                   FontSize="{Binding DataContext.Host.ChatSmallFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   Foreground="#64748B" TextWrapping="Wrap" LineHeight="17.5"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type vm:AiAssistantMessageStepItem}">
                                                <controls:SafeMarkdownViewer MarkdownText="{Binding Text}"
                                                                             BaseFontSize="{Binding DataContext.Host.ChatFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             Margin="2,2,2,6"/>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type vm:AiToolBatchStepItem}">
                                                <StackPanel Margin="0,2,0,6">
                                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Style="{StaticResource FluentTimelineToggleStyle}"
                                                                  Padding="4,3"
                                                                  ToolTip="点击收起或展开这一组工具调用">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconSliders}" Width="11" Height="11" Stretch="Uniform"
                                                                  Stroke="{Binding HeaderForeground}" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding SummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding HeaderForeground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ChevronGlyph}" FontSize="11.5" Foreground="#94A3B8" Margin="5,-1,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ToggleButton>

                                                    <Border BorderBrush="#E2E8F0" BorderThickness="2,0,0,0" Margin="8,2,0,2" Padding="7,1,0,1"
                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:AiToolCallStepItem}">
                                                                    <StackPanel Margin="0,0.5">
                                                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                                      Style="{StaticResource FluentTimelineToggleStyle}"
                                                                                      Padding="5,3"
                                                                                      ToolTip="点击展开查看工具调用参数与返回摘要">
                                                                            <DockPanel>
                                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                                    <TextBlock Text="{Binding RightMetaText}" FontSize="9.5" Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                                    <TextBlock Text="{Binding ChevronGlyph}" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusGlyph}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusColor}" Width="14" TextAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding ActionVerb}" FontSize="10.5" Foreground="#64748B" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding CompactTarget}" FontSize="10.5" FontWeight="Medium" Foreground="{Binding TitleForeground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                            </DockPanel>
                                                                        </ToggleButton>
                                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="18,2,2,4"
                                                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding DetailHeaderText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusColor}" Margin="0,0,0,4"/>
                                                                                <TextBlock FontSize="10" Foreground="#475569" TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,3">
                                                                                    <Run Text="参数：" FontWeight="SemiBold" Foreground="#64748B"/>
                                                                                    <Run Text="{Binding DisplayArguments, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="结果：" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding ResultSummary}" FontSize="10" Foreground="{Binding ResultForeground}" TextWrapping="Wrap" LineHeight="15" VerticalAlignment="Center"
                                                                                               Visibility="{Binding HasResultPayload, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                                                                    <Button Command="{Binding DataContext.Host.InspectToolResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Style="{StaticResource FluentLinkButtonStyle}"
                                                                                            Foreground="{Binding StatusColor}"
                                                                                            FontSize="10"
                                                                                            VerticalAlignment="Center"
                                                                                            ToolTip="点击弹窗查看本次工具实际返回给 AI 的完整脱敏数据"
                                                                                            Visibility="{Binding HasResultPayload, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <TextBlock TextWrapping="Wrap" LineHeight="15">
                                                                                            <Run Text="{Binding ResultSummary, Mode=OneWay}"/>
                                                                                            <Run Text=" · 点击查看明细 ↗" FontWeight="SemiBold" Foreground="#0078D4"/>
                                                                                        </TextBlock>
                                                                                    </Button>
                                                                                </WrapPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>

                                            <DataTemplate DataType="{x:Type vm:AiNoticeStepItem}">
                                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,2,0,5">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Prefix}" FontSize="10" Foreground="{Binding Foreground}" Margin="0,0,5,0" VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding Message}" FontSize="10" Foreground="{Binding Foreground}" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.Resources>
                                    </ItemsControl>

                                    <!-- 交互式扫描确认卡片（多硬盘智能勾选、>4 盘自动折叠、原地进度、扫完默认自动续跑） -->
                                    <ItemsControl ItemsSource="{Binding ScanActionCards}"
                                                  Visibility="{Binding HasScanActionCards, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AiScanActionCardItem}">
                                                <Border Background="{Binding CardBg}" BorderBrush="{Binding CardBorder}" BorderThickness="1.2"
                                                        CornerRadius="9" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <!-- 卡片头部 -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                                                            <Path Data="{StaticResource IconRadar}" Width="13" Height="13" Stretch="Uniform"
                                                                  Stroke="#0078D4" StrokeThickness="1.9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CardTitle}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <!-- 快捷选盘胶囊（固定盘 ≥ 3 块且未开始时显示） -->
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                                   Visibility="{Binding ShowQuickDrivePresets, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                   IsEnabled="{Binding ShowIdleActions}">
                                                            <TextBlock Text="快捷：" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <Button Command="{Binding SelectSystemDriveOnlyCommand}" Style="{StaticResource FluentSecondaryButtonStyle}"
                                                                    Height="21" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,0">
                                                                <TextBlock Text="仅系统盘"/>
                                                            </Button>
                                                            <Button Command="{Binding SelectTightDrivesCommand}" Style="{StaticResource FluentSecondaryButtonStyle}"
                                                                    Height="21" MinWidth="0" Padding="7,0" FontSize="10" Margin="0,0,4,0">
                                                                <TextBlock Text="紧张盘 ≥85%"/>
                                                            </Button>
                                                            <Button Command="{Binding SelectAllDrivesCommand}" Style="{StaticResource FluentSecondaryButtonStyle}"
                                                                    Height="21" MinWidth="0" Padding="7,0" FontSize="10">
                                                                <TextBlock Text="全选固定盘"/>
                                                            </Button>
                                                        </WrapPanel>

                                                        <!-- 多硬盘选择列表（1~4 盘全显，≥5 盘默认展示前 3 块，展开后限高内部滚动） -->
                                                        <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                                      Visibility="{Binding ShowDrivePicker, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                      Margin="0,0,0,4">
                                                            <ItemsControl ItemsSource="{Binding VisibleDrives}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:AiScanDriveOptionItem}">
                                                                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="7,5" Margin="0,0,0,4">
                                                                            <DockPanel>
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CapacityText}" FontSize="10" Foreground="#64748B"
                                                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                                              IsEnabled="{Binding DataContext.ShowIdleActions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"
                                                                                               VerticalAlignment="Center" Margin="0,0,5,0" TextTrimming="CharacterEllipsis"/>
                                                                                    <Border Background="{Binding PrimaryBadgeBg}" BorderBrush="{Binding PrimaryBadgeBorder}" BorderThickness="1"
                                                                                            CornerRadius="8" Padding="5,1" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                                        <TextBlock Text="{Binding PrimaryBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding PrimaryBadgeFg}"/>
                                                                                    </Border>
                                                                                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                                                                            CornerRadius="8" Padding="5,1" VerticalAlignment="Center"
                                                                                            Visibility="{Binding HasSecondaryUrgency, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <TextBlock Text="{Binding SecondaryUrgencyText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#C42B1C"/>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </DockPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>

                                                        <!-- 超过 4 块硬盘时的折叠/展开切换 -->
                                                        <Button Command="{Binding ToggleOverflowDrivesCommand}"
                                                                Style="{StaticResource FluentLinkButtonStyle}"
                                                                HorizontalAlignment="Left" FontSize="10.5" Margin="2,0,0,6"
                                                                Visibility="{Binding HasOverflowDrives, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding OverflowToggleText}"/>
                                                        </Button>

                                                        <!-- 垃圾清理规则扫描勾选项（与下方自动续聊复选框字体/字号/颜色完全统一） -->
                                                        <StackPanel Visibility="{Binding ShowCleanupOption, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    Margin="2,3,0,5">
                                                            <CheckBox IsChecked="{Binding IncludeCleanupScan, Mode=TwoWay}"
                                                                      IsEnabled="{Binding ShowIdleActions}"
                                                                      VerticalContentAlignment="Center">
                                                                <TextBlock Text="同步执行垃圾清理规则扫描（覆盖全盘已知缓存，预计数秒）"
                                                                           FontSize="{Binding DataContext.Host.ChatSmallFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           Foreground="#1E293B" TextWrapping="Wrap"/>
                                                            </CheckBox>
                                                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="7"
                                                                    Padding="6,2" Margin="20,4,0,0" HorizontalAlignment="Left"
                                                                    Visibility="{Binding HasFreshCleanupSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding FreshCleanupSummaryText}" FontSize="9.8" FontWeight="SemiBold" Foreground="#0F7B4B"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- 扫完自动续聊选项（默认勾选，与上方复选框样式完全统一） -->
                                                        <CheckBox IsChecked="{Binding AutoContinueAfterScan, Mode=TwoWay}"
                                                                  Visibility="{Binding ShowIdleActions, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  VerticalContentAlignment="Center"
                                                                  Margin="2,0,0,8">
                                                            <TextBlock Text="扫描完成后自动将结果喂给 AI 继续分析"
                                                                       FontSize="{Binding DataContext.Host.ChatSmallFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       Foreground="#1E293B" TextWrapping="Wrap"/>
                                                        </CheckBox>

                                                        <!-- 卡片自身发起的扫描进度条与状态 -->
                                                        <StackPanel Margin="0,2,0,7" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0078D4" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                                                                         IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                                                         Height="5" Style="{StaticResource FluentProgressBarStyle}"/>
                                                        </StackPanel>

                                                        <!-- 联动主界面进行中的同步扫描进度条与状态 -->
                                                        <StackPanel Margin="0,2,0,7" Visibility="{Binding ShowExternalRunningActions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ExternalScanStatusMessage}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0078D4" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                            <ProgressBar Value="{Binding ExternalScanProgressPercent}" Maximum="100"
                                                                         Height="5" Style="{StaticResource FluentProgressBarStyle}"/>
                                                        </StackPanel>

                                                        <!-- 空闲态同步提示（如主界面刚扫完或刚取消） -->
                                                        <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F7B4B" TextWrapping="Wrap" Margin="0,0,0,6"
                                                                   Visibility="{Binding ShowIdleStatusNotice, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                        <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F7B4B" TextWrapping="Wrap" Margin="0,0,0,6"
                                                                   Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="7,5" Margin="0,0,0,6"
                                                                Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="10" Foreground="#C42B1C" TextWrapping="Wrap"/>
                                                        </Border>

                                                        <!-- 底部操作按钮 -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Command="{Binding DataContext.StartScanCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding CanStartScan}"
                                                                    Style="{StaticResource FluentPrimaryButtonStyle}"
                                                                    Height="27" Padding="11,0" FontSize="10.5"
                                                                    Visibility="{Binding ShowIdleActions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding StartScanButtonText}"/>
                                                            </Button>

                                                            <Button Command="{Binding DataContext.CancelScanCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FluentDangerButtonStyle}"
                                                                    Height="27" Padding="11,0" FontSize="10.5"
                                                                    Visibility="{Binding ShowRunningActions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="停止扫描"/>
                                                            </Button>

                                                            <Button Command="{Binding DataContext.CancelScanCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FluentDangerButtonStyle}"
                                                                    Height="27" Padding="11,0" FontSize="10.5"
                                                                    Visibility="{Binding ShowExternalRunningActions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="停止扫描"/>
                                                            </Button>

                                                            <Button Command="{Binding DataContext.ContinueAfterScanCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding DataContext.CanSendPrompt, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                                                    Height="26" Padding="10,0" FontSize="10.5"
                                                                    Visibility="{Binding ShowCompletedActions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="基于新快照再次分析 →"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 错误或停止提示 -->
                                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,0,7"
                                            Visibility="{Binding HasErrorText, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="#C42B1C" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- 统一聚合建议摘要卡（替代逐条平铺长列表，点击弹窗统一审阅与批量勾选添加） -->
                                    <Border Background="#F8FAFC" BorderBrush="#BFDBFE" BorderThickness="1.2"
                                            CornerRadius="9" Padding="10,9" Margin="0,2,0,8"
                                            AutomationProperties.AutomationId="AiTurnProposalSummaryCard"
                                            Visibility="{Binding HasProposalCards, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- 顶部汇总标题 -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,3">
                                                <Path Data="{StaticResource IconListChecks}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="#0078D4" StrokeThickness="1.9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ProposalSummaryHeadline}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding ProposalSummaryProgressText}" FontSize="10" Foreground="#64748B"
                                                       TextWrapping="Wrap" Margin="0,0,0,6"/>

                                            <!-- 分类构成胶囊 -->
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="6,1.5" Margin="0,0,5,4"
                                                        Visibility="{Binding HasMigrationProposals, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding MigrationBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#0F7B4B"/>
                                                </Border>
                                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="6,1.5" Margin="0,0,5,4"
                                                        Visibility="{Binding HasCleanupResidualProposals, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding CleanupResidualBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#B45309"/>
                                                </Border>
                                                <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="6,1.5" Margin="0,0,5,4"
                                                        Visibility="{Binding HasCleanupRuleProposals, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding CleanupRuleBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#0078D4"/>
                                                </Border>
                                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="6,1.5" Margin="0,0,5,4"
                                                        Visibility="{Binding HasNativeGuideProposals, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding NativeGuideBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#B45309"/>
                                                </Border>
                                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="6,1.5" Margin="0,0,5,4"
                                                        Visibility="{Binding HasBlockedProposals, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding BlockedBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#C42B1C"/>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Top 3 单行精简预览 -->
                                            <ItemsControl ItemsSource="{Binding ProposalPreviewItems}" Margin="0,0,0,2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:AiProposalCardItem}">
                                                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                                                                CornerRadius="6" Padding="7,4.5" Margin="0,0,0,4">
                                                            <DockPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding SizeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding CardAccentFg}"
                                                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                    <Border Background="{Binding CompactStatusBg}" BorderBrush="{Binding CompactStatusBorder}" BorderThickness="1"
                                                                            CornerRadius="7" Padding="5,1" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding CompactStatusText}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding CompactStatusFg}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <DockPanel VerticalAlignment="Center">
                                                                    <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding CardAccentFg}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#1E293B"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SanitizedPath}" VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding HiddenProposalPreviewText}" FontSize="9.8" Foreground="#64748B"
                                                       Margin="2,0,0,6"
                                                       Visibility="{Binding HasHiddenProposalPreview, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <!-- 底部统一弹窗入口 + 已入池疑似残留快捷跳转 -->
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                                <Button Command="{Binding DataContext.Host.OpenTurnProposalsReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="AiOpenProposalReviewModalButton"
                                                        Style="{StaticResource FluentPrimaryButtonStyle}"
                                                        Height="28" Padding="11,0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ReviewModalButtonText}"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.Host.OpenCleanupResidualReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource FluentLinkButtonStyle}"
                                                        Foreground="#B45309" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                        Visibility="{Binding ShowJumpToCleanupResidualQuickLink, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="→ 去「AI 疑似残留」复核"/>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部：接近耗时上限时的延长限时询问提示 + 强制免责声明 -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1.2"
                        CornerRadius="8" Padding="10,8" Margin="0,0,0,7"
                        AutomationProperties.AutomationId="AiTimeoutExtensionBanner"
                        Visibility="{Binding ShowTimeoutExtensionPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Border Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TimeoutCountdownBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                                <Button Command="{Binding DismissTimeoutExtensionPromptCommand}"
                                        Style="{StaticResource FluentIconButtonStyle}"
                                        Width="20" Height="20" ToolTip="暂不延长，按原限时自动收敛或中止">
                                    <Path Data="{StaticResource IconX}" Width="9.5" Height="9.5" Stretch="Uniform" Stroke="#B45309" StrokeThickness="2"/>
                                </Button>
                            </StackPanel>
                            <DockPanel VerticalAlignment="Center">
                                <Path DockPanel.Dock="Left" Data="{StaticResource IconClock}" Width="12.5" Height="12.5" Stretch="Uniform"
                                      Stroke="#B45309" StrokeThickness="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="分析即将达到限时，是否延长？" FontSize="11" FontWeight="Bold" Foreground="#92400E"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DockPanel>

                        <TextBlock Text="{Binding TimeoutPromptDescription}" FontSize="10" Foreground="#78350F"
                                   TextWrapping="Wrap" LineHeight="15" Margin="0,0,0,7"/>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ExtendAnalysisTimeoutCommand}" CommandParameter="10"
                                    AutomationProperties.AutomationId="AiExtendTimeout10mButton"
                                    Style="{StaticResource FluentAmberPrimaryButtonStyle}"
                                    Height="25" MinWidth="0" Padding="9,0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,5,0">
                                <TextBlock Text="+10 分钟"/>
                            </Button>
                            <Button Command="{Binding ExtendAnalysisTimeoutCommand}" CommandParameter="20"
                                    AutomationProperties.AutomationId="AiExtendTimeout20mButton"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Background="#FFFFFF" BorderBrush="#FCD34D" Foreground="#B45309"
                                    Height="25" MinWidth="0" Padding="9,0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,5,0">
                                <TextBlock Text="+20 分钟"/>
                            </Button>
                            <Button Command="{Binding ExtendAnalysisTimeoutCommand}" CommandParameter="30"
                                    AutomationProperties.AutomationId="AiExtendTimeout30mButton"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Background="#FFFFFF" BorderBrush="#FCD34D" Foreground="#B45309"
                                    Height="25" MinWidth="0" Padding="9,0" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,6,0">
                                <TextBlock Text="+30 分钟"/>
                            </Button>
                            <Button Command="{Binding DismissTimeoutExtensionPromptCommand}"
                                    Style="{StaticResource FluentLinkButtonStyle}"
                                    Foreground="#92400E" FontSize="10" VerticalAlignment="Center">
                                <TextBlock Text="暂不延长"/>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 本会话吸底建议汇总条（无论长回复滚到哪里，随时可一键打开统一审阅弹框） -->
                <Border Background="#EBF5FF" BorderBrush="#93C5FD" BorderThickness="1.2"
                        CornerRadius="8" Padding="9,6.5" Margin="0,0,0,7"
                        AutomationProperties.AutomationId="AiSessionProposalStickyBar"
                        Visibility="{Binding HasSessionProposalCards, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding OpenSessionProposalsReviewCommand}"
                                AutomationProperties.AutomationId="AiStickyOpenProposalReviewButton"
                                Style="{StaticResource FluentPrimaryButtonStyle}"
                                Height="25" MinWidth="0" Padding="10,0" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SessionProposalStickyButtonText}"/>
                        </Button>
                        <DockPanel VerticalAlignment="Center">
                            <Path DockPanel.Dock="Left" Data="{StaticResource IconListChecks}" Width="13" Height="13" Stretch="Uniform"
                                  Stroke="#0078D4" StrokeThickness="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SessionProposalStickySummaryText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#0F172A"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <!-- DrawerDisclaimer：底部强制免责声明 -->
                <Border Background="#F8FAFC" CornerRadius="6" Padding="8,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconInfo}" Width="11" Height="11" Stretch="Uniform"
                              Stroke="#64748B" StrokeThickness="1.8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisclaimerText}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ChatInputRow：输入框（右端内嵌上下文占用圆环 + 展开统计浮层卡）+ 发送/停止按钮 -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="7"
                        Height="34"
                        Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding UserPromptInput, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding InputPlaceholder}"
                                 AutomationProperties.AutomationId="AiDrawerPromptInput"
                                 Style="{StaticResource FluentCompactTextBoxStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="32"
                                 FontSize="{Binding Host.ChatFontSize}"
                                 KeyDown="PromptInput_OnKeyDown"/>

                        <!-- 内嵌思考等级快捷切换器（Fluent 亮色融冰能量滑块，顶部自动默认胶囊 + 7 档单调滑轨） -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="2,0,2,0">
                            <ToggleButton x:Name="ReasoningEffortToggle"
                                          AutomationProperties.AutomationId="AiReasoningEffortButton"
                                          ToolTip="{Binding Host.ReasoningEffortToolTip}"
                                          Style="{StaticResource FluentTimelineToggleStyle}"
                                          Padding="0" Height="22">
                                <Border Background="{Binding Host.ReasoningEffortPillBg}"
                                        BorderBrush="{Binding Host.ReasoningEffortPillBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6.5,1.5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="5.5" Height="5.5"
                                                 Fill="{Binding Host.ReasoningEffortPillDot}"
                                                 Margin="0,0,4.5,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Host.ReasoningEffortPillText}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Host.ReasoningEffortPillFg}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </ToggleButton>

                            <Popup x:Name="ReasoningEffortPopup"
                                   IsOpen="{Binding IsChecked, ElementName=ReasoningEffortToggle, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=ReasoningEffortToggle}"
                                   Placement="Top"
                                   HorizontalOffset="-220"
                                   VerticalOffset="2"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <controls:ReasoningEffortSlider
                                    SelectedEffort="{Binding Host.ReasoningEffort, Mode=OneWay}"
                                    SelectEffortCommand="{Binding Host.SelectReasoningEffortCommand}"
                                    IsActive="{Binding IsOpen, ElementName=ReasoningEffortPopup}"
                                    CloseRequested="ReasoningEffortSlider_OnCloseRequested"/>
                            </Popup>
                        </Grid>

                        <!-- 内嵌上下文占用圆环（点击向上展开 AI 调用统计卡片） -->
                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="2,0,6,0">
                            <ToggleButton x:Name="ContextStatsToggle"
                                          AutomationProperties.AutomationId="AiContextStatsRingButton"
                                          ToolTip="{Binding ContextRingToolTip}"
                                          Style="{StaticResource FluentTimelineToggleStyle}"
                                          Padding="2" Width="22" Height="22">
                                <Canvas Width="18" Height="18">
                                    <!-- 底圆轨道 -->
                                    <Ellipse Width="13.6" Height="13.6" Canvas.Left="2.2" Canvas.Top="2.2"
                                             Stroke="#E2E8F0" StrokeThickness="2" Fill="Transparent"/>
                                    <!-- 动态占比圆弧 -->
                                    <Path Data="{Binding ContextRingArcGeometry}"
                                          Stroke="{Binding ContextRingStrokeColor}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Canvas>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsChecked, ElementName=ContextStatsToggle, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=ContextStatsToggle}"
                                   Placement="Top"
                                   HorizontalOffset="-248"
                                   VerticalOffset="-6"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="12" Width="278">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#0F172A" Opacity="0.13" BlurRadius="16" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,7">
                                            <Border DockPanel.Dock="Right" Background="{Binding UsageSourceBadgeBg}" CornerRadius="8" Padding="6,1.5">
                                                <TextBlock Text="{Binding UsageSourceBadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding UsageSourceBadgeFg}"/>
                                            </Border>
                                            <TextBlock Text="AI 上下文与调用统计" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- 上下文占用进度条 -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ContextUsagePercentText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding ContextRingStrokeColor}"/>
                                            <TextBlock Text="{Binding ContextUsageSummaryText}" FontSize="10.5" Foreground="#334155"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding ContextUsagePercent, Mode=OneWay}" Maximum="100" Height="5"
                                                     Foreground="{Binding ContextRingStrokeColor}"
                                                     Style="{StaticResource FluentProgressBarStyle}"
                                                     Margin="0,0,0,9"/>

                                        <!-- 生成速度 / 首字延迟 / 耗时 3 列指标 -->
                                        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,8">
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,5" Margin="0,0,4,0"
                                                    ToolTip="{Binding SpeedCardToolTip}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SpeedCardLabel}" FontSize="9.5" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding LastSpeedText}" FontSize="10.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,5" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="首字延迟" FontSize="9.5" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding FirstTokenLatencyText}" FontSize="10.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,5">
                                                <StackPanel>
                                                    <TextBlock Text="最近耗时" FontSize="9.5" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding LastDurationText}" FontSize="10.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- 本会话累计与模型摘要 -->
                                        <TextBlock Text="{Binding SessionCumulativeSummaryText}" FontSize="10" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="9.5" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,0,0,8">
                                            <Run Text="当前模型："/>
                                            <Run Text="{Binding Host.ModelName, Mode=OneWay}"/>
                                            <Run Text="（"/>
                                            <Run Text="{Binding Host.OriginBadgeText, Mode=OneWay}"/>
                                            <Run Text="）"/>
                                        </TextBlock>

                                        <!-- 上下文上限快捷切换 + API 自动探测 -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,5">
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{Binding Host.ProbeContextWindowCommand}"
                                                            IsEnabled="{Binding Host.IsProbingContextWindow, Converter={StaticResource InverseBoolConverter}}"
                                                            Style="{StaticResource FluentLinkButtonStyle}"
                                                            Foreground="#0078D4" FontSize="9.5" FontWeight="SemiBold"
                                                            ToolTip="从当前端点只读自动获取真实上下文窗口大小">
                                                        <TextBlock Text="API 自动获取"/>
                                                    </Button>
                                                    <TextBlock FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="上限来源："/>
                                                        <Run Text="{Binding ContextWindowSourceText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#334155"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <UniformGrid Rows="1" Columns="5">
                                                    <Button Command="{Binding Host.SelectContextWindowPresetCommand}" CommandParameter="Auto"
                                                            Tag="{Binding Host.ContextAutoChipTag}"
                                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                                            Height="21" MinWidth="0" Padding="1,0" Margin="0,0,3,0" FontSize="9.5">
                                                        <TextBlock Text="自动"/>
                                                    </Button>
                                                    <Button Command="{Binding Host.SelectContextWindowPresetCommand}" CommandParameter="32K"
                                                            Tag="{Binding Host.Context32kChipTag}"
                                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                                            Height="21" MinWidth="0" Padding="1,0" Margin="0,0,3,0" FontSize="9.5">
                                                        <TextBlock Text="32K"/>
                                                    </Button>
                                                    <Button Command="{Binding Host.SelectContextWindowPresetCommand}" CommandParameter="64K"
                                                            Tag="{Binding Host.Context64kChipTag}"
                                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                                            Height="21" MinWidth="0" Padding="1,0" Margin="0,0,3,0" FontSize="9.5">
                                                        <TextBlock Text="64K"/>
                                                    </Button>
                                                    <Button Command="{Binding Host.SelectContextWindowPresetCommand}" CommandParameter="128K"
                                                            Tag="{Binding Host.Context128kChipTag}"
                                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                                            Height="21" MinWidth="0" Padding="1,0" Margin="0,0,3,0" FontSize="9.5">
                                                        <TextBlock Text="128K"/>
                                                    </Button>
                                                    <Button Command="{Binding Host.SelectContextWindowPresetCommand}" CommandParameter="256K"
                                                            Tag="{Binding Host.Context256kChipTag}"
                                                            Style="{StaticResource FluentSecondaryButtonStyle}"
                                                            Height="21" MinWidth="0" Padding="1,0" FontSize="9.5">
                                                        <TextBlock Text="256K"/>
                                                    </Button>
                                                </UniformGrid>
                                                <TextBlock Text="{Binding Host.ContextProbeStatusMessage}"
                                                           FontSize="9" Foreground="#475569" TextWrapping="Wrap" Margin="0,5,0,0"
                                                           Visibility="{Binding Host.HasContextProbeStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border>

                <Button Grid.Column="1"
                        Command="{Binding SendPromptCommand}"
                        AutomationProperties.AutomationId="AiDrawerSendButton"
                        Style="{StaticResource FluentPrimaryButtonStyle}"
                        Height="34" MinWidth="58" Padding="12,0" FontSize="11.5"
                        Visibility="{Binding IsAnalyzing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="发送"/>
                </Button>

                <Button Grid.Column="1"
                        Command="{Binding StopAnalysisCommand}"
                        AutomationProperties.AutomationId="AiDrawerStopButton"
                        Style="{StaticResource FluentDangerButtonStyle}"
                        Height="34" MinWidth="58" Padding="12,0" FontSize="11.5"
                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="停止"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
