<Window x:Class="MoveWithSymlinkWPF.Views.BackupConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" AutomationProperties.AutomationId="{Binding DialogId}"
        Width="680" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI" FocusManager.FocusedElement="{Binding ElementName=CancelButton}">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding ModeText}" TextWrapping="Wrap" Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding VerificationText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="只处理此原始备份；不删除当前源或目标数据。取消会保留实体与已记录的确认。" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding BackupPathLabel}" FontWeight="SemiBold"/>
        <TextBox Text="{Binding BackupPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="Auto" MinHeight="38" BorderThickness="0" Margin="0,4,0,12"
                 AutomationProperties.AutomationId="FrozenBackupPath"/>
        <TextBlock Text="{Binding SourcePathLabel}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SourcePath}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <TextBlock Text="{Binding TargetPathLabel}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding TargetPath}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding NeedsName}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="永久删除第二次确认：请准确输入原目录名称（不含备份的随机后缀），输入框不会预填。实际处理的完整备份路径见上方。" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ExpectedName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,6"/>
            <TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30"
                     AutomationProperties.AutomationId="BackupNameInput"/>
        </StackPanel>
        <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="取消并保留备份" IsDefault="True" IsCancel="True" Command="{Binding CancelCommand}"
                    Padding="12,7" Margin="0,0,10,0" AutomationProperties.AutomationId="CancelBackupAction"/>
            <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="False" Padding="12,7"
                    AutomationProperties.AutomationId="ConfirmBackupAction"/>
        </WrapPanel>
    </StackPanel>
</Window>
