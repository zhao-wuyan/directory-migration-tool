                                        BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="98"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource FluentGreenBorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{StaticResource SafetyL1Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FluentGreenBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{StaticResource SafetyL1Desc}" FontSize="12.5" Foreground="{StaticResource FluentBodyBrush}" TextWrapping="Wrap" LineHeight="19"/>
                                    </Grid>
                                </Border>

                                <!-- L2 -->
                                <Border Background="{StaticResource FluentAmberSoftBrush}" BorderBrush="{StaticResource FluentAmberBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="98"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource FluentAmberBorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{StaticResource SafetyL2Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FluentAmberBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{StaticResource SafetyL2Desc}" FontSize="12.5" Foreground="{StaticResource FluentBodyBrush}" TextWrapping="Wrap" LineHeight="19"/>
                                    </Grid>
                                </Border>

                                <!-- L3 -->
                                <Border Background="{StaticResource FluentPrimarySoftBrush}" BorderBrush="{StaticResource FluentPrimaryBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="11,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="98"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource FluentPrimaryBorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{StaticResource SafetyL3Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FluentPrimaryBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{StaticResource SafetyL3Desc}" FontSize="12.5" Foreground="{StaticResource FluentBodyBrush}" TextWrapping="Wrap" LineHeight="19"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 全局备份中心 -->
                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource FluentAmberSoftBrush}" Margin="0,0,9,0">
                                        <Path Data="{StaticResource IconArchive}" Width="13" Height="13" Stretch="Uniform"
                                              Stroke="{StaticResource FluentAmberBrush}" StrokeThickness="1.9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{StaticResource BackupCenterTitle}" Style="{StaticResource CardTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{StaticResource BackupCenter1}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource BackupCenter2}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource BackupCenter3}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource BackupCenter4}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- ACL 与回滚 -->
                        <Border Style="{StaticResource GuideInfoCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Path Data="{StaticResource IconLock}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{StaticResource FluentPrimaryBrush}" StrokeThickness="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="{StaticResource AclAndRollbackTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource FluentPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{StaticResource AclAndRollback1}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource AclAndRollback2}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 节 7：注意事项与 FAQ ==================== -->
                    <StackPanel x:Name="Section7" Visibility="Collapsed">
                        <TextBlock Text="{StaticResource NoticesFaqTitle}" Style="{StaticResource SectionHeadingStyle}"/>
                        <TextBlock Text="{StaticResource NoticesFaqSubtitle}" Style="{StaticResource SectionSummaryStyle}"/>

                        <!-- 注意事项 -->
                        <Border Style="{StaticResource GuideWarnCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Path Data="{StaticResource IconTriangleAlert}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{StaticResource FluentAmberBrush}" StrokeThickness="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="{StaticResource PermissionWarningTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource FluentAmberBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{StaticResource PermissionWarning}" Style="{StaticResource BodyTextStyle}" FontWeight="Medium"/>
                                <TextBlock Text="{StaticResource PermissionMethod1}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource PermissionMethod2}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource PermissionMethod3}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource DiskSpaceTitle}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,7"/>
                                <TextBlock Text="{StaticResource DiskSpace1}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource DiskSpace2}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource DiskSpace3}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource FileOccupationTitle}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,7"/>
                                <TextBlock Text="{StaticResource FileOccupation1}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource FileOccupation2}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource FileOccupation3}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- 常见问题 -->
                        <TextBlock Text="{StaticResource FAQTitle}" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource FluentInkBrush}" Margin="0,6,0,9"/>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource FAQ1Q}" Style="{StaticResource FaqQuestionStyle}"/>
                                <TextBlock Text="{StaticResource FAQ1A}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource FAQ2Q}" Style="{StaticResource FaqQuestionStyle}"/>
                                <TextBlock Text="{StaticResource FAQ2A}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource FAQ3Q}" Style="{StaticResource FaqQuestionStyle}"/>
                                <TextBlock Text="{StaticResource FAQ3A}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource FAQ4Q}" Style="{StaticResource FaqQuestionStyle}"/>
                                <TextBlock Text="{StaticResource FAQ4A}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource FAQ5Q}" Style="{StaticResource FaqQuestionStyle}"/>
                                <TextBlock Text="{StaticResource FAQ5A}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource FAQ6Q}" Style="{StaticResource FaqQuestionStyle}"/>
                                <TextBlock Text="{StaticResource FAQ6A}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource FAQ7Q}" Style="{StaticResource FaqQuestionStyle}"/>
                                <TextBlock Text="{StaticResource FAQ7A}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- 关于与支持 -->
                        <Border Style="{StaticResource GuideInfoCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <Path Data="{StaticResource IconInfo}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{StaticResource FluentPrimaryBrush}" StrokeThickness="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="{StaticResource NeedHelpTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource FluentPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{StaticResource NeedHelpDescription}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource AuthorInfo}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource ProjectInfo}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource DisclaimerInfo}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 底部操作栏：与顶栏呼应的轻量白底 + 章节翻页 + 关闭 -->
        <Border Grid.Row="2"
                Background="{StaticResource FluentSurfaceBrush}"
                BorderBrush="{StaticResource FluentBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,11">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevSectionButton"
                            Click="PrevSectionButton_Click"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="32" MinWidth="78" Padding="11,0" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="UserGuidePrevButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconArrowLeft}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="上一节" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NextSectionButton"
                            Click="NextSectionButton_Click"
                            Style="{StaticResource FluentSecondaryButtonStyle}"
                            Height="32" MinWidth="78" Padding="11,0" Margin="0,0,12,0"
                            AutomationProperties.AutomationId="UserGuideNextButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="下一节" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconArrowRight}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.9" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="关闭"
                            IsCancel="True"
                            IsDefault="True"
                            Style="{StaticResource FluentPrimaryButtonStyle}"
                            Height="32" MinWidth="84" Padding="18,0"
                            Click="CloseButton_Click"
                            AutomationProperties.AutomationId="UserGuideCloseButton"/>
                </StackPanel>

                <TextBlock x:Name="FooterVersionText"
                           Text="© 2025–2026 诏无言 · 目录迁移工具"
                           Foreground="{StaticResource FluentMutedBrush}"
                           FontSize="11.5"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
