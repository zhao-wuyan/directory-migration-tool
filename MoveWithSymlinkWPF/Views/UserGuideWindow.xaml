<Window x:Class="MoveWithSymlinkWPF.Views.UserGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{StaticResource GuideWindowTitle}"
        AutomationProperties.AutomationId="UserGuideWindow"
        Icon="pack://application:,,,/目录迁移工具;component/Resources/app-icon.ico"
        Height="680" Width="980"
        MinHeight="540" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FluentCanvasBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- 左侧目录导览按钮样式（严格对齐 FluentTheme 视觉令牌，不继承 App.xaml 默认动画） -->
        <Style x:Key="GuideNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="accentBar"
                                        Width="3" Height="16"
                                        CornerRadius="1.5"
                                        Background="{StaticResource FluentPrimaryBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="navBd" Property="Background" Value="#EBF5FF"/>
                                <Setter TargetName="navBd" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter TargetName="accentBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 章节头部标题与副标题 -->
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FluentInkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="SectionSummaryStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource FluentMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 通用白色卡片 -->
        <Style x:Key="GuideCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
        </Style>

        <!-- 语义提示卡片（信息蓝 / 安全绿 / 警示琥珀 / 红线红） -->
        <Style x:Key="GuideInfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FluentPrimarySoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentPrimaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
        </Style>

        <Style x:Key="GuideSafeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FluentGreenSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentGreenBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
        </Style>

        <Style x:Key="GuideWarnCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FluentAmberSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentAmberBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
        </Style>

        <Style x:Key="GuideSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FluentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- 卡片内标题与正文排版 -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FluentInkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource FluentBodyBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="BodyTextLastStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="MonoPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FaqQuestionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource FluentInkBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏：轻量白色表面 + 1px 底边框（严格对齐 MainWindow TopNavBar） -->
        <Border Grid.Row="0"
                Background="{StaticResource FluentSurfaceBrush}"
                BorderBrush="{StaticResource FluentBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppIconDrawingImage}"
                           Width="36" Height="36"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource GuideHeaderTitle}"
                                   FontSize="16.5" FontWeight="Bold"
                                   Foreground="{StaticResource FluentInkBrush}"/>
                        <TextBlock Text="{StaticResource GuideHeaderSubtitle}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource FluentMutedBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="{StaticResource FluentGreenSoftBrush}"
                            BorderBrush="{StaticResource FluentGreenBorderBrush}"
                            BorderThickness="1" CornerRadius="11"
                            Padding="9,3.5" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconShieldCheck}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{StaticResource FluentGreenBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{StaticResource GuideSafetyPillText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource FluentGreenBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource FluentPrimarySoftBrush}"
                            BorderBrush="{StaticResource FluentPrimaryBorderBrush}"
                            BorderThickness="1" CornerRadius="11"
                            Padding="9,3.5" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionBadgeText"
                                   Text="v1.1.7"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource FluentPrimaryBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体区域：左侧目录导览 + 右侧卡片内容 -->
        <Grid Grid.Row="1" Margin="16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导览栏 -->
            <Border Grid.Column="0"
                    Background="{StaticResource FluentSurfaceBrush}"
                    BorderBrush="{StaticResource FluentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="目录导览"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource FluentMutedBrush}"
                               Margin="6,2,0,8"/>

                    <!-- 底部快捷提示 -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource FluentSubtleBrush}"
                            BorderBrush="{StaticResource FluentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="NavProgressText"
                                       Text="第 1 / 8 节"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource FluentPrimaryBrush}"/>
                            <TextBlock Text="按 Esc 键可随时关闭窗口"
                                       FontSize="11"
                                       Foreground="{StaticResource FluentMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 导航项列表 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button x:Name="NavButton0" Tag="Active" Style="{StaticResource GuideNavButtonStyle}"
                                    Click="NavButton_Click" CommandParameter="0"
                                    AutomationProperties.AutomationId="UserGuideNavOverview">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconBookOpen}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="2,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="软件概述" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavButton1" Style="{StaticResource GuideNavButtonStyle}"
                                    Click="NavButton_Click" CommandParameter="1"
                                    AutomationProperties.AutomationId="UserGuideNavManual">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconFolderInput}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="2,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="手动 / 还原 / 修复" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavButton2" Style="{StaticResource GuideNavButtonStyle}"
                                    Click="NavButton_Click" CommandParameter="2"
                                    AutomationProperties.AutomationId="UserGuideNavQuickMigrate">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconZap}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="2,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="一键迁移" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavButton3" Style="{StaticResource GuideNavButtonStyle}"
                                    Click="NavButton_Click" CommandParameter="3"
                                    AutomationProperties.AutomationId="UserGuideNavDiskScan">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRadar}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="2,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="磁盘扫描" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavButton4" Style="{StaticResource GuideNavButtonStyle}"
                                    Click="NavButton_Click" CommandParameter="4"
                                    AutomationProperties.AutomationId="UserGuideNavCleanup">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSparkles}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="2,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="安全垃圾清理" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavButton5" Style="{StaticResource GuideNavButtonStyle}"
                                    Click="NavButton_Click" CommandParameter="5"
                                    AutomationProperties.AutomationId="UserGuideNavAi">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconBot}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="2,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="AI 助手" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavButton6" Style="{StaticResource GuideNavButtonStyle}"
                                    Click="NavButton_Click" CommandParameter="6"
                                    AutomationProperties.AutomationId="UserGuideNavSafety">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconArchive}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="2,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="备份与安全机制" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavButton7" Style="{StaticResource GuideNavButtonStyle}"
                                    Click="NavButton_Click" CommandParameter="7"
                                    AutomationProperties.AutomationId="UserGuideNavFaq">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconInfo}" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="2,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="注意事项与 FAQ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 右侧滚动内容区 -->
            <ScrollViewer x:Name="ContentScrollViewer"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,6,4">
                <Grid>
                    <!-- ==================== 节 0：软件概述 ==================== -->
                    <StackPanel x:Name="Section0" Visibility="Visible">
                        <TextBlock Text="{StaticResource OverviewTitle}" Style="{StaticResource SectionHeadingStyle}"/>
                        <TextBlock Text="{StaticResource OverviewSubtitle}" Style="{StaticResource SectionSummaryStyle}"/>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource FluentPrimarySoftBrush}" Margin="0,0,9,0">
                                        <Path Data="{StaticResource IconBookOpen}" Width="13" Height="13" Stretch="Uniform"
                                              Stroke="{StaticResource FluentPrimaryBrush}" StrokeThickness="1.9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{StaticResource WhatIsThisTool}" Style="{StaticResource CardTitleStyle}"/>
                                </StackPanel>
                                <TextBlock Text="{StaticResource ToolIntroduction}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- 六大模块 2x3 网格 -->
                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource FluentPrimarySoftBrush}" Margin="0,0,9,0">
                                        <Path Data="{StaticResource IconLayers}" Width="13" Height="13" Stretch="Uniform"
                                              Stroke="{StaticResource FluentPrimaryBrush}" StrokeThickness="1.9"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{StaticResource ModulesOverviewTitle}" Style="{StaticResource CardTitleStyle}"/>
                                </StackPanel>

                                <UniformGrid Columns="2">
                                    <Border Style="{StaticResource GuideSubCardStyle}" Margin="0,0,5,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconFolderInput}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource FluentPrimaryBrush}" StrokeThickness="1.9" Margin="0,0,6,0"/>
                                                <TextBlock Text="{StaticResource ModuleManualTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource FluentInkBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{StaticResource ModuleManualDesc}" FontSize="12" Foreground="{StaticResource FluentBodyBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GuideSubCardStyle}" Margin="5,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconZap}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource FluentPrimaryBrush}" StrokeThickness="1.9" Margin="0,0,6,0"/>
                                                <TextBlock Text="{StaticResource ModuleQuickTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource FluentInkBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{StaticResource ModuleQuickDesc}" FontSize="12" Foreground="{StaticResource FluentBodyBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GuideSubCardStyle}" Margin="0,0,5,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconRadar}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource FluentGreenBrush}" StrokeThickness="1.9" Margin="0,0,6,0"/>
                                                <TextBlock Text="{StaticResource ModuleScanTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource FluentInkBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{StaticResource ModuleScanDesc}" FontSize="12" Foreground="{StaticResource FluentBodyBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GuideSubCardStyle}" Margin="5,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconSparkles}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource FluentGreenBrush}" StrokeThickness="1.9" Margin="0,0,6,0"/>
                                                <TextBlock Text="{StaticResource ModuleCleanupTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource FluentInkBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{StaticResource ModuleCleanupDesc}" FontSize="12" Foreground="{StaticResource FluentBodyBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GuideSubCardStyle}" Margin="0,0,5,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconBot}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource FluentPrimaryBrush}" StrokeThickness="1.9" Margin="0,0,6,0"/>
                                                <TextBlock Text="{StaticResource ModuleAiTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource FluentInkBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{StaticResource ModuleAiDesc}" FontSize="12" Foreground="{StaticResource FluentBodyBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource GuideSubCardStyle}" Margin="5,0,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Path Data="{StaticResource IconArchive}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="{StaticResource FluentAmberBrush}" StrokeThickness="1.9" Margin="0,0,6,0"/>
                                                <TextBlock Text="{StaticResource ModuleBackupTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource FluentInkBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{StaticResource ModuleBackupDesc}" FontSize="12" Foreground="{StaticResource FluentBodyBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideInfoCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Data="{StaticResource IconShieldCheck}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{StaticResource FluentPrimaryBrush}" StrokeThickness="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="{StaticResource CoreAdvantageTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource FluentPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{StaticResource CoreAdvantage1}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource CoreAdvantage2}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource CoreAdvantage3}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource CoreAdvantage4}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GuideCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{StaticResource UseCasesTitle}" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8"/>
                                <TextBlock Text="{StaticResource UseCase0}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource UseCase1}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource UseCase2}" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="{StaticResource UseCase3}" Style="{StaticResource BodyTextLastStyle}"/>
                            </StackPanel>
                        </Border>

