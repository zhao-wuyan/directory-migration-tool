<UserControl x:Class="MoveWithSymlinkWPF.Views.GlobalBackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="1000"
             Background="#F4F6F9"
             FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. S05Head：标题 + 刷新状态核验 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}"
                    Style="{StaticResource FluentSecondaryButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefreshCw}" Width="14" Height="14" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0"/>
                    <TextBlock Text="刷新状态核验"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="全局备份管理与迁移记录" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. SpaceBanner：琥珀色待验证备份提醒横幅（对齐 Artboard 05） -->
        <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10"
                Padding="14,10" Margin="0,0,0,10"
                Visibility="{Binding HasUnverifiedBanner, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#FFFFFF" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="11" Padding="9,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconShieldCheck}" Width="12" Height="12" Stretch="Uniform" Stroke="#B45309" StrokeThickness="1.8" Margin="0,0,5,0"/>
                        <TextBlock Text="绝不自动删除" FontSize="11.5" FontWeight="Medium" Foreground="#B45309"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#FFFFFF" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconArchive}" Width="17" Height="17" Stretch="Uniform" Stroke="#B45309" StrokeThickness="1.8"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UnverifiedBannerTitle}" FontSize="13.5" FontWeight="Bold" Foreground="#B45309"/>
                        <TextBlock Text="改名备份仍在源盘，暂未释放源盘空间；验证对应软件启动与加载正常后，点击「验证与处理备份」手动清理。"
                                   FontSize="11.5" Foreground="#334155" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. RecoveryRequired 中断事务置顶恢复区（绝不自动覆盖双副本） -->
        <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#C42B1C" BorderThickness="1" CornerRadius="10"
                Padding="12" Margin="0,0,0,10"
                AutomationProperties.AutomationId="GlobalRecoverySection"
                Visibility="{Binding HasRecoveryItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Data="{StaticResource IconTriangleAlert}" Width="15" Height="15" Stretch="Uniform" Stroke="#C42B1C" StrokeThickness="1.8" Margin="0,0,7,0"/>
                    <TextBlock Text="中断待恢复事务（RecoveryRequired）—— 系统已保全全部数据副本，绝不自动覆盖"
                               FontSize="13" FontWeight="Bold" Foreground="#C42B1C"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RecoveryItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SourcePath, StringFormat=源路径：{0}}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding TargetPath, StringFormat=目标路径：{0}}" FontSize="11.5" Foreground="#334155"/>
                                        <TextBlock Text="{Binding BackupPathDisplay, StringFormat=保留备份：{0}}" FontSize="11.5" Foreground="#B45309"/>
                                        <TextBlock Text="{Binding LastErrorDisplay}" FontSize="11" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Content="打开备份目录"
                                                Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Record.BackupPath}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Height="28" Margin="0,0,0,4"/>
                                        <Button Content="打开目标目录"
                                                Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding TargetPath}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Height="28"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 4. FilterTabs：分段胶囊筛选条 + VolumeGuid/FileId 说明 -->
        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="所有备份均通过 VolumeGuid + FileId 身份绑定，不依赖文件名猜测"
                       FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
            <Border Background="#EEF2F6" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding TabAllText}" Command="{Binding SetFilterCommand}" CommandParameter="All"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5" Tag="{Binding FilterAllTag}" Margin="0,0,2,0"/>
                    <Button Content="{Binding TabUnverifiedText}" Command="{Binding SetFilterCommand}" CommandParameter="Unverified"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5" Tag="{Binding FilterUnverifiedTag}" Margin="0,0,2,0"/>
                    <Button Content="{Binding TabVerifiedText}" Command="{Binding SetFilterCommand}" CommandParameter="VerifiedRetained"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5" Tag="{Binding FilterVerifiedTag}" Margin="0,0,2,0"/>
                    <Button Content="{Binding TabRestoreText}" Command="{Binding SetFilterCommand}" CommandParameter="RestoreBackups"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5" Tag="{Binding FilterRestoreTag}" Margin="0,0,2,0"/>
                    <Button Content="{Binding TabCleanedText}" Command="{Binding SetFilterCommand}" CommandParameter="Cleaned"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5" Tag="{Binding FilterCleanedTag}" Margin="0,0,2,0"/>
                    <Button Content="{Binding TabAbnormalText}" Command="{Binding SetFilterCommand}" CommandParameter="Abnormal"
                            Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="0" Padding="10,0" FontSize="11.5" Tag="{Binding FilterAbnormalTag}"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- 5. BackupList：卡片式持久化迁移与备份列表（对齐 Artboard 05） -->
        <ListView Grid.Row="4"
                  ItemsSource="{Binding FilteredItems}"
                  AutomationProperties.AutomationId="GlobalBackupListView"
                  BorderThickness="0"
                  Background="Transparent"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,11">
                        <StackPanel>
                            <!-- 卡片头部：标题 + 状态胶囊 + 时间 -->
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedAtDisplay}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="11" Padding="9,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding StageLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{Binding BadgeForeground}"/>
                                    </Border>
                                    <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="11" Padding="9,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding ModeLabel}" FontSize="11.5" FontWeight="Medium" Foreground="#0078D4"/>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="9,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding BackupStateLabel}" FontSize="11" Foreground="#475569"/>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="9,2">
                                        <TextBlock Text="{Binding VerificationModeLabel}" FontSize="11" Foreground="#64748B"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- 中部路径块 PBox -->
                            <Border Background="#F8FAFC" CornerRadius="7" Padding="10,7" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock FontSize="11.5" Foreground="#334155" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}">
                                        <Run Text="原路径链接："/>
                                        <Run Text="{Binding SourcePath, Mode=OneWay}" FontWeight="Medium"/>
                                        <Run Text="   →   目标："/>
                                        <Run Text="{Binding TargetPath, Mode=OneWay}" Foreground="#0078D4" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding BackupPathDisplay, StringFormat=源盘原备份：{0}}" FontSize="11.5" FontWeight="Medium"
                                               Foreground="#B45309" TextTrimming="CharacterEllipsis" ToolTip="{Binding BackupPathDisplay}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 底部操作栏 Act -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding DataContext.VerifyAndManageBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding CanOpenVerifyDialog}"
                                        Style="{StaticResource FluentPrimaryButtonStyle}" Height="30">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconShieldCheck}" Width="14" Height="14" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                        <TextBlock Text="验证与处理备份"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding SourcePath}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Height="30" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFolderOpen}" Width="13" Height="13" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                            <TextBlock Text="打开软件目录"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Record.BackupPath}"
                                            Visibility="{Binding HasLiveBackup, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Height="30" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconArchive}" Width="13" Height="13" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                            <TextBlock Text="打开原始备份"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.JumpToRestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanJumpToRestore, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Height="30" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRotateCcw}" Width="13" Height="13" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                            <TextBlock Text="还原回原盘"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="处理明细"
                                            Command="{Binding DataContext.ViewDeletionDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding HasDeletionDetails, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource FluentSecondaryButtonStyle}" Height="30"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
