<Window x:Class="MoveWithSymlinkWPF.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="524"
        MinHeight="200"
        MaxHeight="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="Button" x:Key="MessageButtonStyle">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle" BasedOn="{StaticResource MessageButtonStyle}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004578"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButtonStyle" BasedOn="{StaticResource MessageButtonStyle}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E5E7EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="12" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#111827" BlurRadius="16" Opacity="0.18" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    Padding="18,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <Grid Width="30"
                          Height="30"
                          Margin="0,0,12,0"
                          VerticalAlignment="Center">
                        <Ellipse x:Name="IconEllipse" Fill="#0078D4"/>
                        <TextBlock x:Name="IconTextBlock"
                                   Text="ℹ"
                                   FontSize="16"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                    </Grid>

                    <!-- 标题 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="15.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#111827"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 关闭按钮 -->
                    <Button Grid.Column="2"
                            Content="✕"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            Foreground="#6B7280"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 消息内容区域 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="360"
                          Margin="20,18,20,16">
                <TextBlock x:Name="MessageTextBlock"
                           Text="消息内容"
                           FontSize="13"
                           Foreground="#374151"
                           TextWrapping="Wrap"
                           LineHeight="22"/>
            </ScrollViewer>

            <!-- 按钮区域 -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="18,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="YesButton"
                            Content="是"
                            AutomationProperties.AutomationId="6"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="YesButton_Click"/>
                    <Button x:Name="OKButton"
                            Content="确定"
                            AutomationProperties.AutomationId="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OKButton_Click"/>
                    <Button x:Name="NoButton"
                            Content="否"
                            AutomationProperties.AutomationId="7"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="NoButton_Click"/>
                    <Button x:Name="CancelButton"
                            Content="取消"
                            AutomationProperties.AutomationId="2"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
