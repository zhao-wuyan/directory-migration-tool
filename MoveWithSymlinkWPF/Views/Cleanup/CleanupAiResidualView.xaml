<UserControl x:Class="MoveWithSymlinkWPF.Views.Cleanup.CleanupAiResidualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
             xmlns:vm="clr-namespace:MoveWithSymlinkWPF.ViewModels"
             xmlns:views="clr-namespace:MoveWithSymlinkWPF.Views"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>
            <!-- ========================================================================= -->
            <!-- 子视图 11：AI 疑似残留分组与免责二次确认（严格对齐 docs/untitled.pen 画板 11）  -->
            <!-- ========================================================================= -->
            <Grid Margin="18,14"
                  AutomationProperties.AutomationId="CleanupAiResidualView"
                  Visibility="{Binding IsAiResidualView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- S11Head -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleAiDrawerCommand}"
                                Style="{StaticResource FluentSoftPrimaryButtonStyle}"
                                Height="30" Padding="10,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSparkles}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="#0078D4" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                <TextBlock Text="AI 诊断" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BackToRulesViewCommand}"
                                AutomationProperties.AutomationId="AiResidualBackToRulesButton"
                                Style="{StaticResource FluentSecondaryButtonStyle}" Height="30" Padding="11,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconArrowLeft}" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="#334155" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                <TextBlock Text="返回三档规则" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="垃圾清理 · 「AI 疑似残留」分组与隔离确认" FontSize="17" FontWeight="Bold" Foreground="#0F172A"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconArchive}" Width="11" Height="11" Stretch="Uniform"
                                          Stroke="#B45309" StrokeThickness="1.9" Margin="0,0,4,0"/>
                                    <TextBlock Text="仅限通道 A 同卷隔离 · 可恢复" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="规则库外由 AI 发现的疑似残留默认折叠且不勾选；经永久排除区硬拦截后，仅允许移入同卷隔离区并须独立二次确认。"
                                   FontSize="11.5" Foreground="#64748B" Margin="0,3,8,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>

                <!-- AiDisclaimerBanner（含执行中状态反馈条） -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{StaticResource IconTriangleAlert}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="#B45309" StrokeThickness="2" Margin="0,1,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="免责声明：以下条目来自 AI 对脱敏目录结构的推测，仅供参考且不代表官方安全背书；请务必点击「打开目录核实」自行核实归属与业务影响，本工具不对 AI 误判负责。"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#B45309" TextWrapping="Wrap" LineHeight="17"/>
                        </DockPanel>
                    </Border>
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ExecutionProgressMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,0,0,5"/>
                            <ProgressBar IsIndeterminate="True" Height="5" Style="{StaticResource FluentProgressBarStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- S11Main：左候选与拦截列表（1.25*）+ 右独立免责二次确认卡片（*） -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" MinWidth="420"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*" MinWidth="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左栏 AiResidualListPanel -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AiResidualCountSummary}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Text="AI 疑似残留（需人工自判 · 默认全不勾选）" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- 空态提示 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,10"
                                            Visibility="{Binding HasAiResidualItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="暂无 AI 提交的规则外疑似残留候选" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                            <TextBlock Text="完成「磁盘扫描」后，可点击右上角「AI 诊断」让内置 AI 助手分析未知大占用目录并提交「AI 疑似残留」建议。所有候选均经永久排除区硬拦截且默认不勾选。"
                                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" LineHeight="17"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 可自判候选项列表 -->
                                    <ItemsControl ItemsSource="{Binding AiResidualCandidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding CardBg}" BorderBrush="{Binding CardBorder}" BorderThickness="1"
                                                        CornerRadius="9" Padding="11" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,5">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="12.5" FontWeight="Bold"
                                                                       Foreground="{Binding SizeFg}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          IsEnabled="{Binding CanCheck}"
                                                                          VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock Text="{Binding SanitizedPath}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ActualLocalPath}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <TextBlock Text="{Binding ReasonText}" FontSize="11" Foreground="#334155" TextWrapping="Wrap" LineHeight="16" Margin="22,0,0,6"/>

                                                        <DockPanel Margin="22,0,0,0">
                                                            <Button DockPanel.Dock="Right"
                                                                    Command="{Binding DataContext.OpenDirectoryInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding ActualLocalPath}"
                                                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                                                    Height="24" MinWidth="0" Padding="8,0" FontSize="10.5">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource IconFolderOpen}" Width="11" Height="11" Stretch="Uniform"
                                                                          Stroke="#0078D4" StrokeThickness="1.8" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="打开目录核实" FontSize="10.5" FontWeight="SemiBold" Foreground="#0078D4"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Background="#FFFFFF" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="0,0,6,0">
                                                                    <TextBlock Text="AI 疑似残留 · 需自判" FontSize="10" FontWeight="SemiBold" Foreground="#B45309"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding ChannelStatusText}" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 红色已硬拦截审计卡片（对齐画板 11 HardBlockedCard） -->
                                    <ItemsControl ItemsSource="{Binding AiHardBlockedCandidates}"
                                                  Visibility="{Binding HasAiHardBlockedItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,9">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,5">
                                                            <Border DockPanel.Dock="Right" Background="#FFFFFF" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="6,0,0,0">
                                                                <TextBlock Text="永久排除 · 不可解锁" FontSize="10" FontWeight="SemiBold" Foreground="#C42B1C"/>
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource IconShieldBan}" Width="14" Height="14" Stretch="Uniform"
                                                                      Stroke="#C42B1C" StrokeThickness="1.9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Foreground="#C42B1C"
                                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding ExclusionMessage}" FontSize="10.5" Foreground="#C42B1C" TextWrapping="Wrap" LineHeight="16"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 右栏 AiIsolateConfirmModal（对齐画板 11 琥珀边框二次确认面板） -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#B45309" BorderThickness="1.2" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ModalHead -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="可恢复 · 绝不直删" FontSize="10" FontWeight="SemiBold" Foreground="#0F7B4B"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconShieldAlert}" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="#B45309" StrokeThickness="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="二次确认 · 移入同卷隔离区" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 确认详情与强制双勾选 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- TargetScopeBox -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AiConfirmScopeHeader}" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding AiConfirmSourcePreview}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding AiConfirmTargetPreview}" FontSize="10.5" Foreground="#0078D4" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <TextBlock Text="注：移入同卷隔离区不会立即释放物理磁盘空间；确认软件运行无异常后，请前往「清理隔离区」手动二次确认释放。"
                                                       FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="15.5"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ExplicitDisclaimerBox -->
                                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="⚠ AI 建议免责须知（必读）" FontSize="11.5" FontWeight="Bold" Foreground="#C42B1C" Margin="0,0,0,4"/>
                                            <TextBlock Text="该目录不在工具已验证规则库内，完全基于 AI 推测。AI 可能误判冷门软件数据或项目依赖；请用户自行判断并承担决策责任，本工具不对 AI 建议及其引发的后果负责。"
                                                       FontSize="11" Foreground="#334155" TextWrapping="Wrap" LineHeight="16.5"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- MandatoryChecks（默认不勾选，勾选范围变化时自动重置） -->
                                    <CheckBox IsChecked="{Binding IsUserVerifiedContentChecked, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="AiResidualCheckVerifiedContent"
                                              Margin="0,0,0,9">
                                        <TextBlock Text="我已自行核实目录内容，确认不含个人文档、密钥或重要业务数据"
                                                   FontSize="11" Foreground="#0F172A" TextWrapping="Wrap" LineHeight="16"/>
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding IsUserAcknowledgedDisclaimerChecked, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="AiResidualCheckDisclaimer">
                                        <TextBlock Text="我已知晓 AI 建议仅供参考、工具不负责，且本次仅移入可恢复的同卷隔离区"
                                                   FontSize="11" Foreground="#0F172A" TextWrapping="Wrap" LineHeight="16"/>
                                    </CheckBox>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ModalFoot -->
                            <DockPanel Grid.Row="2">
                                <Button DockPanel.Dock="Left" Command="{Binding CancelAiResidualSelectionCommand}"
                                        AutomationProperties.AutomationId="AiResidualCancelButton"
                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                        BorderBrush="#0078D4" Foreground="#0078D4" FontWeight="SemiBold"
                                        Height="32" Padding="14,0">
                                    <TextBlock Text="取消（默认）" FontSize="11.5"/>
                                </Button>
                                <Button DockPanel.Dock="Right" Command="{Binding ConfirmAiResidualQuarantineCommand}"
                                        AutomationProperties.AutomationId="AiResidualConfirmQuarantineButton"
                                        IsEnabled="{Binding CanConfirmAiQuarantine}"
                                        Style="{StaticResource FluentAmberPrimaryButtonStyle}"
                                        Height="32" Padding="14,0">
                                    <TextBlock Text="{Binding AiConfirmButtonText}" FontSize="11.5" FontWeight="SemiBold"/>
                                </Button>
                                <FrameworkElement/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
</UserControl>
