<UserControl x:Class="MoveWithSymlinkWPF.Views.Cleanup.CleanupQuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
             xmlns:vm="clr-namespace:MoveWithSymlinkWPF.ViewModels"
             xmlns:views="clr-namespace:MoveWithSymlinkWPF.Views"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>
            <!-- ========================================================================= -->
            <!-- 子视图 08：清理隔离区 · 恢复与人工删除（严格对齐 docs/untitled.pen 画板 08）   -->
            <!-- ========================================================================= -->
            <Grid Margin="18,12"
                  AutomationProperties.AutomationId="CleanupQuarantineView"
                  Visibility="{Binding IsQuarantineView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- S08Head -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Command="{Binding BackToRulesViewCommand}"
                            AutomationProperties.AutomationId="QuarantineBackButton"
                            Style="{StaticResource FluentSecondaryButtonStyle}" Height="32" Padding="14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconArrowLeft}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="返回垃圾清理" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="清理隔离区管理" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="同卷隔离采用 \\?\ 长路径与短 ID 映射保存；先保留恢复机会，确认无碍后再手动永久删除以释放物理空间。"
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,12,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- QBanner（含执行中状态反馈条） -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="#FFFFFF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="9,3" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="短 ID 映射 · 防 MAX_PATH" FontSize="11.5" FontWeight="Medium" Foreground="#0078D4"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShield}" Width="18" Height="18" Stretch="Uniform"
                                      Stroke="#0078D4" StrokeThickness="1.9" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding QuarantineBannerTitle}" FontSize="13.5" FontWeight="Bold" Foreground="#0078D4"/>
                                    <TextBlock Text="无自动到期删除；迁移原始备份绝不会出现在此列表。需要腾出空间时，请逐项人工确认永久删除。"
                                               FontSize="11.5" Foreground="#334155" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,8,0,0"
                            Visibility="{Binding IsRefreshingQuarantine, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding QuarantineLoadingMessage}" FontSize="11.2" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <ProgressBar IsIndeterminate="True" Height="4" Style="{StaticResource FluentProgressBarStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5">
                                <Button DockPanel.Dock="Right" Command="{Binding CancelExecutionCommand}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}"
                                        Height="22" MinWidth="0" Padding="9,0" FontSize="10.5" Margin="8,0,0,0">
                                    <TextBlock Text="取消剩余"/>
                                </Button>
                                <TextBlock Text="{Binding ExecutionProgressMessage}" FontSize="11.5" FontWeight="SemiBold" Foreground="#0078D4"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ProgressBar IsIndeterminate="{Binding ExecutionProgressIndeterminate}"
                                         Minimum="0" Maximum="100" Value="{Binding ExecutionProgressPercent}"
                                         Height="5" Style="{StaticResource FluentProgressBarStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- QuarantineTable -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 表头 -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="85"/>
                                    <ColumnDefinition Width="240"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsThreeState="True"
                                          IsChecked="{Binding AllQuarantineSelectedState, Mode=OneWay}"
                                          IsEnabled="{Binding HasQuarantineBatches}"
                                          Click="SelectAllQuarantineCheckBox_OnClick"
                                          ToolTip="全选或取消全选所有隔离批次（用于批量永久删除）"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          AutomationProperties.AutomationId="QuarantineSelectAllCheckBox"/>
                                <TextBlock Grid.Column="1" Text="隔离项目与原路径映射" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="所在卷 / 时间" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="占用空间" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="操作（风险分层防误点）" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 批次行列表 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="当前隔离区暂无已隔离批次。在「垃圾清理」页执行文件级清理后，项目会安全移入此处并保留完整恢复机会。"
                                           FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="20,40"
                                           Visibility="{Binding ShowEmptyQuarantineHint, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <ItemsControl ItemsSource="{Binding QuarantineBatches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBg}" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="240"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"
                                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="7,1.5" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsFromAi, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="AI 疑似残留" FontSize="10.5" FontWeight="SemiBold" Foreground="#B45309"/>
                                                            </Border>
                                                            <Border Background="#FFFFFF" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="6,0,0,0"
                                                                    Visibility="{Binding HasRestoreConflict, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource IconTriangleAlert}" Width="11" Height="11" Stretch="Uniform"
                                                                          Stroke="#B45309" StrokeThickness="2" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="路径冲突" FontSize="11" FontWeight="Medium" Foreground="#B45309"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SourceSummaryText}" FontSize="11" Foreground="{Binding SourceSummaryFg}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceSummaryText}" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding VolumeAndTimeText}" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Command="{Binding DataContext.RestoreQuarantineBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"
                                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                                Height="30" Padding="11,0" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource IconRotateCcw}" Width="13" Height="13" Stretch="Uniform"
                                                                      Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding RestoreButtonText}" FontSize="12"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.PermanentlyDeleteQuarantineBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"
                                                                Style="{StaticResource FluentDangerButtonStyle}"
                                                                Height="30" Padding="11,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource IconTrash2}" Width="13" Height="13" Stretch="Uniform"
                                                                      Stroke="#C42B1C" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                                                <TextBlock Text="永久删除" FontSize="12"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ConflictNote：路径冲突保护提示 -->
                        <Border Grid.Row="2" Padding="14"
                                Visibility="{Binding HasAnyQuarantineConflict, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconTriangleAlert}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="#B45309" StrokeThickness="2" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding QuarantineConflictNote}" FontSize="12" Foreground="#334155" TextWrapping="Wrap" LineHeight="18"/>
                                </DockPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- S08Foot：批量勾选汇总 + 批量永久删除入口 -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="14,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding BatchPermanentlyDeleteQuarantineCommand}"
                                IsEnabled="{Binding CanBatchDeleteQuarantine}"
                                AutomationProperties.AutomationId="QuarantineBatchDeleteButton"
                                Style="{StaticResource FluentDangerButtonStyle}"
                                Height="30" Padding="13,0" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTrash2}" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="#C42B1C" StrokeThickness="1.8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BatchDeleteQuarantineButtonText}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding QuarantineSelectionSummaryText}"
                                   FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
</UserControl>
