<Window x:Class="MoveWithSymlinkWPF.Views.MigrationVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
        Title="迁移后的实际使用验证" Width="800" Height="608" MinWidth="640" MinHeight="480"
        Background="#F6F8FA"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
        ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000"
        AutomationProperties.AutomationId="MigrationVerificationDialog"
        Closing="Window_Closing">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style x:Key="MetricCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="InfoHintBadge" TargetType="Border">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CompactPathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailLogBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MaxHeight" Value="130"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactPrimaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#004578"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSecondaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：对象标题、状态徽章与精简提示 -->
        <StackPanel Grid.Row="0">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Foreground="#111827"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <!-- 操作类型徽章 -->
                    <Border Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="4"
                            Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center"
                            ToolTip="{Binding ModeText}">
                        <TextBlock Text="{Binding OperationBadgeText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#3730A3"/>
                    </Border>

                    <!-- 验证状态徽章 -->
                    <Border CornerRadius="4" BorderThickness="1" Padding="7,2" Margin="0,0,6,0"
                            VerticalAlignment="Center" Cursor="Help" ToolTip="{Binding RecordMetaTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF3C7"/>
                                <Setter Property="BorderBrush" Value="#FCD34D"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUserVerified}" Value="True">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsVerificationError}" Value="True">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding VerificationStatusBadge}" FontSize="11.5" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="VerificationStatus">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#92400E"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUserVerified}" Value="True">
                                            <Setter Property="Foreground" Value="#166534"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsVerificationError}" Value="True">
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- 备份状态徽章 -->
                    <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4"
                            Padding="7,2" VerticalAlignment="Center" Cursor="Help"
                            ToolTip="{Binding VerificationStatus}">
                        <TextBlock Text="{Binding BackupStatusBadge}" FontSize="11.5" Foreground="#374151"/>
                    </Border>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新" Click="Refresh_Click" IsEnabled="{Binding CanOpenPaths}"
                            Style="{StaticResource CompactSecondaryButton}"
                            ToolTip="重新读取事务记录、路径链接状态与当前目标目录统计"/>
                </StackPanel>
            </Grid>

            <!-- 精简提醒条（悬浮查看完整说明） -->
            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6"
                    Padding="10,7" Margin="0,0,0,10" Cursor="Help"
                    ToolTip="优先由您启动文件夹所属的软件，打开相关项目、资源或设置并实际使用，确认功能正常。普通文件请打开并检查实际内容。&#x0a;仅能打开目录、查看备份或看到统计数字，不能代替实际使用验证。本工具不会自动启动或退出所属软件。&#x0a;程序核对与实际使用验证是两个步骤；完整内容哈希也不能替代所属软件的实际使用验证。">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="#92400E" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap"
                               Text="请先使用所属软件或打开实际文件确认可用，再确认验证；仅查看目录或程序核对不能替代实际使用。"/>
                    <TextBlock Grid.Column="1" Text="悬停详情 ⓘ" FontSize="11.5" Foreground="#B45309"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 主体内容区：默认收起详情时无需滚动 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 1. 核心状态概览条（悬浮查看各项详情） -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 程序核对 -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0" Cursor="Help"
                                    ToolTip="{Binding VerificationSummaryTooltip}">
                            <TextBlock Text="程序核对 ⓘ" Style="{StaticResource MetricCaption}"/>
                            <TextBlock Text="{Binding ProgramCheckShortText}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProgramCheckPassed}" Value="True">
                                                <Setter Property="Foreground" Value="#166534"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#F1F5F9" Margin="0,2"/>

                        <!-- 路径状态 -->
                        <StackPanel Grid.Column="2" Margin="10,0" Cursor="Help"
                                    ToolTip="{Binding CurrentPathStatus}">
                            <TextBlock Text="路径与链接 ⓘ" Style="{StaticResource MetricCaption}"/>
                            <TextBlock Text="{Binding PathHealthShortText}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPathHealthOk}" Value="True">
                                                <Setter Property="Foreground" Value="#166534"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="3" Background="#F1F5F9" Margin="0,2"/>

                        <!-- 目标 / 已还原目录统计 -->
                        <StackPanel Grid.Column="4" Margin="10,0" Cursor="Help"
                                    ToolTip="{Binding TargetProperties}">
                            <TextBlock Text="{Binding ActiveDataMetricCaption}" Style="{StaticResource MetricCaption}"/>
                            <TextBlock Text="{Binding TargetStatsShortText}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#B45309"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTargetStatsOk}" Value="True">
                                                <Setter Property="Foreground" Value="#1F2937"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="5" Background="#F1F5F9" Margin="0,2"/>

                        <!-- 确认时间 -->
                        <StackPanel Grid.Column="6" Margin="10,0,0,0" Cursor="Help"
                                    ToolTip="{Binding RecordMetaTooltip}">
                            <TextBlock Text="用户确认 ⓘ" Style="{StaticResource MetricCaption}"/>
                            <TextBlock Text="{Binding VerifiedTimeShortText}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#92400E"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUserVerified}" Value="True">
                                                <Setter Property="Foreground" Value="#166534"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. 关键路径（单行紧凑排列） -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock Text="关键路径" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="路径文字可选中复制，悬停查看说明与完整路径" FontSize="11.5" Foreground="#9CA3AF"
                                       Margin="8,1,0,0"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 原路径 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="原路径" VerticalAlignment="Center"
                                       Foreground="#4B5563" FontSize="12.5" Cursor="Help"
                                       ToolTip="原路径：迁移后通常为符号链接；还原后为实际目录"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SourcePath, Mode=OneWay}"
                                     Style="{StaticResource CompactPathBox}" ToolTip="{Binding SourcePath}"
                                     AutomationProperties.AutomationId="VerificationSourcePath"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="打开" Command="{Binding OpenPathCommand}"
                                    CommandParameter="source" IsEnabled="{Binding CanOpenPaths}"
                                    Style="{StaticResource CompactSecondaryButton}" Margin="8,0,0,0"
                                    ToolTip="在资源管理器中打开原路径"/>

                            <!-- 目标路径 / 原目标位置 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding TargetPathLabel}" VerticalAlignment="Center"
                                       Foreground="#4B5563" FontSize="12.5" Cursor="Help"
                                       ToolTip="{Binding TargetPathTooltip}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetPath, Mode=OneWay}"
                                     Style="{StaticResource CompactPathBox}" ToolTip="{Binding TargetPath}"
                                     AutomationProperties.AutomationId="VerificationTargetPath"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="打开" Command="{Binding OpenPathCommand}"
                                    CommandParameter="target" IsEnabled="{Binding CanOpenTargetPath}"
                                    Style="{StaticResource CompactSecondaryButton}" Margin="8,0,0,0"
                                    ToolTip="{Binding TargetPathTooltip}"/>

                            <!-- 原始备份 / 还原备份 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding BackupPathLabel}" VerticalAlignment="Center"
                                       Foreground="#4B5563" FontSize="12.5" Cursor="Help"
                                       ToolTip="{Binding BackupPathTooltip}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding BackupPath, Mode=OneWay}"
                                     Style="{StaticResource CompactPathBox}" ToolTip="{Binding BackupPath}"
                                     AutomationProperties.AutomationId="VerificationBackupPath"/>
                            <Button Grid.Row="4" Grid.Column="2" Content="打开" Command="{Binding OpenPathCommand}"
                                    CommandParameter="backup" IsEnabled="{Binding CanOpenBackupPath}"
                                    Style="{StaticResource CompactSecondaryButton}" Margin="8,0,0,0"
                                    ToolTip="{Binding BackupPathTooltip}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. 核心操作区：步骤 1 验证确认 + 步骤 2 备份处理 -->
                <Border Style="{StaticResource CardBorder}" Padding="12,10">
                    <StackPanel>
                        <!-- 步骤 1：确认实际使用验证 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="1. 确认实际使用验证" Style="{StaticResource SectionLabel}"/>
                                    <Border Style="{StaticResource InfoHintBadge}" Margin="6,0,0,0"
                                            ToolTip="确认成功后将记录时间，不能重复确认；确认本身不会删除备份。">
                                        <TextBlock Text="?" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <CheckBox Content="我已使用所属软件或打开实际文件验证，确认迁移后可正常使用"
                                          IsChecked="{Binding Acknowledged}" IsEnabled="{Binding CanAcknowledge}"
                                          VerticalContentAlignment="Center" FontSize="12.5" Foreground="#1F2937"
                                          AutomationProperties.AutomationId="VerificationAcknowledgement">
                                    <CheckBox.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </CheckBox.Resources>
                                </CheckBox>
                            </StackPanel>

                            <Button Grid.Column="1" Content="确认已验证" Command="{Binding ConfirmVerificationCommand}"
                                    Style="{StaticResource CompactPrimaryButton}" Width="142" VerticalAlignment="Center"
                                    ToolTip="记录实际使用验证时间，不删除备份"
                                    AutomationProperties.AutomationId="ConfirmMigrationVerification"/>
                        </Grid>

                        <Border Height="1" Background="#F1F5F9" Margin="0,10"/>

                        <!-- 步骤 2：备份处理 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="2. 原始备份处理" Style="{StaticResource SectionLabel}"/>
                                <Border Style="{StaticResource InfoHintBadge}" Margin="6,0,0,0"
                                        ToolTip="保留备份最稳妥。只有已确认实际使用验证，才可申请处理原始备份；点击后仍需两次独立确认。回收失败会保留备份，不会自动永久删除。">
                                    <TextBlock Text="?" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <ComboBox Grid.Column="1" SelectedIndex="{Binding BackupModeIndex}"
                                      IsEnabled="{Binding CanOpenPaths}"
                                      Height="30" MaxWidth="260" HorizontalAlignment="Left" MinWidth="210"
                                      VerticalContentAlignment="Center" FontSize="12.5"
                                      AutomationProperties.AutomationId="VerificationBackupMode">
                                <ComboBoxItem Content="保留备份（推荐，不处理）"/>
                                <ComboBoxItem Content="移入回收站（双确认）"/>
                                <ComboBoxItem Content="永久删除（双确认）"/>
                            </ComboBox>

                            <Button Grid.Column="2" Content="处理备份（双确认）" Click="ManageBackup_Click"
                                    IsEnabled="{Binding CanManageBackup}"
                                    Style="{StaticResource CompactPrimaryButton}" Width="142" VerticalAlignment="Center" Margin="12,0,0,0"
                                    ToolTip="验证通过后进入独立双确认窗口；未选择回收或永久删除时不可点击"
                                    AutomationProperties.AutomationId="ManageVerifiedBackup"/>
                        </Grid>

                        <!-- 仅在有实际处理反馈/取消记录时展示一行摘要，悬停或展开详情看完整逐项日志 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5"
                                Padding="8,5" Margin="0,8,0,0" Cursor="Help"
                                ToolTip="{Binding DeletionResultText}"
                                Visibility="{Binding HasDeletionFeedback, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding DeletionFeedbackShortText}" FontSize="12" Foreground="#475569"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. 可展开的详细信息（默认收起） -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <Expander IsExpanded="False" Foreground="#4B5563" FontSize="12.5">
                        <Expander.Header>
                            <TextBlock Text="查看详细信息（事务编号、链接检查、目标属性与处理明细）"
                                       FontSize="12.5" FontWeight="Medium" Foreground="#4B5563"/>
                        </Expander.Header>
                        <Grid Margin="4,10,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="事务与核对记录" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ModeText}" FontSize="12" Foreground="#374151" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding VerificationStatus}" FontSize="12" Foreground="#374151" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding RecordTimes}" FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding VerificationSummaryText}" FontSize="12" Foreground="#374151" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="备份处理明细" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DeletionResultText, Mode=OneWay}" Style="{StaticResource DetailLogBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="路径与链接实时状态" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentPathStatus}" FontSize="12" Foreground="#374151" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding ActiveDataDetailTitle}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TargetProperties}" FontSize="12" Foreground="#374151" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部栏 -->
        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ErrorText}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,4"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="后台读取或处理备份期间不可关闭；未验证关闭时将询问确认，选择继续会保留备份。"
                               FontSize="11.5" Foreground="#6B7280" TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,5,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="完成 / 关闭" Click="Close_Click" VerticalAlignment="Center"
                        IsEnabled="{Binding CanOpenPaths}" Style="{StaticResource CompactPrimaryButton}" MinWidth="96"
                        AutomationProperties.AutomationId="CloseMigrationVerification"/>
            </Grid>
        </Border>
    </Grid>
</Window>
