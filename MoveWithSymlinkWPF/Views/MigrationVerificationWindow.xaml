<Window x:Class="MoveWithSymlinkWPF.Views.MigrationVerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="迁移后的实际使用验证" Width="860" Height="760" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        AutomationProperties.AutomationId="MigrationVerificationDialog"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,7"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="请先使用所属软件验证迁移结果" FontSize="22" FontWeight="SemiBold"/>
            <Border Background="#FFF4D6" BorderBrush="#C28A00" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                <TextBlock FontWeight="SemiBold" Foreground="#744800"
                           Text="优先由您启动文件夹所属的软件，打开相关项目、资源或设置并实际使用，确认功能正常。普通文件请打开并检查实际内容。仅能打开目录、查看备份或看到统计数字，不能代替实际使用验证。本工具不会自动启动或退出所属软件。"/>
            </Border>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <GroupBox Header="验证对象与核对结果">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ModeText}"/>
                        <TextBlock Text="{Binding VerificationStatus}" FontWeight="SemiBold" AutomationProperties.AutomationId="VerificationStatus"/>
                        <TextBlock Text="{Binding RecordTimes}"/>
                        <TextBlock Text="{Binding VerificationSummaryText}"/>
                        <TextBlock Text="程序核对与实际使用验证是两个步骤；完整内容哈希也不能替代所属软件的实际使用验证。" Foreground="#944000"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="路径与当前实际状态（路径文字可选择复制）">
                    <StackPanel>
                        <TextBlock Text="原路径（迁移后通常为链接；还原后为实际目录）" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SourcePath, Mode=OneWay}" Style="{StaticResource PathBox}" AutomationProperties.AutomationId="VerificationSourcePath"/>
                        <Button Content="打开原路径" Command="{Binding OpenPathCommand}" CommandParameter="source" IsEnabled="{Binding CanOpenPaths}" HorizontalAlignment="Left"/>
                        <TextBlock Text="目标路径" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TargetPath, Mode=OneWay}" Style="{StaticResource PathBox}" AutomationProperties.AutomationId="VerificationTargetPath"/>
                        <Button Content="打开目标目录" Command="{Binding OpenPathCommand}" CommandParameter="target" IsEnabled="{Binding CanOpenPaths}" HorizontalAlignment="Left"/>
                        <TextBlock Text="原始备份路径（查看它不代表迁移已验证）" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding BackupPath, Mode=OneWay}" Style="{StaticResource PathBox}" AutomationProperties.AutomationId="VerificationBackupPath"/>
                        <Button Content="打开原始备份" Command="{Binding OpenPathCommand}" CommandParameter="backup" IsEnabled="{Binding CanOpenPaths}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding CurrentPathStatus}" Margin="0,12,0,6"/>
                        <Button Content="重新读取记录、路径与当前目标属性" Click="Refresh_Click" IsEnabled="{Binding CanOpenPaths}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="当前目标目录属性与统计（非已保存核对）">
                    <TextBlock Text="{Binding TargetProperties}"/>
                </GroupBox>
                <GroupBox Header="确认实际使用验证">
                    <StackPanel>
                        <CheckBox Content="我已使用所属软件或打开实际文件验证，确认迁移后可正常使用"
                                  IsChecked="{Binding Acknowledged}" IsEnabled="{Binding CanAcknowledge}"
                                  AutomationProperties.AutomationId="VerificationAcknowledgement">
                            <CheckBox.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></CheckBox.Resources>
                        </CheckBox>
                        <Button Content="确认已完成实际使用验证" Command="{Binding ConfirmVerificationCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                AutomationProperties.AutomationId="ConfirmMigrationVerification"/>
                        <TextBlock Text="确认成功后将记录时间，不能重复确认；确认本身不会删除备份。"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="验证后再决定备份处理方式">
                    <StackPanel>
                        <TextBlock Text="保留备份最稳妥。只有已确认实际使用验证，才可申请处理原始备份；仍需两次独立确认。回收失败会保留备份，不会自动永久删除。"/>
                        <ComboBox SelectedIndex="{Binding BackupModeIndex}" IsEnabled="{Binding CanOpenPaths}" AutomationProperties.AutomationId="VerificationBackupMode" Margin="0,4,0,8">
                            <ComboBoxItem Content="保留备份（推荐，不处理）"/>
                            <ComboBoxItem Content="移入回收站（双确认）"/>
                            <ComboBoxItem Content="永久删除（双确认）"/>
                        </ComboBox>
                        <Button Content="处理已验证的原始备份（进入双确认）" Click="ManageBackup_Click" IsEnabled="{Binding CanManageBackup}" HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="ManageVerifiedBackup"/>
                        <TextBox Text="{Binding DeletionResultText, Mode=OneWay}" Style="{StaticResource PathBox}" MaxHeight="220"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding ErrorText}" Foreground="#B91C1C"/>
                    <TextBlock Text="后台读取、验证或处理备份期间不可关闭；未验证关闭时会询问，选择继续将保留备份。" FontSize="12"/>
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3"/>
                </StackPanel>
                <Button Grid.Column="1" Content="完成 / 关闭" Click="Close_Click" VerticalAlignment="Center" IsEnabled="{Binding CanOpenPaths}"
                        AutomationProperties.AutomationId="CloseMigrationVerification"/>
            </Grid>
        </Border>
    </Grid>
</Window>
