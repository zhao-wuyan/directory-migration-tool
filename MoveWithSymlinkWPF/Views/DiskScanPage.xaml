<UserControl x:Class="MoveWithSymlinkWPF.Views.DiskScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MoveWithSymlinkWPF.Converters"
             xmlns:views="clr-namespace:MoveWithSymlinkWPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="1000"
             Background="#F4F6F9"
             FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- ========================================================================= -->
        <!-- 阶段 00：选盘入口与扫描态（严格对齐 docs/untitled.pen Artboard 00）          -->
        <!-- ========================================================================= -->
        <Grid Margin="18,12" Visibility="{Binding IsVolumeSelectView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="磁盘空间扫描与大目录迁移" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="用于找出空间不足磁盘（如 C 盘）中占空间的大目录，通过符号链接安全迁移到空间充足的磁盘以释放空间（只读 MFT 高速扫描，不改原数据）。"
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,12,0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding LoadVolumesCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource FluentSecondaryButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefreshCw}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="#0F172A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,6,0"/>
                        <TextBlock Text="刷新磁盘列表"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 磁盘卡片组（横向等宽卡片，多盘时自动横向滚动避免挤压） -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding VolumeCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF"
                                    BorderBrush="{Binding CardBorderBrush}"
                                    BorderThickness="1.2"
                                    CornerRadius="10"
                                    Padding="13,9"
                                    MinWidth="260"
                                    Margin="0,0,8,0">
                            <StackPanel>
                                <!-- 卡片头部：图标 + 盘名 + 状态胶囊 -->
                                <DockPanel Margin="0,0,0,7">
                                    <Border DockPanel.Dock="Right"
                                            Background="{Binding StatusBadgeBg}"
                                            BorderBrush="{Binding StatusBadgeBorder}"
                                            BorderThickness="1" CornerRadius="11" Padding="9,3"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="11.5" FontWeight="Medium" Foreground="{Binding StatusBadgeFg}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" Background="{Binding IconBgBrush}" CornerRadius="8" Margin="0,0,8,0">
                                            <Path Data="{StaticResource IconHardDrive}" Width="16" Height="16" Stretch="Uniform"
                                                  Stroke="{Binding IconStrokeBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding BackendSubtitle}" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 可用空间大数字 + 已用/总量 -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsedOverTotalText}" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding FreeText}" FontSize="17" FontWeight="Bold" Foreground="{Binding FreeTextBrush}"/>
                                </DockPanel>

                                <!-- 圆角容量进度条 -->
                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="7"
                                             Foreground="{Binding BarBrush}" Style="{StaticResource FluentProgressBarStyle}" Margin="0,0,0,8"/>

                                <!-- 卡片底部：占比/缓存状态 + 查看/扫描 + 重扫按钮 -->
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.StartScanForVolumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsScanning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"
                                                Visibility="{Binding ShowRescanButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                Height="30" Padding="8,0" Margin="0,0,6,0"
                                                ToolTip="强制重新全盘扫描该磁盘">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconRefreshCw}" Width="11.5" Height="11.5" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,4,0"/>
                                                <TextBlock Text="重扫" FontSize="11.5"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenOrScanVolumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsScanning, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"
                                                Height="30" Padding="12,0"
                                                ToolTip="{Binding CapabilityReason}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource FluentSecondaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentlyScanning}" Value="True">
                                                            <Setter Property="Background" Value="#EBF5FF"/>
                                                            <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                            <Setter Property="Foreground" Value="#0078D4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasCachedSnapshot}" Value="True">
                                                            <Setter Property="Background" Value="#EBF5FF"/>
                                                            <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                            <Setter Property="Foreground" Value="#0078D4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconPlay}" Width="12" Height="12" Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding ActionText}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UsedPercentText}" FontSize="11.5" Foreground="#64748B"/>
                                        <Border Background="{Binding CacheBadgeBg}"
                                                BorderBrush="{Binding CacheBadgeBorder}"
                                                BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="0,3,0,0"
                                                HorizontalAlignment="Left"
                                                ToolTip="{Binding CacheStatusToolTip}"
                                                Visibility="{Binding HasCacheBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding CacheStatusText}" FontSize="10.5" FontWeight="Medium" Foreground="{Binding CacheBadgeFg}"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 中间主内容区：左侧 3 阶段实时扫描面板 + 右侧备份提醒与最近扫描 -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="63*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="37*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧 ScanningPanel -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 阶段标题栏 -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,7">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScanElapsedText}" FontSize="12" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconRadar}" Width="12" Height="12" Stretch="Uniform" Stroke="#0078D4" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding ScanStageBadgeText}" FontSize="11.5" FontWeight="Medium" Foreground="#0078D4"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding ScanStageHeading}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- 渐变进度条 -->
                        <ProgressBar Grid.Row="1" Value="{Binding ScanProgressPercent, Mode=OneWay}" Maximum="100" Height="7"
                                     Style="{StaticResource FluentProgressBarStyle}" Margin="0,0,0,8">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0078D4" Offset="0"/>
                                    <GradientStop Color="#38BDF8" Offset="1"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                        </ProgressBar>

                        <!-- 3 张实时指标小卡 -->
                        <UniformGrid Grid.Row="2" Rows="1" Columns="3" Margin="0,0,0,8">
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="已解析 MFT / 目录记录" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding ScanProcessedRecordsText}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="已发现大目录 (&gt;1 GB)" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding ScanLargeDirCountText}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Text="命中 L1 推荐软件" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding ScanL1SummaryText}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- 3 阶段状态列表（带防御性滚动条，确保 1000x700 永不裁切） -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Stage 1 -->
                            <Border CornerRadius="7" Padding="10,5" Margin="0,0,0,5" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanStep1State}" Value="1">
                                                <Setter Property="Background" Value="#EBF5FF"/>
                                                <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ScanStep1Status}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScanStep1State}" Value="1"><Setter Property="Foreground" Value="#0078D4"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding ScanStep1State}" Value="2"><Setter Property="Foreground" Value="#0F7B4B"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheckCircle}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.8" Margin="0,0,8,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScanStep1State}" Value="1"><Setter Property="Stroke" Value="#0078D4"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ScanStep1State}" Value="2"><Setter Property="Stroke" Value="#0F7B4B"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <StackPanel>
                                            <TextBlock Text="1. 读取原始 MFT 主表" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            <TextBlock Text="顺序分块解析 $DATA、ADS、WOF 压缩与云占位（失败自动降级目录遍历）" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Stage 2 -->
                            <Border CornerRadius="7" Padding="10,5" Margin="0,0,0,5" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanStep2State}" Value="1">
                                                <Setter Property="Background" Value="#EBF5FF"/>
                                                <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ScanStep2Status}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScanStep2State}" Value="1"><Setter Property="Foreground" Value="#0078D4"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding ScanStep2State}" Value="2"><Setter Property="Foreground" Value="#0F7B4B"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheckCircle}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.8" Margin="0,0,8,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScanStep2State}" Value="1"><Setter Property="Stroke" Value="#0078D4"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ScanStep2State}" Value="2"><Setter Property="Stroke" Value="#0F7B4B"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <StackPanel>
                                            <TextBlock Text="2. 构建目录邻接树" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            <TextBlock Text="校验文件 ID 序列号，去重硬链接空间口径并按占用降序排布" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Stage 3 -->
                            <Border CornerRadius="7" Padding="10,5" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanStep3State}" Value="1">
                                                <Setter Property="Background" Value="#EBF5FF"/>
                                                <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ScanStep3Status}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ScanStep3State}" Value="1"><Setter Property="Foreground" Value="#0078D4"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding ScanStep3State}" Value="2"><Setter Property="Foreground" Value="#0F7B4B"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCheckCircle}" Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.8" Margin="0,0,8,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScanStep3State}" Value="1"><Setter Property="Stroke" Value="#0078D4"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ScanStep3State}" Value="2"><Setter Property="Stroke" Value="#0F7B4B"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <StackPanel>
                                            <TextBlock Text="3. 匹配软件归属与 4 级准入" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            <TextBlock Text="识别 NovaStudio / ComfyUI / Steam / Blender / Docker 等应用目录" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 右侧：待验证备份提醒 + 最近扫描记录 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10"
                            Padding="12" Margin="0,0,0,10"
                            Visibility="{Binding HasUnverifiedBackupReminder, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="{StaticResource IconArchive}" Width="15" Height="15" Stretch="Uniform" Stroke="#B45309" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding UnverifiedReminderTitle}" FontSize="13" FontWeight="Bold" Foreground="#B45309"/>
                            </StackPanel>
                            <TextBlock Text="上次迁移保留了源盘备份。确认软件运行正常后，可在备份管理中经双确认手动释放空间。"
                                       FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Command="{Binding OpenBackupCenterCommand}" Style="{StaticResource FluentSecondaryButtonStyle}"
                                    HorizontalAlignment="Right" Height="30">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="前往备份管理" Margin="0,0,6,0"/>
                                    <Path Data="{StaticResource IconArrowRight}" Width="13" Height="13" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource FluentCardBorderStyle}" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="清除开发缓存" Command="{Binding ClearDevCacheCommand}"
                                        Style="{StaticResource FluentLinkButtonStyle}" FontSize="11" Foreground="#64748B"
                                        Visibility="{Binding HasDevCache, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="最近扫描记录" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="本次会话尚无扫描记录。点击上方任意磁盘卡片的「开始扫描」即可秒级生成目录树快照。"
                                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap"
                                       Visibility="{Binding HasRecentScans, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding RecentScans}"
                                          Visibility="{Binding HasRecentScans, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenRecentScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                                HorizontalContentAlignment="Stretch" Height="Auto" Padding="11,8" Margin="0,0,0,7"
                                                Background="#F8FAFC" BorderBrush="#E2E8F0">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CompletedTimeText}" FontSize="11" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding VolumeTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 底部只读承诺脚栏 -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="14,9">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding StartScanCommand}"
                                AutomationProperties.AutomationId="DiskScanStartButton"
                                Style="{StaticResource FluentPrimaryButtonStyle}"
                                Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Width="13" Height="13" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                <TextBlock Text="扫描选中磁盘"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoToDirectoryTreeCommand}"
                                Style="{StaticResource FluentSoftPrimaryButtonStyle}"
                                Visibility="{Binding CanReturnToTreeFromSelect, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="查看上次目录树" Margin="0,0,5,0"/>
                                <Path Data="{StaticResource IconArrowRight}" Width="13" Height="13" Stretch="Uniform" Stroke="#0078D4" StrokeThickness="1.8"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelScanCommand}"
                                AutomationProperties.AutomationId="DiskScanCancelButton"
                                Style="{StaticResource FluentSecondaryButtonStyle}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconX}" Width="13" Height="13" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                <TextBlock Text="取消扫描"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconShieldCheck}" Width="15" Height="15" Stretch="Uniform" Stroke="#0F7B4B" StrokeThickness="1.8" Margin="0,0,7,0"/>
                        <TextBlock Text="只读扫描模式：绝不修改卷数据或文件权限；扫描完成后自动进入目录树。" FontSize="12" Foreground="#334155"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 阶段 01：目录树与 4 级详情（严格对齐 docs/untitled.pen Artboard 01）          -->
        <!-- ========================================================================= -->
        <Grid Margin="18,12" Visibility="{Binding IsDirectoryTreeView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- S01TopBar：卷信息 + 模式徽章 + 重新扫描 -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,9">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleAiDrawerCommand}"
                                AutomationProperties.AutomationId="DiskScanAiDrawerToggle"
                                Style="{StaticResource FluentSoftPrimaryButtonStyle}"
                                Tag="{Binding AiDrawerButtonTag}"
                                Height="30" Padding="10,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSparkles}" Width="13" Height="13" Stretch="Uniform" Stroke="#0078D4" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                <TextBlock Text="AI 助手" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoToVolumeSelectCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" Height="30" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHardDrive}" Width="13" Height="13" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                <TextBlock Text="切换磁盘"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StartScanCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" Height="30">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshCw}" Width="13" Height="13" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                <TextBlock Text="重新扫描"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconHardDrive}" Width="14" Height="14" Stretch="Uniform" Stroke="#0078D4" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SnapshotVolumeTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="11" Padding="9,3" Margin="0,0,10,0" BorderThickness="1" ToolTip="{Binding UsnStatusNote}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFBEB"/>
                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSnapshotMftBackend}" Value="True">
                                            <Setter Property="Background" Value="#ECFDF5"/>
                                            <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconZap}" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.8" Margin="0,0,5,0">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="#B45309"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSnapshotMftBackend}" Value="True"><Setter Property="Stroke" Value="#0F7B4B"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding SnapshotModeBadge}" FontSize="11.5" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B45309"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSnapshotMftBackend}" Value="True"><Setter Property="Foreground" Value="#0F7B4B"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SnapshotVolumeSummary}" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- S01StaleBanner：会话缓存陈旧/卷变动温和提示条 -->
            <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8"
                    Padding="12,6" Margin="0,0,0,9"
                    Visibility="{Binding IsSnapshotStale, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding StartScanCommand}"
                            Style="{StaticResource FluentSecondaryButtonStyle}" Height="26" Padding="10,0" Margin="10,0,0,0">
                        <TextBlock Text="立即重新扫描" FontSize="11.5"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTriangleAlert}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="#B45309" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding SnapshotStaleMessage}" FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- S01FilterBar：面包屑 + 目录树/大软件切换 + 显示文件开关 + 搜索框 -->
            <DockPanel Grid.Row="2" Margin="0,0,0,9">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding ShowFilesInTree}" Content="显示文件" FontSize="11.5" Foreground="#475569"
                              VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="默认只显示可浏览/可迁移的文件夹；勾选后可查看单个大文件"/>
                    <Border Background="#EEF2F6" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="目录树" Command="{Binding SwitchToTreeViewCommand}"
                                    Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="58" Padding="10,0" FontSize="11.5"
                                    Tag="{Binding TreeViewTag}"/>
                            <Button Content="大软件目录" Command="{Binding SwitchToHotspotViewCommand}"
                                    Style="{StaticResource FluentNavPillButtonStyle}" Height="26" MinWidth="76" Padding="10,0" FontSize="11.5"
                                    Tag="{Binding HotspotViewTag}"/>
                        </StackPanel>
                    </Border>
                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Tag="搜索目录或软件名…"
                             Style="{StaticResource FluentCompactTextBoxStyle}"
                             Width="180"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconFolderOpen}" Width="14" Height="14" Stretch="Uniform" Stroke="#0078D4" StrokeThickness="1.8" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding BreadcrumbText}" FontSize="12.5" FontWeight="Medium" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>

            <!-- S01Main：左侧 TreeTableCard (默认 64%) + 可拖动分隔条 + 右侧 DetailPanel / AI 抽屉 (默认 36%) -->
            <Grid x:Name="TreeMainSplitGrid" Grid.Row="3" Margin="0,0,0,9" SizeChanged="TreeMainSplitGrid_OnSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TreeLeftColumn" Width="64*" MinWidth="480"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition x:Name="TreeRightColumn" Width="36*" MinWidth="310" MaxWidth="920"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧 TreeTableCard -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 简洁 4 列表头（大软件模式下内嵌「直达列表 | 按路径展开」子视角切换） -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
                            <Grid MinHeight="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="108"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="目录名称（按占用降序）" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <Border Background="#EEF2F6" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="2" Margin="10,0,0,0"
                                            Visibility="{Binding IsHotspotMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding SwitchToHotspotPathTreeCommand}"
                                                    Style="{StaticResource FluentNavPillButtonStyle}" Height="20" MinWidth="0" Padding="7,0" FontSize="11"
                                                    Tag="{Binding HotspotPathTreeTag}" ToolTip="{Binding HotspotPathTreeToolTip}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Width="10" Height="10" Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Margin="0,0,4,0" VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data" Value="{StaticResource IconChevronRight}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHotspotPathTreeExpanded}" Value="True">
                                                                        <Setter Property="Data" Value="{StaticResource IconChevronDown}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <TextBlock Text="按路径" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Content="直达列表" Command="{Binding SwitchToHotspotFlatCommand}"
                                                    Style="{StaticResource FluentNavPillButtonStyle}" Height="20" MinWidth="0" Padding="7,0" FontSize="11"
                                                    Tag="{Binding HotspotFlatTag}" ToolTip="跳过中间容器层，按占用降序直达各大软件目录"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="实际占用" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ShareColumnHeader}" ToolTip="{Binding ShareColumnToolTip}" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="准入等级" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 虚拟化扁平投影 ListView（严禁禁用虚拟化；所有按钮使用 FluentIconButtonStyle 无 RenderTransform 异常） -->
                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding VisibleTreeRows}"
                                  SelectedItem="{Binding SelectedRow}"
                                  AutomationProperties.AutomationId="DiskScanTreeList"
                                  BorderThickness="0"
                                  Background="#FFFFFF"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="12,7"/>
                                    <Setter Property="Background" Value="#FFFFFF"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="rowBd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="rowBd" Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="rowBd" Property="Background" Value="#EBF5FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="108"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 第 1 列：缩进 + 展开箭头 + 锁/勾选状态 + 类型图标 + 目录名（DockPanel 防止标签右端被硬切） -->
                                        <DockPanel Grid.Column="0" Margin="{Binding IndentMargin}" VerticalAlignment="Center" LastChildFill="True">
                                            <Button DockPanel.Dock="Left" Content="{Binding ExpandGlyph}"
                                                    Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FluentIconButtonStyle}"
                                                    Visibility="{Binding ShowExpandButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Width="20" Height="20" FontSize="11" Margin="0,0,2,0"/>
                                            <Border DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,2,0"
                                                    Visibility="{Binding ShowExpandButton, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                                            <!-- 固定 18px 宽度的状态槽位（L0 红锁 / L2 外链 / L1&L3 勾选框），确保各等级文件夹图标严格像素对齐 -->
                                            <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center"
                                                  Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Path Data="{StaticResource IconLock}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="#C42B1C" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsHardDenied, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Path Data="{StaticResource IconExternalLink}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="#0078D4" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsNativeGuide, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Command="{Binding DataContext.ToggleRowInPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource FluentIconButtonStyle}"
                                                        Width="18" Height="18"
                                                        ToolTip="勾选加入或移出待迁移清单"
                                                        Visibility="{Binding CanToggleInPlan, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Border Width="14" Height="14" CornerRadius="3" BorderThickness="1.3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FFFFFF"/>
                                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsIndeterminateInPlan}" Value="True">
                                                                        <Setter Property="Background" Value="#EBF5FF"/>
                                                                        <Setter Property="BorderBrush" Value="#0078D4"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsInPlan}" Value="True">
                                                                        <Setter Property="Background" Value="#0078D4"/>
                                                                        <Setter Property="BorderBrush" Value="#0078D4"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Path Data="{StaticResource IconCheck}" Width="9" Height="9" Stretch="Uniform"
                                                                  Stroke="#FFFFFF" StrokeThickness="2.4"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Visibility="{Binding IsInPlan, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <Border Width="8" Height="2" CornerRadius="1" Background="#0078D4"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsIndeterminateInPlan, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </Grid>

                                            <Path DockPanel.Dock="Left" Data="{StaticResource IconFolder}" Width="14" Height="14" Stretch="Uniform"
                                                  Stroke="{Binding TypeIconColor}" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" FontSize="12.5" FontWeight="Medium" Foreground="#0F172A"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>

                                            <!-- 文件夹名右侧悬浮提示图标：琥珀黄感叹号（特别注意/工具保护/谨慎风险）或蓝色信息图标（常见目录用途说明） -->
                                            <Border DockPanel.Dock="Left" Background="Transparent" Padding="4,2,2,2" VerticalAlignment="Center"
                                                    ToolTip="{Binding HintToolTip}" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="15000"
                                                    Visibility="{Binding ShowWarningHint, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Path Data="{StaticResource IconTriangleAlert}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="#D97706" StrokeThickness="2" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border DockPanel.Dock="Left" Background="Transparent" Padding="4,2,2,2" VerticalAlignment="Center"
                                                    ToolTip="{Binding HintToolTip}" ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="15000"
                                                    Visibility="{Binding ShowInfoHint, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Path Data="{StaticResource IconInfo}" Width="13" Height="13" Stretch="Uniform"
                                                      Stroke="#0078D4" StrokeThickness="1.9" VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="{Binding AttributionLabel, StringFormat=· {0}}" FontSize="11" Foreground="#64748B"
                                                       Margin="6,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasAttribution, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </DockPanel>

                                        <!-- 第 2 列：实际占用 -->
                                        <TextBlock Grid.Column="1" Text="{Binding AllocatedText}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="#0F172A" TextAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- 第 3 列：上方百分比 + 下方 5px 语义色细条 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,4,0">
                                            <TextBlock Text="{Binding ShareText}" FontSize="11" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,3"/>
                                            <ProgressBar Value="{Binding ParentSharePercent, Mode=OneWay}" Maximum="100" Height="5"
                                                         Foreground="{Binding BarBrush}" Style="{StaticResource FluentProgressBarStyle}"/>
                                        </StackPanel>

                                        <!-- 第 4 列：99 圆角准入胶囊 -->
                                        <Border Grid.Column="3" CornerRadius="11" Padding="9,3" BorderThickness="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{Binding LevelBadgeBackground}"
                                                BorderBrush="{Binding LevelBadgeBorder}"
                                                Visibility="{Binding ShowLevelBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding LevelBadgeText}" FontSize="11" FontWeight="Medium"
                                                       Foreground="{Binding LevelBadgeForeground}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 可拖动分隔条：支持用户按窗口宽度动态调整目录树与右侧详情/AI 分析助手的宽度比例 -->
                <GridSplitter x:Name="TreeDrawerGridSplitter"
                              Grid.Column="1"
                              Style="{StaticResource FluentVerticalGridSplitterStyle}"
                              AutomationProperties.AutomationId="DiskScanDrawerSplitter"
                              ToolTip="左右拖动调整右侧面板 / AI 分析助手宽度（双击恢复默认比例）"
                              MouseDoubleClick="TreeDrawerGridSplitter_OnMouseDoubleClick"/>

                <!-- 右侧面板：默认目录详情卡，展开 AI 抽屉时原位切换为共用 AI 分析助手抽屉（保障 1000x700 下目录树零挤压） -->
                <Grid Grid.Column="2">
                    <views:AiAssistantDrawerControl DataContext="{Binding AiAssistant}"
                                                      ShowCloseButton="True"
                                                      Visibility="{Binding DataContext.IsAiDrawerOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Border Style="{StaticResource FluentCardBorderStyle}" Padding="14"
                            Visibility="{Binding IsAiDrawerOpen, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom"
                                Command="{Binding AddSelectedToPlanCommand}"
                                AutomationProperties.AutomationId="DiskScanAddToPlanButton"
                                IsEnabled="{Binding CanAddSelectedToPlan}"
                                Style="{StaticResource FluentPrimaryButtonStyle}" Height="34" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" Width="14" Height="14" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="2" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedActionButtonText}"/>
                            </StackPanel>
                        </Button>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <!-- 顶部准入徽章 + 打开文件夹图标 -->
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Command="{Binding OpenSelectedInExplorerCommand}"
                                        Style="{StaticResource FluentIconButtonStyle}" ToolTip="在资源管理器中打开目录">
                                    <Path Data="{StaticResource IconFolderOpen}" Width="15" Height="15" Stretch="Uniform" Stroke="#64748B" StrokeThickness="1.8"/>
                                </Button>
                                <Border Background="{Binding SelectedLevelBadgeBg}"
                                        BorderBrush="{Binding SelectedLevelBadgeBorder}"
                                        BorderThickness="1" CornerRadius="11" Padding="9,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding SelectedLevelBadgeText}" FontSize="11.5" FontWeight="Medium" Foreground="{Binding SelectedLevelBadgeFg}"/>
                                </Border>
                            </DockPanel>

                            <!-- 大标题与完整路径 -->
                            <TextBlock Text="{Binding SelectedTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedPathDisplay}" FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,10"/>

                            <!-- 双列指标卡：实际占用 | 文件数量 -->
                            <UniformGrid Rows="1" Columns="2" Margin="0,0,0,9">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="实际占用" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedAllocatedDisplay}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="文件数量" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedFileCountDisplay}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                                <!-- 目录用途说明卡（面向常见系统目录、个人目录、工具自身保护与高频软件/开发目录） -->
                                <Border BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,9"
                                        Visibility="{Binding HasDirectoryExplanation, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedExplanationIsWarning}" Value="True">
                                                    <Setter Property="Background" Value="#FFFBEB"/>
                                                    <Setter Property="BorderBrush" Value="#FCD34D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <Path DockPanel.Dock="Left" Width="13" Height="13" Stretch="Uniform"
                                                  StrokeThickness="1.9" Margin="0,2,6,0" VerticalAlignment="Top">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconInfo}"/>
                                                        <Setter Property="Stroke" Value="#0078D4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedExplanationIsWarning}" Value="True">
                                                                <Setter Property="Data" Value="{StaticResource IconTriangleAlert}"/>
                                                                <Setter Property="Stroke" Value="#D97706"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding SelectedDirectoryRoleTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding SelectedDirectoryPurpose}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding SelectedDirectoryAdvice, StringFormat=建议：{0}}" FontSize="11.5" FontWeight="Medium" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#005A9E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedExplanationIsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 归属与安全核验卡 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="归属与安全核验" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding SelectedEvidenceIdentity}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedEvidenceStructure}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedEvidenceStorage}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- L2 厂商原生引导面板 -->
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,9"
                                    Visibility="{Binding ShowNativeGuidance, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="推荐使用官方原生迁移方案" FontSize="12" FontWeight="SemiBold" Foreground="#B45309" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedNativeGuidance}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="复制官方步骤" Command="{Binding CopyNativeGuidanceCommand}"
                                                Style="{StaticResource FluentSecondaryButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,0"/>
                                        <Button Content="详情弹窗" Command="{Binding ShowNativeGuidanceModalCommand}"
                                                Style="{StaticResource FluentSoftPrimaryButtonStyle}" Height="28" Padding="10,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- L3 人工风险确认勾选框 -->
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,9"
                                    Visibility="{Binding ShowL3ConfirmCheck, Converter={StaticResource BoolToVisibilityConverter}}">
                                <CheckBox IsChecked="{Binding IsL3RiskConfirmedForSelection}"
                                          AutomationProperties.AutomationId="DiskScanL3RiskConfirmCheck">
                                    <TextBlock Text="我已确认该目录为个人数据或非系统业务目录，理解未经官方兼容性实测并愿自行承担迁移风险。"
                                               FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap"/>
                                </CheckBox>
                            </Border>

                            <!-- 原件保护蓝卡 -->
                            <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Data="{StaticResource IconShieldCheck}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="#0078D4" StrokeThickness="1.8" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding SelectedSafeNote}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </Grid>
            </Grid>

            <!-- S01Foot：已勾选汇总 + 前往迁移清单主按钮 -->
            <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="14,9">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding GoToMigrationQueueCommand}"
                            IsEnabled="{Binding HasPlanItems}"
                            Style="{StaticResource FluentPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding GoToQueueButtonText}" Margin="0,0,6,0"/>
                            <Path Data="{StaticResource IconArrowRight}" Width="14" Height="14" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.8"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconListChecks}" Width="12" Height="12" Stretch="Uniform" Stroke="#0078D4" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding PlanSelectionBadgeText}" FontSize="11.5" FontWeight="Medium" Foreground="#0078D4"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="仅勾选不会执行迁移；下一步设置目标盘与核对级别。" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 阶段 02：待迁移清单与安全预检（严格对齐 docs/untitled.pen Artboard 02）       -->
        <!-- ========================================================================= -->
        <Grid Margin="18,12" Visibility="{Binding IsMigrationQueueView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- S02Head -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Command="{Binding GoToDirectoryTreeCommand}"
                        Style="{StaticResource FluentSecondaryButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconArrowLeft}" Width="14" Height="14" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0"/>
                        <TextBlock Text="返回目录树"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="待迁移清单与安全预检" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="队列将串行复用手动迁移底座执行；启动前对全部目录进行占用、身份与目标空间复核。"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- ConfigBar：统一目标根目录 + 快速/SHA-256 分段切换 -->
            <Border Grid.Row="1" Style="{StaticResource FluentCardBorderStyle}" Padding="14,11" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <!-- 统一目标根目录 -->
                    <StackPanel Grid.Column="0">
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TargetSpaceHintText}" FontSize="11.5" FontWeight="Medium" Foreground="#0F7B4B"/>
                            <TextBlock Text="统一目标根目录（按软件与相对路径隔离，绝不覆盖现有目录）" FontSize="11.5" FontWeight="Medium" Foreground="#64748B"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding UnifiedTargetRoot, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FluentCompactTextBoxStyle}" Height="32"/>
                            <Button Grid.Column="2" Command="{Binding BrowseUnifiedTargetCommand}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolderOpen}" Width="13" Height="13" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                    <TextBlock Text="浏览"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 复制完整性核对级别分段器 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="复制完整性核对级别（默认快速核对，不宣称逐字节一致）" FontSize="11.5" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,5"/>
                        <Border Background="#EEF2F6" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="3" Height="32">
                            <UniformGrid Rows="1" Columns="2">
                                <Button Command="{Binding SetFastVerificationCommand}"
                                        Style="{StaticResource FluentNavPillButtonStyle}" Height="24" MinWidth="0" Padding="6,0" FontSize="11.5"
                                        Tag="{Binding FastVerifyTag}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconZap}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Margin="0,0,4,0"/>
                                        <TextBlock Text="快速核对（默认）"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SetHashVerificationCommand}"
                                        AutomationProperties.AutomationId="BatchUseContentHashCheck"
                                        Style="{StaticResource FluentNavPillButtonStyle}" Height="24" MinWidth="0" Padding="6,0" FontSize="11.5"
                                        Tag="{Binding HashVerifyTag}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconShieldCheck}" Width="12" Height="12" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Margin="0,0,4,0"/>
                                        <TextBlock Text="完整 SHA-256"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- QueueList：卡片式待迁列表 -->
            <ListView Grid.Row="2" ItemsSource="{Binding PlanItems}" BorderThickness="0" Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFFF" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.2" CornerRadius="10" Padding="14,11">
                            <StackPanel>
                                <!-- 头部 -->
                                <DockPanel Margin="0,0,0,7">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeText}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="修改目标"
                                                Command="{Binding DataContext.EditPlanItemTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource FluentLinkButtonStyle}" Margin="0,0,6,0"/>
                                        <Button Content="移除"
                                                Command="{Binding DataContext.RemovePlanItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource FluentLinkButtonStyle}" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Background="{Binding LevelBadgeBg}" BorderBrush="{Binding LevelBadgeBorder}" BorderThickness="1" CornerRadius="11" Padding="8,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="Medium" Foreground="{Binding LevelBadgeFg}"/>
                                        </Border>
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="11" Padding="8,2">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#475569"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 路径流 -->
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SourcePath}" FontSize="11.5" Foreground="#334155" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/>
                                        <Path Grid.Column="1" Data="{StaticResource IconArrowRight}" Width="13" Height="13" Stretch="Uniform" Stroke="#0078D4" StrokeThickness="1.8" Margin="8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TargetPath}" FontSize="11.5" FontWeight="Medium" Foreground="#0078D4" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetPath}"/>
                                    </Grid>
                                </Border>

                                <!-- 行内阻断警示条 -->
                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,7,0,0"
                                        Visibility="{Binding HasBlockingReason, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="重新检测进程"
                                                Command="{Binding DataContext.FreezeAndPreflightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource FluentLinkButtonStyle}" FontSize="11.5" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTriangleAlert}" Width="13" Height="13" Stretch="Uniform" Stroke="#B45309" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding BlockingReason}" FontSize="11.5" FontWeight="Medium" Foreground="#B45309" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- L3 安全提示条 -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,7,0,0"
                                        Visibility="{Binding ShowL3SafeHint, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconInfo}" Width="13" Height="13" Stretch="Uniform" Stroke="#64748B" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                        <TextBlock Text="已确认普通个人数据风险；仍将执行完整核对、改名备份保留与双确认删除。" FontSize="11.5" Foreground="#334155"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- S02Foot：预检结论 + 重新预检 + 开始迁移 -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="14,9">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="清空" Command="{Binding ClearPlanCommand}" Style="{StaticResource FluentSecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Command="{Binding FreezeAndPreflightCommand}"
                                AutomationProperties.AutomationId="BatchFreezePreflightButton"
                                Style="{StaticResource FluentSecondaryButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefreshCw}" Width="13" Height="13" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                <TextBlock Text="重新预检全部"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExecuteBatchCommand}"
                                AutomationProperties.AutomationId="BatchExecuteButton"
                                IsEnabled="{Binding CanStartBatch}"
                                Style="{StaticResource FluentPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Width="13" Height="13" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StartBatchButtonText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Path Data="{StaticResource IconTriangleAlert}" Width="15" Height="15" Stretch="Uniform" Stroke="#B45309" StrokeThickness="1.8" Margin="0,0,7,0"
                              Visibility="{Binding HasPreflightBlocking, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Path Data="{StaticResource IconShieldCheck}" Width="15" Height="15" Stretch="Uniform" Stroke="#0F7B4B" StrokeThickness="1.8" Margin="0,0,7,0"
                              Visibility="{Binding HasPreflightBlocking, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding PreflightSummary}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreflightSummary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F7B4B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreflightBlocking}" Value="True"><Setter Property="Foreground" Value="#B45309"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 阶段 04：迁移执行 · 实时进度与原件保留（对齐 docs/untitled.pen Artboard 04） -->
        <!-- ========================================================================= -->
        <Grid Margin="18,12" Visibility="{Binding IsBatchExecutionView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- S04Head -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Command="{Binding ToggleDetailedLogsCommand}"
                        Style="{StaticResource FluentSecondaryButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTerminal}" Width="14" Height="14" Stretch="Uniform" Stroke="#0F172A" StrokeThickness="1.8" Margin="0,0,6,0"/>
                        <TextBlock Text="查看详细日志"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding ExecutionHeaderTitle}" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding ExecutionHeaderSubtitle}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- S04Main：左侧 275px QueueCol + 右侧 RunningPanel -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="275"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧执行队列 -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardBorderStyle}" Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="11" Padding="8,2">
                                <TextBlock Text="{Binding ExecutionQueueBadgeText}" FontSize="11" FontWeight="Medium" Foreground="#0078D4"/>
                            </Border>
                            <TextBlock Text="执行队列" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock Text="取消将安全终止 Robocopy 子进程并暂停后续队列，不会删除源目录或已完成的备份。"
                                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding IsBatchExecuting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Command="{Binding CancelBatchCommand}" Style="{StaticResource FluentDangerButtonStyle}"
                                    Visibility="{Binding IsBatchExecuting, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSquare}" Width="12" Height="12" Stretch="Uniform" Stroke="#C42B1C" StrokeThickness="1.8" Margin="0,0,6,0"/>
                                    <TextBlock Text="安全停止迁移"/>
                                </StackPanel>
                            </Button>
                            <Button Content="返回目录树" Command="{Binding GoToDirectoryTreeCommand}"
                                    Style="{StaticResource FluentSecondaryButtonStyle}"
                                    Visibility="{Binding IsBatchFinished, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <ListView ItemsSource="{Binding PlanItems}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding QueueCardBackground}" BorderBrush="{Binding QueueCardBorder}" BorderThickness="1" CornerRadius="8" Padding="11,9">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="11.5" FontWeight="Medium" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Medium" Foreground="{Binding QueueStatusForeground}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- 右侧当前项执行详情 -->
                <Border Grid.Column="2" Style="{StaticResource FluentCardBorderStyle}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ActivePercentText}" FontSize="22" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#EBF5FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="11" Padding="9,3" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ActiveStageBadgeText}" FontSize="11.5" FontWeight="Medium" Foreground="#0078D4"/>
                                    </Border>
                                    <TextBlock Text="{Binding ActiveItemTitle}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 源 -> 目标路径流 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ActiveItemSourcePath}" FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                    <Path Grid.Column="1" Data="{StaticResource IconArrowRight}" Width="14" Height="14" Stretch="Uniform" Stroke="#0078D4" StrokeThickness="1.8" Margin="8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ActiveItemTargetPath}" FontSize="12" FontWeight="SemiBold" Foreground="#0078D4" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <!-- 10px 渐变进度条 -->
                            <ProgressBar Value="{Binding ActiveItemPercent, Mode=OneWay}" Maximum="100" Height="10"
                                         Style="{StaticResource FluentProgressBarStyle}" Margin="0,0,0,12">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0078D4" Offset="0"/>
                                        <GradientStop Color="#38BDF8" Offset="0.65"/>
                                        <GradientStop Color="#10B981" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>

                            <!-- 4 列实时指标卡 -->
                            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="已复制数据" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding ActiveCopiedText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="平滑速度 (EMA)" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding ActiveSpeedText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="预计剩余" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding ActiveEtaText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="核对模式" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding ActiveVerifyModeText}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- 4 步执行流水线 -->
                            <StackPanel>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="11,7" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExecStep1Note}" FontSize="11.5" FontWeight="Medium" Foreground="#0F7B4B"/>
                                        <TextBlock Text="1. 身份与占用安全复核（含重命名快检与事务落盘）" FontSize="12" Foreground="#0F172A"/>
                                    </DockPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="11,7" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExecStep2Note}" FontSize="11.5" FontWeight="Medium" Foreground="#0078D4"/>
                                        <TextBlock Text="2. 多线程 Robocopy 复制到独占新目标目录" FontSize="12" Foreground="#0F172A"/>
                                    </DockPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="11,7" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExecStep3Note}" FontSize="11.5" FontWeight="Medium" Foreground="#64748B"/>
                                        <TextBlock Text="3. 复制完整性核对（相对路径清单、逐文件大小、必要元数据或 SHA-256）" FontSize="12" Foreground="#0F172A"/>
                                    </DockPanel>
                                </Border>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="11,7">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExecStep4Note}" FontSize="11.5" FontWeight="Medium" Foreground="#64748B"/>
                                        <TextBlock Text="4. 原目录改名保留为源盘备份 → 创建目录符号链接 → 验证可达" FontSize="12" Foreground="#0F172A"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>

                            <!-- 可折叠详细日志 -->
                            <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,10,0,0" MaxHeight="160"
                                    Visibility="{Binding ShowDetailedLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListBox ItemsSource="{Binding BatchLogs}" Background="Transparent" BorderThickness="0"
                                         Foreground="#E2E8F0" FontFamily="Consolas" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- S04Foot：原件保护绿色承诺条 -->
            <Border Grid.Row="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="9" Padding="14,9">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding OpenBackupCenterCommand}"
                            Style="{StaticResource FluentPrimaryButtonStyle}" Height="30"
                            Visibility="{Binding IsBatchFinished, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="前往备份管理验证" Margin="0,0,5,0"/>
                            <Path Data="{StaticResource IconArrowRight}" Width="13" Height="13" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="1.8"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconShieldCheck}" Width="16" Height="16" Stretch="Uniform" Stroke="#0F7B4B" StrokeThickness="1.8" Margin="0,0,8,0"/>
                        <TextBlock Text="原件保护承诺：源盘原始数据全程保留不自动删除；迁移完成后进入备份管理验证软件，再由你手动释放空间。"
                                   FontSize="12" FontWeight="Medium" Foreground="#0F7B4B" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
