<UserControl x:Class="MoveWithSymlinkWPF.Controls.ReasoningEffortSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="312"
             FontFamily="Microsoft YaHei UI, Segoe UI, Microsoft YaHei"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- 显式局部按钮样式：不继承 App.xaml 全局 RenderTransform Storyboard，确保单测与交互零冲突 -->
        <Style x:Key="EffortAutoChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EffortCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EffortCreditLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="#0078D4"/>
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题档位文字微模糊上浮切换动画 -->
        <Storyboard x:Key="StatusPopStoryboard">
            <DoubleAnimation Storyboard.TargetName="StatusGroup"
                             Storyboard.TargetProperty="Opacity"
                             From="0.15" To="1.0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusTranslate"
                             Storyboard.TargetProperty="Y"
                             From="5" To="0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusBlur"
                             Storyboard.TargetProperty="Radius"
                             From="5" To="0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <!-- 留出投影与外圈辉光安全边距（Popup AllowsTransparency 时不被裁切） -->
    <Grid Margin="10">
        <!-- 外圈动态色温柔和光晕（Fluent 亮色融冰版保持克制通透） -->
        <Border x:Name="OuterGlowBorder"
                CornerRadius="14"
                Margin="-2"
                Opacity="0.22"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="OuterGlowStopA" Color="#0EA5E9" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="0.5"/>
                    <GradientStop x:Name="OuterGlowStopB" Color="#0EA5E9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <BlurEffect Radius="12"/>
            </Border.Effect>
        </Border>

        <!-- Fluent 亮色融冰主卡片 -->
        <Border CornerRadius="12"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Padding="13,11,13,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8FAFC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" Opacity="0.14" BlurRadius="18" ShadowDepth="4" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- 1. 头部：标题 + 动效档位名 + 自动默认胶囊 + 关闭按钮 -->
                <DockPanel Margin="0,0,0,9">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AutoDefaultButton"
                                AutomationProperties.AutomationId="AiReasoningAutoDefaultButton"
                                Style="{StaticResource EffortAutoChipButtonStyle}"
                                Click="AutoDefaultButton_OnClick"
                                Margin="0,0,5,0"
                                ToolTip="恢复由模型服务端自适应（不强传 reasoning_effort）">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="AutoChipDot" Width="5" Height="5" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="自动默认" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClosePopupButton"
                                AutomationProperties.AutomationId="AiReasoningSliderCloseButton"
                                Style="{StaticResource EffortCloseButtonStyle}"
                                Click="ClosePopupButton_OnClick"
                                Content="×"
                                ToolTip="收起思考等级面板"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="思考等级"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"/>
                        <StackPanel x:Name="StatusGroup" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="StatusTranslate" Y="0"/>
                            </StackPanel.RenderTransform>
                            <StackPanel.Effect>
                                <BlurEffect x:Name="StatusBlur" Radius="0"/>
                            </StackPanel.Effect>
                            <TextBlock x:Name="StatusZhText"
                                       Text="默认"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#0284C7"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock x:Name="StatusEnText"
                                       Text="AUTO"
                                       FontFamily="Georgia, Palatino Linotype, Times New Roman"
                                       FontStyle="Italic"
                                       FontWeight="Bold"
                                       FontSize="11.5"
                                       Foreground="#0284C7"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- 2. 7 档刻度标签（按滑块中心行程精确布点，点击任意文字即可跳转） -->
                <Canvas x:Name="TickLabelsCanvas" Height="16" Margin="0,0,0,4" ClipToBounds="False"/>

                <!-- 3. 深空玻璃能量滑槽（像素点阵火焰 + 点光源 + 金属磨砂圆角 Thumb） -->
                <Border x:Name="TrackSlotBorder"
                        AutomationProperties.AutomationId="AiReasoningEffortTrack"
                        Height="36"
                        CornerRadius="9"
                        BorderBrush="#330F172A"
                        BorderThickness="1"
                        Cursor="Hand"
                        Focusable="True"
                        ClipToBounds="True"
                        MouseLeftButtonDown="TrackSlot_OnMouseLeftButtonDown"
                        MouseMove="TrackSlot_OnMouseMove"
                        MouseLeftButtonUp="TrackSlot_OnMouseLeftButtonUp"
                        LostMouseCapture="TrackSlot_OnLostMouseCapture"
                        MouseEnter="TrackSlot_OnMouseEnter"
                        MouseLeave="TrackSlot_OnMouseLeave"
                        MouseWheel="TrackSlot_OnMouseWheel"
                        KeyDown="TrackSlot_OnKeyDown"
                        SizeChanged="TrackSlot_OnSizeChanged">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0B1020" Offset="0"/>
                            <GradientStop Color="#11182C" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid x:Name="TrackInnerGrid">
                        <!-- 刻度圆点层 -->
                        <Canvas x:Name="DotsCanvas" IsHitTestVisible="False"/>

                        <!-- 60fps 像素点阵能量火焰画布（WriteableBitmap 零 GC 刷新） -->
                        <Image x:Name="EnergyImage"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               IsHitTestVisible="False"/>

                        <!-- 拖拽/悬停跟随点光源 -->
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="PointLightEllipse"
                                     Width="126" Height="126"
                                     Canvas.Top="-45"
                                     Opacity="0"
                                     IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                        <GradientStop x:Name="PointLightInnerStop" Color="#580EA5E9" Offset="0"/>
                                        <GradientStop x:Name="PointLightMidStop" Color="#1E0EA5E9" Offset="0.4"/>
                                        <GradientStop Color="#000EA5E9" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Canvas>

                        <!-- 顶面玻璃高光薄层 -->
                        <Border CornerRadius="8" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1AFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.44"/>
                                    <GradientStop Color="#2B000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 磨砂金属圆角滑块 Thumb -->
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="ThumbBorder"
                                    Width="28" Height="28"
                                    Canvas.Top="3"
                                    CornerRadius="8"
                                    BorderBrush="#D8FFFFFF"
                                    BorderThickness="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop x:Name="ThumbGradStart" Color="#FFFFFF" Offset="0"/>
                                        <GradientStop x:Name="ThumbGradMid" Color="#ECE7F8" Offset="0.52"/>
                                        <GradientStop x:Name="ThumbGradEnd" Color="#D5C9EC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ThumbGlowEffect"
                                                      Color="#0EA5E9"
                                                      Opacity="0.45"
                                                      BlurRadius="12"
                                                      ShadowDepth="0"/>
                                </Border.Effect>
                                <!-- 滑块中心发光微指示条 -->
                                <Border x:Name="ThumbCoreBar"
                                        Width="3" Height="11"
                                        CornerRadius="1.5"
                                        Background="#0EA5E9"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- 4. 协议值与档位短说明 -->
                <DockPanel Margin="0,8,0,5">
                    <TextBlock x:Name="DescMiniText"
                               DockPanel.Dock="Right"
                               Text="自适应 · 由模型服务端决定"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="#0284C7"
                               VerticalAlignment="Center"/>
                    <Border Background="#F1F5F9"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,1.5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="WireValueText"
                                   Text="reasoning_effort = auto"
                                   FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI"
                                   FontSize="9"
                                   Foreground="#475569"/>
                    </Border>
                </DockPanel>

                <!-- 5. 平滑降级说明 + 开源动效致谢 -->
                <TextBlock Text="若当前模型不支持指定档位，客户端将自动平滑降级，绝不报错中断。"
                           FontSize="9.2"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           LineHeight="13.5"/>

                <DockPanel Margin="0,5,0,0">
                    <Button x:Name="CreditLinkButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource EffortCreditLinkButtonStyle}"
                            Content="动效灵感致谢 dsh-effort-slider ↗"
                            Click="CreditLinkButton_OnClick"
                            ToolTip="打开 GitHub 仓库 https://github.com/2768651338/dsh-effort-slider（BSD-3-Clause）"/>
                    <TextBlock Text="支持拖动 · 滚轮 · 方向键"
                               FontSize="8.8"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
