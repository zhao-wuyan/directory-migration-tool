<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 统一轻量 Fluent 视觉令牌（严格对齐 docs/untitled.pen variables） -->
    <SolidColorBrush x:Key="FluentCanvasBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="FluentSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FluentSubtleBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="FluentTrackBrush" Color="#EEF2F6"/>
    <SolidColorBrush x:Key="FluentBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="FluentBorderStrongBrush" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="FluentInkBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="FluentBodyBrush" Color="#334155"/>
    <SolidColorBrush x:Key="FluentMutedBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="FluentPrimaryBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="FluentPrimaryHoverBrush" Color="#005A9E"/>
    <SolidColorBrush x:Key="FluentPrimaryPressBrush" Color="#004578"/>
    <SolidColorBrush x:Key="FluentPrimarySoftBrush" Color="#EBF5FF"/>
    <SolidColorBrush x:Key="FluentPrimaryBorderBrush" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="FluentCyanBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="FluentOrangeWarnBrush" Color="#E67E22"/>

    <!-- L0 / L1 / L2 / L3 语义色板 -->
    <SolidColorBrush x:Key="FluentGreenBrush" Color="#0F7B4B"/>
    <SolidColorBrush x:Key="FluentGreenAccentBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="FluentGreenSoftBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="FluentGreenBorderBrush" Color="#A7F3D0"/>

    <SolidColorBrush x:Key="FluentAmberBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="FluentAmberSoftBrush" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="FluentAmberBorderBrush" Color="#FDE68A"/>

    <SolidColorBrush x:Key="FluentRedBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="FluentRedSoftBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="FluentRedBorderBrush" Color="#FECACA"/>

